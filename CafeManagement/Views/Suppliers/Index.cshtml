@{
    Layout = "_Layout";
    ViewBag.ActivePage = "Suppliers";
    ViewBag.PageTitle = "Nhà Cung Cấp";
    ViewBag.Title = "Suppliers";
}

<div class="page-header">
    <div>
        <div class="page-title">🏭 Quản Lý Nhà Cung Cấp</div>
        <div class="page-subtitle">Danh sách và thông tin nhà cung cấp nguyên liệu</div>
    </div>
    <div id="managerActions" style="display:none;">
        <button class="btn btn-primary" onclick="openCreateModal()">+ Thêm nhà cung cấp</button>
    </div>
</div>

<!-- Stats -->
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px;" id="statsRow">
    <div class="card stat-card">
        <div class="stat-icon">🏭</div>
        <div class="stat-value" id="totalSuppliers">—</div>
        <div class="stat-label">Tổng NCC</div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon">📦</div>
        <div class="stat-value" id="activeSuppliers">—</div>
        <div class="stat-label">Có phiếu nhập</div>
    </div>
    <div class="card stat-card">
        <div class="stat-icon">✅</div>
        <div class="stat-value" id="newThisMonth">—</div>
        <div class="stat-label">Thêm tháng này</div>
    </div>
</div>

<!-- Suppliers table -->
<div class="card">
    <div class="card-header">
        <div class="card-title">📋 Danh sách nhà cung cấp</div>
        <div style="display:flex;gap:8px;align-items:center;">
            <input type="text" id="searchInput" class="form-control" placeholder="🔍 Tìm tên, SĐT..."
                   style="width:220px;" oninput="filterSuppliers(this.value)">
        </div>
    </div>
    <div style="overflow-x:auto;">
        <table class="table" id="suppliersTable">
            <thead>
                <tr>
                    <th>Tên nhà cung cấp</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Địa chỉ</th>
                    <th style="text-align:right;" id="actionsHeader" class="mgr-only" style="display:none;">Thao tác</th>
                </tr>
            </thead>
            <tbody id="suppliersBody">
                <tr><td colspan="5" style="text-align:center;padding:40px;color:var(--text3);">⏳ Đang tải...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal-overlay" id="supplierModal">
    <div class="modal" style="max-width:480px;">
        <div class="modal-header">
            <div class="modal-title" id="modalTitle">➕ Thêm nhà cung cấp</div>
            <button class="modal-close" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="editId">
            <div class="form-group">
                <label class="form-label">Tên nhà cung cấp <span style="color:var(--red)">*</span></label>
                <input type="text" id="sName" class="form-control" placeholder="Ví dụ: Vinamilk, Trung Nguyên...">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                <div class="form-group">
                    <label class="form-label">Số điện thoại</label>
                    <input type="text" id="sPhone" class="form-control" placeholder="0909...">
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" id="sEmail" class="form-control" placeholder="ncc@email.com">
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Địa chỉ</label>
                <input type="text" id="sAddress" class="form-control" placeholder="Địa chỉ nhà cung cấp...">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal()">Hủy</button>
            <button class="btn btn-primary" onclick="saveSupplier()">💾 Lưu</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
let _allSuppliers = [];
let _filtered    = [];

async function loadSuppliers() {
    try {
        const data = await apiFetch('/api/suppliers');
        _allSuppliers = data || [];
        _filtered = [..._allSuppliers];

        document.getElementById('totalSuppliers').textContent = _allSuppliers.length;
        // Simple stats (counts without more API calls)
        document.getElementById('activeSuppliers').textContent = _allSuppliers.length;
        document.getElementById('newThisMonth').textContent   = '—';

        renderTable(_filtered);

        // Show manager actions
        if (isManagerOrAdmin()) {
            document.getElementById('managerActions').style.display = '';
            document.getElementById('actionsHeader').style.display  = '';
        }
    } catch(e) {
        showToast('❌ ' + e.message, 'error');
    }
}

function renderTable(list) {
    const tbody = document.getElementById('suppliersBody');
    if (!list.length) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:40px;color:var(--text3);">Không có nhà cung cấp nào</td></tr>';
        return;
    }
    const isMgr = isManagerOrAdmin();
    tbody.innerHTML = list.map(s => `
        <tr>
            <td>
                <div style="display:flex;align-items:center;gap:10px;">
                    <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--brown-mid),var(--amber));
                                color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex-shrink:0;">
                        ${s.name.charAt(0).toUpperCase()}
                    </div>
                    <strong>${s.name}</strong>
                </div>
            </td>
            <td>${s.phone || '<span style="color:var(--text3);">—</span>'}</td>
            <td>${s.email || '<span style="color:var(--text3);">—</span>'}</td>
            <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${s.address || '<span style="color:var(--text3);">—</span>'}</td>
            <td style="text-align:right;">
                ${isMgr ? `
                    <button class="btn btn-outline btn-sm" onclick="openEditModal(${s.id})">✏️</button>
                    <button class="btn btn-sm" style="color:var(--red);border-color:var(--red);" onclick="deleteSupplier(${s.id}, '${s.name.replace(/'/g,"\\'")}')">🗑️</button>
                ` : ''}
            </td>
        </tr>
    `).join('');
}

function filterSuppliers(q) {
    const lower = q.toLowerCase();
    _filtered = _allSuppliers.filter(s =>
        s.name.toLowerCase().includes(lower) ||
        (s.phone && s.phone.includes(q))
    );
    renderTable(_filtered);
}

// ── Modal helpers ──────────────────────────────────────────────
function openCreateModal() {
    document.getElementById('editId').value   = '';
    document.getElementById('sName').value    = '';
    document.getElementById('sPhone').value   = '';
    document.getElementById('sEmail').value   = '';
    document.getElementById('sAddress').value = '';
    document.getElementById('modalTitle').textContent = '➕ Thêm nhà cung cấp';
    document.getElementById('supplierModal').classList.add('active');
}

function openEditModal(id) {
    const s = _allSuppliers.find(x => x.id === id);
    if (!s) return;
    document.getElementById('editId').value   = id;
    document.getElementById('sName').value    = s.name;
    document.getElementById('sPhone').value   = s.phone || '';
    document.getElementById('sEmail').value   = s.email || '';
    document.getElementById('sAddress').value = s.address || '';
    document.getElementById('modalTitle').textContent = '✏️ Sửa nhà cung cấp';
    document.getElementById('supplierModal').classList.add('active');
}

function closeModal() {
    document.getElementById('supplierModal').classList.remove('active');
}

async function saveSupplier() {
    const id      = document.getElementById('editId').value;
    const name    = document.getElementById('sName').value.trim();
    const phone   = document.getElementById('sPhone').value.trim();
    const email   = document.getElementById('sEmail').value.trim();
    const address = document.getElementById('sAddress').value.trim();

    if (!name) { showToast('⚠️ Nhập tên nhà cung cấp!', 'warn'); return; }

    const body = { Name: name, Phone: phone || null, Email: email || null, Address: address || null };
    try {
        if (id) {
            await apiFetch(`/api/suppliers/${id}`, { method: 'PUT', body: JSON.stringify(body) });
            showToast('✅ Cập nhật thành công!');
        } else {
            await apiFetch('/api/suppliers', { method: 'POST', body: JSON.stringify(body) });
            showToast('✅ Thêm nhà cung cấp thành công!');
        }
        closeModal();
        await loadSuppliers();
    } catch(e) {
        showToast('❌ ' + e.message, 'error');
    }
}

async function deleteSupplier(id, name) {
    if (!confirm(`Xóa nhà cung cấp "${name}"?`)) return;
    try {
        await apiFetch(`/api/suppliers/${id}`, { method: 'DELETE' });
        showToast('🗑️ Đã xóa nhà cung cấp', 'warn');
        await loadSuppliers();
    } catch(e) {
        showToast('❌ ' + e.message, 'error');
    }
}

document.addEventListener('DOMContentLoaded', loadSuppliers);
</script>
}
