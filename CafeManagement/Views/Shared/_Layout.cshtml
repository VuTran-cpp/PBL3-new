<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " — " : "")ABC Coffee POS</title>
    <meta name="description" content="Hệ thống quản lý quán cà phê ABC Coffee — POS, Bán hàng, Báo cáo">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>☕</text></svg>">
    <link rel="stylesheet" href="/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="shell">

    <!-- ═══════════════════════ SIDEBAR ═══════════════════════ -->
    <aside class="sidebar">
        <!-- Logo -->
        <div class="sb-logo">
            <div class="sb-brand">
                <div class="sb-icon">☕</div>
                <div>
                    <div class="sb-name">ABC COFFEE</div>
                    <div class="sb-sub">POS Management</div>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="sb-nav">
            <div class="sb-section-label">Vận hành</div>

            <a href="/Home" class="nav-link @(ViewBag.ActivePage == "POS" ? "active" : "")">
                <span class="nav-icon">🖥️</span> POS Bán Hàng
            </a>

            <a href="/Orders" class="nav-link @(ViewBag.ActivePage == "Orders" ? "active" : "")">
                <span class="nav-icon">📋</span> Lịch sử Đơn hàng
            </a>

            <a href="/Shifts" class="nav-link @(ViewBag.ActivePage == "Shifts" ? "active" : "")">
                <span class="nav-icon">🕐</span> Ca làm việc
            </a>

            <a href="/Customers" class="nav-link @(ViewBag.ActivePage == "Customers" ? "active" : "")">
                <span class="nav-icon">👥</span> Khách hàng
            </a>

            @{
                var _role = Context.Session.GetString("Role") ?? "";
                var _isMgr = _role == "MANAGER" || _role == "ADMIN";
            }
            @if (_isMgr) {
            <div class="sb-section-label" style="margin-top:8px;">Quản lý</div>

            <a href="/Dashboard" class="nav-link @(ViewBag.ActivePage == "Dashboard" ? "active" : "")">
                <span class="nav-icon">📊</span> Dashboard
            </a>

            <a href="/Menu" class="nav-link @(ViewBag.ActivePage == "Menu" ? "active" : "")">
                <span class="nav-icon">☕</span> Thực đơn
            </a>

            <a href="/Tables" class="nav-link @(ViewBag.ActivePage == "Tables" ? "active" : "")">
                <span class="nav-icon">🪑</span> Quản lý bàn
            </a>

            <a href="/Inventory" class="nav-link @(ViewBag.ActivePage == "Inventory" ? "active" : "")">
                <span class="nav-icon">📦</span> Kho hàng
            </a>

            <a href="/Suppliers" class="nav-link @(ViewBag.ActivePage == "Suppliers" ? "active" : "")">
                <span class="nav-icon">🏭</span> Nhà cung cấp
            </a>

            <a href="/Promotions" class="nav-link @(ViewBag.ActivePage == "Promotions" ? "active" : "")">
                <span class="nav-icon">🎁</span> Khuyến mãi
            </a>

            <a href="/Employees" class="nav-link @(ViewBag.ActivePage == "Employees" ? "active" : "")">
                <span class="nav-icon">👤</span> Nhân viên
            </a>
            }

            @{
                var kitchenToken = Context.Session.GetString("JwtToken") ?? "";
                var kitchenBranch = Context.Session.GetString("BranchId") ?? "1";
            }
            <a href="/Kitchen?branchId=@kitchenBranch&token=@kitchenToken"
               class="nav-link @(ViewBag.ActivePage == "Kitchen" ? "active" : "")"
               target="_blank"
               title="Mở màn hình bếp trong tab mới">
                <span class="nav-icon">🍳</span> Màn hình Bếp
            </a>
        </nav>

        <!-- User + Logout -->
        <div class="sb-footer">
            <a href="/Profile" class="sb-user" style="text-decoration:none;cursor:pointer;transition:background .15s;"
               onmouseenter="this.style.background='rgba(255,255,255,.07)'" onmouseleave="this.style.background=''"
               title="Xem hồ sơ cá nhân">
                <div class="sb-avatar">
                    @{
                        var fullName = Context.Session.GetString("FullName") ?? "AD";
                        var initials = fullName.Length >= 2 ? fullName.Substring(0, 2).ToUpper() : fullName.ToUpper();
                    }
                    @initials
                </div>
                <div style="flex:1; min-width:0;">
                    <div class="sb-user-name" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                        @(Context.Session.GetString("FullName") ?? "Admin")
                    </div>
                    <div class="sb-user-role">@(Context.Session.GetString("Role") ?? "STAFF")</div>
                </div>
                <a href="/Login/Logout" title="Đăng xuất"
                   onclick="event.stopPropagation()"
                   style="color:rgba(255,255,255,.4);font-size:18px;padding:4px;">🚪</a>
            </a>
        </div>
    </aside>

    <!-- ═══════════════════════ MAIN ═══════════════════════════ -->
    <div class="main">
        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar-title">@(ViewBag.PageTitle ?? "Hệ thống Quản lý POS")</div>
            <div class="topbar-right">
                <!-- Shift status badge -->
                <div id="shift-status-badge" style="display:none;font-size:12px;background:rgba(39,174,96,.1);color:#1D8348;padding:5px 12px;border-radius:20px;border:1px solid rgba(39,174,96,.2);font-weight:600;cursor:default;">
                    ⏱ Ca #<span id="shift-id-label">—</span>
                    <span id="shift-elapsed" style="opacity:.7;margin-left:4px;"></span>
                </div>

                <!-- Notification Bell -->
                <div style="position:relative;">
                    <button class="btn-icon" id="notifBtn" onclick="toggleNotifPanel()"
                            title="Thông báo" style="position:relative;font-size:18px;">
                        🔔
                        <span id="notifBadge" style="display:none;position:absolute;top:-4px;right:-4px;background:var(--red);color:#fff;font-size:10px;font-weight:800;min-width:18px;height:18px;border-radius:9px;display:flex;align-items:center;justify-content:center;line-height:1;">0</span>
                    </button>
                    <!-- Notification Panel -->
                    <div id="notifPanel" style="display:none;position:absolute;top:44px;right:0;width:340px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--shadow-lg);z-index:5000;max-height:480px;overflow-y:auto;">
                        <div style="padding:14px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
                            <div style="font-weight:700;font-size:14px;">🔔 Thông báo</div>
                            <button class="btn btn-outline btn-sm" onclick="markAllRead()">Xác nhận tất cả</button>
                        </div>
                        <div id="notifList" style="padding:8px 0;">
                            <div style="text-align:center;padding:24px;color:var(--text3);font-size:13px;">⏳ Đang kiểm tra...</div>
                        </div>
                    </div>
                </div>

                <!-- Date -->
                <div class="topbar-date">📅 @DateTime.Now.ToString("dd/MM/yyyy")</div>

                <!-- Dark mode toggle -->
                <button class="btn-icon" onclick="toggleDark()" title="Đổi giao diện">🌓</button>
            </div>
        </header>

        <!-- Page content -->
        <main class="page-content">
            @RenderBody()
        </main>

        <!-- Toast container -->
        <div id="toast-container" style="position:fixed;top:20px;right:20px;z-index:9999;display:flex;flex-direction:column;gap:8px;"></div>
    </div>
</div>

<!-- ── Shared Scripts ──────────────────────────────────────────── -->
<script>
    window.JWT_TOKEN  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("JwtToken") ?? ""));
    window.BRANCH_ID  = parseInt(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("BranchId") ?? "1"))) || 1;
    window.EMPLOYEE_ID= parseInt(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("EmployeeId") ?? "0"))) || 0;
    window.USER_ROLE  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("Role") ?? ""));
    window.FULL_NAME  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Session.GetString("FullName") ?? ""));

    // ── Dark mode (apply before page paint to avoid FOUC) ────────────────
    (function() {
        if (localStorage.getItem('dark') === '1') document.body.classList.add('dark-theme');
    })();
    function toggleDark() {
        document.body.classList.toggle('dark-theme');
        localStorage.setItem('dark', document.body.classList.contains('dark-theme') ? '1' : '0');
    }

    // ── Active nav highlight ────────────────────────────────────────────
    document.querySelectorAll('.nav-link').forEach(link => {
        const path = new URL(link.href, location.origin).pathname.toLowerCase();
        if (path !== '/' && location.pathname.toLowerCase().startsWith(path)) link.classList.add('active');
    });

    // ── Shift status + elapsed timer ─────────────────────────────────────
    let _shiftStartTime = null;
    let _shiftTimerRef  = null;

    async function loadShiftStatus() {
        if (!window.JWT_TOKEN) return;
        try {
            const res  = await fetch(`/api/shifts/current/${window.BRANCH_ID}`, {
                headers: { 'Authorization': `Bearer ${window.JWT_TOKEN}` }
            });
            const json = await res.json();
            const data = json.success ? json.data : json;
            if (data && data.id) {
                window.CURRENT_SHIFT_ID = data.id;
                _shiftStartTime = new Date(data.startTime);
                document.getElementById('shift-id-label').textContent = data.id;
                document.getElementById('shift-status-badge').style.display = '';
                updateElapsed();
                clearInterval(_shiftTimerRef);
                _shiftTimerRef = setInterval(updateElapsed, 60000);
            }
        } catch { /* shift not open */ }
    }

    function updateElapsed() {
        if (!_shiftStartTime) return;
        const mins = Math.floor((Date.now() - _shiftStartTime.getTime()) / 60000);
        const h = Math.floor(mins / 60), m = mins % 60;
        const el = document.getElementById('shift-elapsed');
        if (el) el.textContent = `(${h > 0 ? h + 'h ' : ''}${m}m)`;
    }

    // ── Notification system ───────────────────────────────────────────────
    let _notifItems   = [];
    let _notifPollRef = null;

    function toggleNotifPanel() {
        const panel = document.getElementById('notifPanel');
        const isOpen = panel.style.display !== 'none';
        panel.style.display = isOpen ? 'none' : 'block';
        if (!isOpen) renderNotifPanel();
    }

    // Close panel when clicking outside
    document.addEventListener('click', e => {
        if (!e.target.closest('#notifBtn') && !e.target.closest('#notifPanel')) {
            const panel = document.getElementById('notifPanel');
            if (panel) panel.style.display = 'none';
        }
    });

    async function pollNotifications() {
        if (!window.JWT_TOKEN) return;
        const items = [];
        try {
            // 1. Pending orders (chưa xử lý) — Bug#1: parse đúng ApiResponse
            const ordersRes = await fetch(`/api/orders?branchId=${BRANCH_ID}&status=PENDING&pageSize=50`, {
                headers: { 'Authorization': `Bearer ${window.JWT_TOKEN}` }
            });
            if (ordersRes.ok) {
                const od = await ordersRes.json();
                // ApiResponse<PagedResult<OrderSummaryDto>> → .data.items
                const list = od?.data?.items || [];
                if (list.length > 0) {
                    items.push({ type: 'warning', icon: '📋',
                        title: `${list.length} đơn hàng chờ xử lý`,
                        text: list.slice(0,3).map(o => `#${o.id} — Bàn ${o.tableName||'TA'}`).join(', ') + (list.length>3?'...':''),
                        link: '/Orders' });
                }
            }
        } catch {}
        try {
            // 2. Low stock — Bug#1: parse đúng ApiResponse
            const stockRes = await fetch(`/api/inventory/low-stock/${BRANCH_ID}`, {
                headers: { 'Authorization': `Bearer ${window.JWT_TOKEN}` }
            });
            if (stockRes.ok) {
                const sl = await stockRes.json();
                // ApiResponse<List<BranchIngredientDto>> → .data
                const lowList = sl?.data || [];
                if (lowList.length > 0) {
                    items.push({ type: 'danger', icon: '⚠️',
                        title: `${lowList.length} nguyên liệu sắp hết`,
                        text: lowList.slice(0,3).map(i => i.ingredientName).join(', ') + (lowList.length>3?'...':''),
                        link: '/Inventory' });
                }
            }
        } catch {}

        _notifItems = items;
        const badge = document.getElementById('notifBadge');
        if (badge) {
            badge.textContent = items.length;
            badge.style.display = items.length > 0 ? 'flex' : 'none';
        }
    }

    function renderNotifPanel() {
        const list = document.getElementById('notifList');
        if (!list) return;
        if (!_notifItems.length) {
            list.innerHTML = '<div style="text-align:center;padding:24px;color:var(--text3);font-size:13px;">✅ Không có thông báo mới</div>';
            return;
        }
        const colors = { warning: 'var(--amber)', danger: 'var(--red)', info: 'var(--blue)' };
        list.innerHTML = _notifItems.map((n, i) => `
            <a href="${n.link}" style="display:block;padding:12px 16px;border-bottom:1px solid var(--border);text-decoration:none;transition:background .1s;"
               onmouseenter="this.style.background='var(--surface2)'" onmouseleave="this.style.background=''">
                <div style="display:flex;gap:10px;align-items:flex-start;">
                    <div style="font-size:20px;flex-shrink:0;margin-top:1px;">${n.icon}</div>
                    <div style="flex:1;">
                        <div style="font-weight:700;font-size:13px;color:${colors[n.type]||'var(--text)'};">${n.title}</div>
                        <div style="font-size:12px;color:var(--text3);margin-top:2px;line-height:1.4;">${n.text}</div>
                    </div>
                </div>
            </a>
        `).join('');
    }

    function markAllRead() {
        _notifItems = [];
        const badge = document.getElementById('notifBadge');
        if (badge) badge.style.display = 'none';
        document.getElementById('notifPanel').style.display = 'none';
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadShiftStatus();
        pollNotifications();
        // Poll every 30s
        _notifPollRef = setInterval(pollNotifications, 30000);
    });
</script>
<script src="/js/api-client.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>