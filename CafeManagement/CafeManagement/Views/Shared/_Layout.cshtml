<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ABC Coffee POS</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;600&family=Cormorant+Garamond:wght@600&display=swap" rel="stylesheet">
    
    <style>
        /* TÍCH HỢP TỪ variables.css */
        :root {
            --bg: #F7F3EE; --surface: #FFFFFF; --surface2: #F2EDE6; --surface3: #EAE3D8;
            --brown-dark: #3D1F0D; --brown: #6B3A1F; --brown-mid: #8B5230; --brown-light: #C4956A;
            --cream: #FDF8F2; --cream2: #F0E4D0; --cream3: #E8D5B8;
            --green: #1E6B45; --red: #B83232; --amber: #C47A0A; --blue: #1A4E8A;
            --text: #1C1008; --text2: #5C3D20; --text3: #A0856A; --text4: #C4A882;
            --border: #E2D5C3; --border2: #CEC0AA;
            --shadow: 0 1px 3px rgba(61,31,13,.06), 0 4px 12px rgba(61,31,13,.04);
            --r: 10px; --r-lg: 16px; --r-xl: 22px;
        }

        /* TÍCH HỢP TỪ layout.css */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { height: 100vh; font-family: 'Be Vietnam Pro', sans-serif; background: var(--bg); color: var(--text); overflow: hidden; }
        .shell { display: flex; height: 100vh; }
        .sidebar { width: 228px; background: var(--brown-dark); display: flex; flex-direction: column; }
        .sb-logo { padding: 22px 20px; border-bottom: 1px solid rgba(255,255,255,.08); }
        .sb-brand { display: flex; align-items: center; gap: 11px; }
        .sb-icon { width: 38px; height: 38px; border-radius: 10px; background: var(--brown-mid); display: flex; align-items: center; justify-content: center; color: white; }
        .sb-name { font-family: 'Cormorant Garamond', serif; font-size: 19px; color: #fff; }
        .sb-nav { flex: 1; padding: 10px 0; }
        .nav-link { display: flex; align-items: center; gap: 10px; padding: 12px 20px; color: rgba(255,255,255,.55); text-decoration: none; transition: .18s; }
        .nav-link.active { background: rgba(255,255,255,.11); color: #fff; border-left: 3px solid var(--brown-light); }
        .main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
        .topbar { background: var(--surface); height: 58px; padding: 0 28px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); }
        .content { flex: 1; overflow-y: auto; padding: 26px 28px; }

        /* TÍCH HỢP TỪ pages.css */
        .table-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px; }
        .tc { border: 1.5px solid var(--border); border-radius: 14px; padding: 20px; text-align: center; background: var(--surface); box-shadow: var(--shadow); transition: .18s; }
        .tc.empty { border-left: 5px solid var(--green); }
        .tc.busy { border-left: 5px solid var(--red); background: var(--red-bg); }
        .tc-name { font-weight: 600; margin-bottom: 5px; }
        .btn-primary { background: var(--brown-dark); color: white; padding: 6px 12px; border-radius: 6px; text-decoration: none; font-size: 12px; display: inline-block; margin-top: 10px; }
    </style>
</head>
<body>
    <div class="shell">
        <aside class="sidebar">
            <div class="sb-logo">
                <div class="sb-brand">
                    <div class="sb-icon">☕</div>
                    <div class="sb-name">ABC COFFEE</div>
                </div>
            </div>
            <nav class="sb-nav">
                <a href="/" class="nav-link active">📊 Tổng quan</a>
                <a href="/Orders" class="nav-link">☕ Đơn hàng</a>
                <a href="/Menu" class="nav-link">📋 Thực đơn</a>
                <a href="/Inventory" class="nav-link">📦 Kho hàng</a>
            </nav>
            <div class="sb-footer" style="padding: 20px; border-top: 1px solid rgba(255,255,255,.07);">
                <a href="/Auth/Logout" style="color: rgba(255,255,255,.4); text-decoration: none; font-size: 12px;">🚪 Đăng xuất</a>
            </div>
        </aside>

        <div class="main">
            <header class="topbar">
                <div class="tb-title">Hệ thống Quản lý POS</div>
                <div class="tb-right">
                    <div class="tb-badge">@DateTime.Now.ToString("dd/MM/yyyy")</div>
                    <div class="sb-av" style="background:var(--brown-mid); width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:white; font-size:12px; margin-left:10px;">AD</div>
                </div>
            </header>
            
            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>
</body>
</html>