@model List<CafeManagement.Models.TableCafe>
@{
    Layout = "_Layout"; // Gắn vào khung ở Bước 3
}

<div class="shell">
    <aside class="sidebar">
        <div class="sb-logo"><div class="sb-brand">☕ ABC COFFEE</div></div>
        <nav>
            <a href="/" class="nav-link active">Tổng quan</a>
            <a href="/Orders" class="nav-link">Đơn hàng</a>
            <a href="/Inventory" class="nav-link">Kho hàng</a>
        </nav>
    </aside>

    <div class="main">
        <header class="topbar">
            <div class="tb-title">Sơ đồ bàn hiện tại</div>
        </header>

        <main class="content">
            <div class="table-grid">
                @foreach (var table in Model)
                {
                    <div class="tc @(table.Status == "Occupied" ? "busy" : "empty")">
                        <div class="tc-name">@table.Name</div>
                        <div class="tc-meta">Sức chứa: @table.Capacity</div>
                        <div class="sc-acts">
                            <a href="/Orders/Create?tableId=@table.Id" class="btn-primary">Chọn bàn</a>
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>
</div>