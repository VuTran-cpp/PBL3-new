@{
    Layout = "_Layout";
    ViewBag.ActivePage = "Employees";
    ViewBag.PageTitle = "Quản lý Nhân viên";
    ViewBag.Title = "Nhân viên";
}

<div class="page-header">
    <div>
        <div class="page-title">👤 Quản lý Nhân viên</div>
        <div class="page-subtitle">Danh sách nhân viên và tài khoản đăng nhập</div>
    </div>
    <button class="btn btn-primary" id="btnAdd" onclick="openAddModal()" style="display:none;">＋ Thêm nhân viên</button>
</div>

<!-- Filter -->
<div class="filters-bar" style="margin-bottom:16px;">
    <div class="search-wrap" style="flex:1;min-width:200px;">
        <span>🔍</span>
        <input type="text" id="searchEmp" placeholder="Tìm tên, số điện thoại..." oninput="debounce()">
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-header">
        <div class="card-title">Danh sách nhân viên</div>
        <div id="empCount" style="font-size:13px;color:var(--text3);"></div>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nhân viên</th>
                    <th>Số điện thoại</th>
                    <th>Chức vụ</th>
                    <th style="text-align:right;">Lương</th>
                    <th>Ngày vào làm</th>
                    <th style="text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody id="empTableBody">
                <tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text3);">⏳ Đang tải...</td></tr>
            </tbody>
        </table>
    </div>
    <div id="pagination" class="pagination" style="padding:16px;"></div>
</div>

<!-- Add Employee Modal -->
<div class="modal-overlay" id="addEmpModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title" id="empModalTitle">＋ Thêm nhân viên</div>
            <button class="modal-close" onclick="closeModal('addEmpModal')">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="empId">
            <div class="form-group">
                <label class="form-label">Họ tên <span style="color:var(--red)">*</span></label>
                <input type="text" id="empName" class="form-control" placeholder="Nguyễn Văn A">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="form-group">
                    <label class="form-label">Số điện thoại <span style="color:var(--red)">*</span></label>
                    <input type="tel" id="empPhone" class="form-control" placeholder="0901234567">
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" id="empEmail" class="form-control" placeholder="email@example.com">
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="form-group">
                    <label class="form-label">Chức vụ</label>
                    <input type="text" id="empPosition" class="form-control" placeholder="Nhân viên pha chế">
                </div>
                <div class="form-group">
                    <label class="form-label">Lương (đ/tháng)</label>
                    <input type="number" id="empSalary" class="form-control" placeholder="5000000" min="0">
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Ngày vào làm</label>
                <input type="date" id="empHiredDate" class="form-control">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="form-group">
                    <label class="form-label">Role hệ thống</label>
                    <select id="empRole" class="form-control">
                        <option value="STAFF">Nhân viên (STAFF)</option>
                        <option value="MANAGER">Quản lý (MANAGER)</option>
                        <option value="ADMIN">Admin (ADMIN)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Tài khoản đăng nhập</label>
                    <input type="text" id="empUsername" class="form-control" placeholder="VD: nhanvien01">
                </div>
            </div>
            <div class="form-group" id="empPwdGroup">
                <label class="form-label">Mật khẩu (khi tạo mới)</label>
                <input type="password" id="empPassword" class="form-control" placeholder="Tối thiểu 6 ký tự">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('addEmpModal')">Hủy</button>
            <button class="btn btn-primary" onclick="saveEmployee()">💾 Lưu nhân viên</button>
        </div>
    </div>
</div>

<!-- Change Password Modal -->
<div class="modal-overlay" id="pwdModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">🔑 Đặt lại mật khẩu nhân viên</div>
            <button class="modal-close" onclick="closeModal('pwdModal')">×</button>
        </div>
        <div class="modal-body">
            <div style="padding:12px 16px;background:var(--surface2);border-radius:var(--r);border-left:4px solid var(--amber);margin-bottom:16px;">
                <div style="font-size:12px;font-weight:700;color:var(--amber);margin-bottom:4px;">⚠️ LƯU Ý</div>
                <div style="font-size:13px;color:var(--text2);">Bạn đang đặt lại mật khẩu cho nhân viên <strong id="pwdEmpName"></strong>. Nhân viên sẽ cần dùng mật khẩu mới để đăng nhập.</div>
            </div>
            <div class="form-group">
                <label class="form-label">Mật khẩu mới <span style="color:var(--red)">*</span></label>
                <input type="password" id="resetNewPwd" class="form-control" placeholder="Tối thiểu 6 ký tự">
            </div>
            <div class="form-group">
                <label class="form-label">Xác nhận mật khẩu mới <span style="color:var(--red)">*</span></label>
                <input type="password" id="resetConfirmPwd" class="form-control" placeholder="Nhập lại mật khẩu mới">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('pwdModal')">Hủy</button>
            <button class="btn btn-primary" onclick="resetEmployeePassword()">🔑 Đặt lại mật khẩu</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
let searchTimer = null;
let currentPage = 1;
let allEmployees = [];

function debounce() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => renderFiltered(), 300);
}

async function loadEmployees() {
    if (isManagerOrAdmin()) document.getElementById('btnAdd').style.display = '';

    const body = document.getElementById('empTableBody');
    body.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:40px;"><div class="skeleton" style="height:16px;width:200px;margin:auto;border-radius:6px;"></div></td></tr>`;

    try {
        // GET /api/employees?branchId=X&pageSize=100
        const data = await apiFetch(`/api/employees?branchId=${BRANCH_ID}&pageSize=100`);
        allEmployees = data.items || data || [];
        document.getElementById('empCount').textContent = `Tổng: ${allEmployees.length} nhân viên`;
        renderFiltered();
    } catch(e) {
        body.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--red);">❌ ${e.message}</td></tr>`;
    }
}

function renderFiltered() {
    const search = document.getElementById('searchEmp').value.toLowerCase();
    const filtered = allEmployees.filter(e =>
        e.fullName.toLowerCase().includes(search) || e.phone.includes(search)
    );
    renderTable(filtered);
}

function renderTable(employees) {
    const body = document.getElementById('empTableBody');
    if (!employees.length) {
        body.innerHTML = `<tr><td colspan="6"><div class="empty-state"><div class="es-icon">👤</div><div class="es-title">Không tìm thấy nhân viên</div></div></td></tr>`;
        return;
    }
    body.innerHTML = employees.map(e => `<tr>
        <td>
            <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:36px;height:36px;border-radius:50%;background:var(--brown-mid);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;flex-shrink:0;">
                    ${e.fullName.charAt(0).toUpperCase()}
                </div>
                <div>
                    <div style="font-weight:600;">${e.fullName}</div>
                    <div style="font-size:11px;color:var(--text3);">ID: ${e.id} · Chi nhánh: ${e.branchId}</div>
                </div>
            </div>
        </td>
        <td>${e.phone}</td>
        <td><span class="badge badge-brown">${e.position || 'Nhân viên'}</span></td>
        <td style="text-align:right;font-weight:600;">${formatVND(e.salary)}</td>
        <td style="font-size:13px;color:var(--text3);">${e.hiredDate ? formatDate(e.hiredDate) : '—'}</td>
        <td style="text-align:center;">
            <button class="btn btn-outline btn-sm" onclick="editEmployee(${e.id})">✏️ Sửa</button>
            <button class="btn btn-outline btn-sm" style="margin-left:4px;" onclick="openPwdModal(${e.id})">🔑 Mật khẩu</button>
        </td>
    </tr>`).join('');
}

function openAddModal(emp = null) {
    document.getElementById('empId').value = emp?.id || '';
    document.getElementById('empModalTitle').textContent = emp ? 'Chỉnh sửa nhân viên' : '＋ Thêm nhân viên';
    document.getElementById('empName').value = emp?.fullName || '';
    document.getElementById('empPhone').value = emp?.phone || '';
    document.getElementById('empEmail').value = emp?.email || '';
    document.getElementById('empPosition').value = emp?.position || '';
    document.getElementById('empSalary').value = emp?.salary || '';
    document.getElementById('empHiredDate').value = emp?.hiredDate ? emp.hiredDate.substring(0,10) : '';
    document.getElementById('empRole').value = emp?.role || 'STAFF';
    document.getElementById('empUsername').value = emp?.username || '';
    document.getElementById('empPassword').value = '';
    document.getElementById('empPwdGroup').style.display = emp ? 'none' : '';
    document.getElementById('addEmpModal').classList.add('active');
}

function editEmployee(id) {
    const emp = allEmployees.find(e => e.id === id);
    if (emp) openAddModal(emp);
}

async function saveEmployee() {
    const id    = document.getElementById('empId').value;
    const name  = document.getElementById('empName').value.trim();
    const phone = document.getElementById('empPhone').value.trim();
    if (!name || !phone) { showToast('⚠️ Nhập họ tên và số điện thoại!', 'warn'); return; }

    const body = {
        FullName:    name,
        Phone:       phone,
        Email:       document.getElementById('empEmail').value || null,
        Position:    document.getElementById('empPosition').value || null,
        Salary:      parseFloat(document.getElementById('empSalary').value) || 0,
        HiredDate:   document.getElementById('empHiredDate').value || null,
        BranchId:    BRANCH_ID,
        Role:        document.getElementById('empRole').value,
        Username:    document.getElementById('empUsername').value || null,
        Password:    document.getElementById('empPassword').value || null
    };

    try {
        if (id) {
            await apiFetch(`/api/employees/${id}`, { method:'PUT', body: JSON.stringify(body) });
            showToast('✅ Cập nhật nhân viên thành công!');
        } else {
            await apiFetch('/api/employees', { method:'POST', body: JSON.stringify(body) });
            showToast('✅ Thêm nhân viên thành công!');
        }
        closeModal('addEmpModal');
        loadEmployees();
    } catch(e) { showToast('❌ ' + e.message, 'error'); }
}

async function resetEmployeePassword() {
    const empId   = document.getElementById('pwdModal').dataset.empId;
    const newPwd  = document.getElementById('resetNewPwd').value;
    const confirm = document.getElementById('resetConfirmPwd').value;
    if (!newPwd) { showToast('⚠️ Nhập mật khẩu mới!', 'warn'); return; }
    if (newPwd.length < 6) { showToast('⚠️ Mật khẩu mới tối thiểu 6 ký tự!', 'warn'); return; }
    if (newPwd !== confirm) { showToast('⚠️ Mật khẩu mới không khớp!', 'warn'); return; }
    try {
        await apiFetch('/api/auth/reset-password-by-manager', {
            method: 'POST',
            body: JSON.stringify({ EmployeeId: parseInt(empId), NewPassword: newPwd })
        });
        showToast('✅ Đặt lại mật khẩu nhân viên thành công!');
        closeModal('pwdModal');
    } catch(e) { showToast('❌ ' + e.message, 'error'); }
}

function closeModal(id) { document.getElementById(id).classList.remove('active'); }

function openPwdModal(empId) {
    const emp = allEmployees.find(e => e.id === empId);
    document.getElementById('resetNewPwd').value = '';
    document.getElementById('resetConfirmPwd').value = '';
    document.getElementById('pwdEmpName').textContent = emp ? emp.fullName : `ID ${empId}`;
    document.getElementById('pwdModal').dataset.empId = empId || '';
    document.getElementById('pwdModal').classList.add('active');
}

document.addEventListener('DOMContentLoaded', loadEmployees);
</script>
}
