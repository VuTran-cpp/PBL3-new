@{
    Layout = "_Layout";
    ViewBag.ActivePage = "Menu";
    ViewBag.PageTitle = "Quản lý Thực đơn";
    ViewBag.Title = "Thực đơn";
}

<div class="page-header">
    <div>
        <div class="page-title">☕ Quản lý Thực đơn</div>
        <div class="page-subtitle">Danh mục và các món trong menu</div>
    </div>
    <div class="flex gap-8" id="mgr-btns" style="display:none">
        <button class="btn btn-outline" onclick="openCategoryModal()">📁 Thêm danh mục</button>
        <button class="btn btn-primary" onclick="openItemModal()">＋ Thêm món mới</button>
    </div>
</div>

<!-- Tabs & Filters -->
<div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;align-items:center;">
    <div id="categoryTabs" style="display:flex;gap:8px;flex-wrap:wrap;flex:1;"></div>
    <div class="search-wrap" style="width:240px;">
        <span>🔍</span>
        <input type="text" id="searchMenu" placeholder="Tìm tên món..." oninput="filterMenu()">
    </div>
    <select id="filterAvail" class="form-control" style="width:150px;" onchange="filterMenu()">
        <option value="">Tất cả trạng thái</option>
        <option value="true">Đang bán</option>
        <option value="false">Ngừng bán</option>
    </select>
</div>

<!-- Menu Items Grid -->
<div id="menuGrid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px;">
    <!-- Skeleton -->
    @for (int i = 0; i < 8; i++) {
        <div class="card skeleton" style="height:260px;"></div>
    }
</div>

<!-- ─── Add/Edit Item Modal ─── -->
<div class="modal-overlay" id="itemModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title" id="itemModalTitle">Thêm món mới</div>
            <button class="modal-close" onclick="closeModal('itemModal')">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="itemId">
            <div class="form-group">
                <label class="form-label">Danh mục <span style="color:var(--red)">*</span></label>
                <select id="itemCategory" class="form-control" required></select>
            </div>
            <div class="form-group">
                <label class="form-label">Tên món <span style="color:var(--red)">*</span></label>
                <input type="text" id="itemName" class="form-control" placeholder="VD: Cà phê sữa đá" required>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="form-group">
                    <label class="form-label">Giá bán (đ) <span style="color:var(--red)">*</span></label>
                    <input type="number" id="itemPrice" class="form-control" placeholder="VD: 35000" min="0" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Giá vốn (đ)</label>
                    <input type="number" id="itemCost" class="form-control" placeholder="VD: 18000" min="0">
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Ảnh (URL)</label>
                <input type="url" id="itemImage" class="form-control" placeholder="https://...">
                <div id="imgPreview" style="margin-top:8px;"></div>
            </div>
            <div class="form-group">
                <label class="form-label">Mô tả</label>
                <textarea id="itemDesc" class="form-control" rows="2" placeholder="Mô tả ngắn về món..."></textarea>
            </div>
            <div class="form-group">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <input type="checkbox" id="itemAvailable" checked style="width:16px;height:16px;">
                    <span class="form-label" style="margin-bottom:0;">Đang bán (hiển thị trên POS)</span>
                </label>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('itemModal')">Hủy</button>
            <button class="btn btn-primary" onclick="saveItem()">💾 Lưu món</button>
        </div>
    </div>
</div>

<!-- ─── Add Category Modal ─── -->
<div class="modal-overlay" id="categoryModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">📁 Thêm danh mục</div>
            <button class="modal-close" onclick="closeModal('categoryModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Tên danh mục <span style="color:var(--red)">*</span></label>
                <input type="text" id="categoryName" class="form-control" placeholder="VD: Cà phê, Trà, Bánh...">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('categoryModal')">Hủy</button>
            <button class="btn btn-primary" onclick="saveCategory()">💾 Lưu danh mục</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
let allItems = [];
let allCategories = [];
let activeCatId = 'all';

// init() đầy đủ (có kiểm tra role) định nghĩa ở cuối

async function loadCategories() {
    try {
        allCategories = await apiFetch('/api/menu/categories');
        renderCategoryTabs();
        populateCategorySelect();
    } catch(e) { showToast('❌ ' + e.message, 'error'); }
}

async function loadItems() {
    try {
        allItems = await apiFetch('/api/menu/items');
        renderMenu();
    } catch(e) {
        document.getElementById('menuGrid').innerHTML = `<div class="empty-state" style="grid-column:1/-1;"><div class="es-icon">❌</div><div class="es-title">${e.message}</div></div>`;
    }
}

function renderCategoryTabs() {
    const tabs = document.getElementById('categoryTabs');
    tabs.innerHTML = `<button class="btn ${activeCatId==='all'?'btn-primary':'btn-outline'} btn-sm" onclick="switchCat('all')">Tất cả</button>`;
    allCategories.forEach(c => {
        tabs.innerHTML += `<button class="btn ${activeCatId==c.id?'btn-primary':'btn-outline'} btn-sm" onclick="switchCat(${c.id})">${c.name} <span style="opacity:.6">(${c.itemCount})</span></button>`;
    });
}

function switchCat(id) {
    activeCatId = id;
    renderCategoryTabs();
    filterMenu();
}

function populateCategorySelect() {
    const sel = document.getElementById('itemCategory');
    sel.innerHTML = allCategories.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
}

function filterMenu() {
    const search = document.getElementById('searchMenu').value.toLowerCase();
    const avail  = document.getElementById('filterAvail').value;
    const filtered = allItems.filter(item => {
        const matchCat    = activeCatId === 'all' || item.categoryId == activeCatId;
        const matchSearch = item.name.toLowerCase().includes(search);
        const matchAvail  = avail === '' || item.isAvailable.toString() === avail;
        return matchCat && matchSearch && matchAvail;
    });
    renderMenu(filtered);
}

function renderMenu(items = allItems) {
    const grid = document.getElementById('menuGrid');
    if (!items.length) {
        grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1;"><div class="es-icon">☕</div><div class="es-title">Không có món nào</div><div class="es-text">Thêm món mới hoặc thay đổi bộ lọc</div></div>`;
        return;
    }
    grid.innerHTML = items.map(item => {
        const safeName = item.name.replace(/&/g,'&amp;').replace(/'/g,'&#39;').replace(/"/g,'&quot;');
        return `
        <div class="card" style="transition:transform .2s;cursor:default;" onmouseenter="this.style.transform='translateY(-3px)'" onmouseleave="this.style.transform=''">
            <div style="position:relative;">
                <img src="${item.imageUrl || 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=300&q=70'}"
                     style="width:100%;height:140px;object-fit:cover;"
                     onerror="this.src='https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=300&q=70'">
                <div style="position:absolute;top:8px;right:8px;">
                    <span class="badge ${item.isAvailable?'badge-green':'badge-red'}">${item.isAvailable?'Đang bán':'Ngừng bán'}</span>
                </div>
            </div>
            <div style="padding:14px;">
                <div style="font-size:11px;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;">${item.categoryName}</div>
                <div style="font-weight:700;font-size:15px;color:var(--brown-dark);margin-bottom:6px;">${item.name}</div>
                ${item.description ? `<div style="font-size:12px;color:var(--text3);margin-bottom:8px;overflow:hidden;max-height:32px;">${item.description}</div>` : ''}
                <div style="font-size:18px;font-weight:800;color:var(--red);margin-bottom:12px;">${formatVND(item.price)}</div>
                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                    <button class="btn btn-outline btn-sm" style="flex:1;" onclick="editItem(${item.id})">✏️ Sửa</button>
                    <button class="btn btn-sm ${item.isAvailable?'btn-warning':'btn-success'}" style="flex:1;"
                            onclick="toggleAvail(${item.id}, ${!item.isAvailable})">
                        ${item.isAvailable?'🚫 Ẩn':'✅ Hiện'}
                    </button>
                    <button class="btn btn-danger btn-sm" style="flex:1;" onclick="deleteItem(${item.id},'${safeName}')">🗑</button>
                </div>
            </div>
        </div>`;
    }).join('');
}

function openItemModal(item = null) {
    document.getElementById('itemId').value = item?.id || '';
    document.getElementById('itemModalTitle').textContent = item ? 'Chỉnh sửa món' : 'Thêm món mới';
    document.getElementById('itemCategory').value = item?.categoryId || (allCategories[0]?.id || '');
    document.getElementById('itemName').value = item?.name || '';
    document.getElementById('itemPrice').value = item?.price || '';
    document.getElementById('itemCost').value = item?.costPrice || '';
    document.getElementById('itemImage').value = item?.imageUrl || '';
    document.getElementById('itemDesc').value = item?.description || '';
    document.getElementById('itemAvailable').checked = item?.isAvailable ?? true;
    document.getElementById('imgPreview').innerHTML = item?.imageUrl
        ? `<img src="${item.imageUrl}" style="width:80px;height:60px;object-fit:cover;border-radius:8px;">`
        : '';
    document.getElementById('itemModal').classList.add('active');
}

function editItem(id) {
    const item = allItems.find(i => i.id === id);
    if (item) openItemModal(item);
}

async function toggleAvail(id, val) {
    try {
        await apiFetch(`/api/menu/items/${id}`, {
            method: 'PUT',
            body: JSON.stringify({ IsAvailable: val })
        });
        showToast(`✅ ${val ? 'Đã bật' : 'Đã ẩn'} món thành công`);
        await loadItems();
        filterMenu();
    } catch(e) { showToast('❌ ' + e.message, 'error'); }
}

document.getElementById('itemImage').addEventListener('input', function() {
    const preview = document.getElementById('imgPreview');
    preview.innerHTML = this.value
        ? `<img src="${this.value}" style="width:80px;height:60px;object-fit:cover;border-radius:8px;" onerror="this.style.display='none'">`
        : '';
});

async function saveItem() {
    const id    = document.getElementById('itemId').value;
    const name  = document.getElementById('itemName').value.trim();
    const price = parseFloat(document.getElementById('itemPrice').value);
    if (!name || isNaN(price) || price < 0) {
        showToast('⚠️ Vui lòng nhập đầy đủ thông tin!', 'warn'); return;
    }
    const body = {
        CategoryId:  parseInt(document.getElementById('itemCategory').value),
        Name:        name,
        Price:       price,
        CostPrice:   parseFloat(document.getElementById('itemCost').value) || null,
        ImageUrl:    document.getElementById('itemImage').value || null,
        Description: document.getElementById('itemDesc').value || null,
        IsAvailable: document.getElementById('itemAvailable').checked
    };
    try {
        if (id) {
            await apiFetch(`/api/menu/items/${id}`, { method:'PUT', body: JSON.stringify(body) });
            showToast('✅ Cập nhật món thành công!');
        } else {
            await apiFetch('/api/menu/items', { method:'POST', body: JSON.stringify(body) });
            showToast('✅ Thêm món thành công!');
        }
        closeModal('itemModal');
        await loadItems(); filterMenu();
    } catch(e) { showToast('❌ ' + e.message, 'error'); }
}

async function deleteItem(id, name) {
    if (!confirmDialog(`Xóa món "${name}"? Hành động này không thể hoàn tác!`)) return;
    try {
        await apiFetch(`/api/menu/items/${id}`, { method:'DELETE' });
        showToast(`✅ Đã xóa món "${name}"`);
        await loadItems(); filterMenu();
    } catch(e) { showToast('❌ ' + e.message, 'error'); }
}

function openCategoryModal() {
    document.getElementById('categoryName').value = '';
    document.getElementById('categoryModal').classList.add('active');
}

async function saveCategory() {
    const name = document.getElementById('categoryName').value.trim();
    if (!name) { showToast('⚠️ Nhập tên danh mục!', 'warn'); return; }
    try {
        await apiFetch('/api/menu/categories', { method:'POST', body: JSON.stringify({ Name: name }) });
        showToast('✅ Thêm danh mục thành công!');
        closeModal('categoryModal');
        await loadCategories();
    } catch(e) { showToast('❌ ' + e.message, 'error'); }
}

function closeModal(id) { document.getElementById(id).classList.remove('active'); }

async function init() {
    if (isManagerOrAdmin()) {
        document.getElementById('mgr-btns').style.display = 'flex';
    }
    await Promise.all([loadCategories(), loadItems()]);
}

document.addEventListener('DOMContentLoaded', init);
</script>
}
