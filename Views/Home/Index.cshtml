@model List<CafeManagement.Models.TableCafe>
@{
    Layout = "_Layout";
    var branchId = ViewBag.BranchId ?? 1;
    var jwtToken = ViewBag.JwtToken ?? "";
}

@section Styles {
<style>
/* ── IN TEM: chỉ in div#labelPrintArea ─────────────────────── */
@@media print {
    body > * { display: none !important; }
    #labelPrintArea {
        display: flex !important;
        flex-wrap: wrap;
        gap: 0;
        padding: 0;
        margin: 0;
        background: #fff;
    }
    .label-card {
        width: 80mm;
        min-height: 50mm;
        border: 1.5px dashed #555;
        border-radius: 0;
        padding: 8px 10px;
        page-break-inside: avoid;
        font-family: 'Courier New', monospace;
        color: #000;
        background: #fff;
        box-shadow: none;
    }
    .label-card * { color: #000 !important; }
    .label-no-print { display: none !important; }
}

/* ── Animation cho banner cảnh báo ca nhân viên ─────────── */
@@keyframes slideDownWarning {
    from { transform: translateY(-100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}
</style>
}

<!-- Thanh lọc khu vực -->
<div class="area-filter-bar" id="areaFilterBar">
    <button class="area-tab active" id="area-all" onclick="switchArea('all', this)">
        <span class="area-tab-icon">🏠</span>
        <span>Tất cả</span>
    </button>
    <button class="area-tab" id="area-tang1" onclick="switchArea('tang1', this)">
        <span class="area-tab-icon">1️⃣</span>
        <span>Tầng 1</span>
    </button>
    <button class="area-tab" id="area-tang2" onclick="switchArea('tang2', this)">
        <span class="area-tab-icon">2️⃣</span>
        <span>Tầng 2</span>
    </button>
    <button class="area-tab" id="area-bancong" onclick="switchArea('bancong', this)">
        <span class="area-tab-icon">🌿</span>
        <span>Ban công</span>
    </button>
    <div class="area-tab-divider"></div>
    <button class="area-tab area-tab-takeaway" id="area-takeaway" onclick="switchArea('takeaway', this)">
        <span class="area-tab-icon">🛍️</span>
        <span>Mang về</span>
        <span class="area-tab-badge" id="takenAwayBadge" style="display:none;">0</span>
    </button>
</div>

<!-- Counter bàn -->
<div class="table-area-summary" id="tableAreaSummary">
    <span id="areaSummaryText">Đang tải...</span>
</div>

<div class="table-grid" id="tableGrid">
    @foreach (var table in Model)
    {
        var statusClass = table.Status.ToLower() switch {
            "occupied" => "occupied",
            "cleaning" => "cleaning",
            _ => "empty"
        };
        var statusText = table.Status.ToLower() switch {
            "occupied" => "Có khách",
            "cleaning" => "Đang dọn",
            _ => "Trống"
        };

        <div class="tc @statusClass"
             id="table-@table.Id"
             draggable="true"
             ondragstart="drag(event, @table.Id, '@table.Name')"
             ondragover="allowDrop(event)"
             ondrop="drop(event, @table.Id, '@table.Name')"
             ondragleave="dragLeave(event)"
             onclick="openOrder('@table.Id', '@table.Name', '@statusClass')">

            <div class="tc-status">@statusText</div>
            <div class="tc-name">@table.Name</div>
            <div class="tc-info">
                <span>Sức chứa: @table.Capacity người</span>
                @if (statusClass == "occupied")
                {
                    <div class="tc-total" id="total-table-@table.Id">Đang tải...</div>
                }
            </div>
        </div>
    }

    <!-- Slot Mang về: MV-1 → MV-5 -->
    @for (int mv = 1; mv <= 5; mv++)
    {
        <div class="tc tc-takeaway"
             id="takeaway-slot-@mv"
             data-area="takeaway"
             onclick="openTakeaway(@mv)">
            <div class="tc-status tc-takeaway-label">Mang về</div>
            <div class="tc-name tc-takeaway-num">
                <span class="tv-bag-icon">🛍️</span> MV-@mv
            </div>
            <div class="tc-info">
                <span>Đơn mang về #@mv</span>
                <div class="tc-total" id="total-takeaway-@mv" style="display:none;"></div>
            </div>
        </div>
    }
</div>

<!-- (trước kia là card ảo, đã bỏ) -->

<!-- Overlay & Side Panel (POS) -->
<div id="overlay" class="overlay" onclick="closeOrder()"></div>
<div id="orderPanel" class="side-panel">
    <div class="pos-container">
        <!-- 1. Left: Categories -->
        <div class="pos-categories" id="categoriesPanel">
            <div class="cat-item active" id="cat-all" onclick="switchCategory('all', this)">
                <i style="font-size:18px">🍽️</i>
                <span style="font-size:9px; color:white">Tất cả</span>
            </div>
            <!-- Danh mục sẽ được load từ API -->
        </div>

        <!-- 2. Middle: Menu Items -->
        <div class="pos-menu">
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="Tìm tên món..." onkeyup="filterItems(this.value)">
            </div>
            <div id="itemsGrid" class="items-grid"></div>
        </div>

        <!-- 3. Right: Cart -->
        <div class="pos-cart">
            <div class="panel-header" style="background: var(--surface); color: var(--brown-dark);">
                <div>
                    <h3 id="panelTableName">Bàn 01</h3>
                    <span id="panelTableStatus" style="font-size: 12px; opacity: 0.6;">Đang xử lý</span>
                </div>
                <button class="btn-close" style="color: var(--brown-dark); background:none; border:none; font-size:24px; cursor:pointer;" onclick="closeOrder()">&times;</button>
            </div>

            <div id="cartList" class="cart-list">
                <!-- Giỏ hàng sẽ render ở đây -->
            </div>

            <div class="cart-footer">
                <!-- Customer lookup -->
                <div style="margin-bottom:10px;">
                    <div style="display:flex;gap:6px;">
                        <input type="text" id="custPhoneInput" placeholder="SĐT khách hàng..." maxlength="15"
                               style="flex:1;padding:8px 10px;border:1.5px solid var(--border);border-radius:8px;font-size:12px;outline:none;background:var(--surface);color:var(--text);">
                        <button onclick="lookupCustomer()" style="padding:8px 12px;background:var(--blue);color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;">Tìm</button>
                    </div>
                    <div id="custInfo" style="font-size:11px;color:var(--green);margin-top:4px;font-weight:600;"></div>
                </div>

                <!-- Promo code -->
                <div style="display:flex;gap:6px;margin-bottom:10px;">
                    <input type="text" id="promoInput" placeholder="Mã khuyến mãi..." style="flex:1;padding:8px 10px;border:1.5px solid var(--border);border-radius:8px;font-size:12px;outline:none;background:var(--surface);color:var(--text);text-transform:uppercase;">
                    <button onclick="applyPromo()" style="padding:8px 12px;background:var(--amber);color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;">Áp dụng</button>
                </div>
                <div id="promoInfo" style="font-size:11px;color:var(--green);margin-bottom:8px;font-weight:600;"></div>

                <!-- Totals -->
                <div class="summary-row" style="display:flex;justify-content:space-between;margin-bottom:6px;font-size:13px;">
                    <span>Tạm tính</span><span id="subtotal">0đ</span>
                </div>
                <div id="discountRow" style="display:none;justify-content:space-between;margin-bottom:6px;font-size:13px;color:var(--green);">
                    <span>Giảm giá</span><span id="discountAmt">0đ</span>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:18px;font-weight:800;color:var(--red);border-top:1px dashed var(--border);padding-top:10px;margin-bottom:10px;">
                    <span>TỔNG CỘNG</span><span id="finalTotal">0đ</span>
                </div>

                <!-- Payment method -->
                <select id="payMethod" style="width:100%;padding:9px;border:1.5px solid var(--border);border-radius:8px;font-size:13px;margin-bottom:10px;background:var(--surface);color:var(--text);outline:none;">
                    <option value="CASH">💵 Tiền mặt</option>
                    <option value="BANK">🏦 Chuyển khoản</option>
                    <option value="CARD">💳 Thẻ ngân hàng</option>
                </select>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                    <button class="btn-confirm" id="btnSave" onclick="saveOrder()" style="background:var(--blue);">📋 LƯU ĐƠN</button>
                    <button class="btn-confirm" id="btnPay" onclick="openPaymentModal()">💳 THANH TOÁN</button>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px;">
                    <button class="btn-confirm" id="btnServed" onclick="markServed()" style="background:var(--green);display:none;">✅ ĐÃ PHỤC VỤ</button>
                    <button class="btn-confirm" id="btnCancel" onclick="cancelOrder()" style="background:var(--red);display:none;">🗑️ HỦY ĐƠN</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal-overlay" id="payModalOverlay">
    <div class="modal" style="max-width:400px;">
        <div class="modal-header">
            <div class="modal-title">💳 Thanh toán đơn hàng</div>
            <button class="modal-close" onclick="closePaymentModal()">×</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Bàn</label>
                <div style="font-weight:700;font-size:16px;" id="pmTableName">—</div>
            </div>
            <div class="form-group">
                <label class="form-label">Tổng tiền</label>
                <div style="font-size:26px;font-weight:800;color:var(--red);" id="pmTotal">0đ</div>
            </div>
            <div class="form-group">
                <label class="form-label">Phương thức</label>
                <select id="pmMethod" class="form-control">
                    <option value="CASH">💵 Tiền mặt</option>
                    <option value="BANK">🏦 Chuyển khoản</option>
                    <option value="CARD">💳 Thẻ ngân hàng</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closePaymentModal()">Hủy</button>
            <button class="btn btn-success" id="btnConfirmPay" onclick="processPayment()">✅ Xác nhận thanh toán</button>
        </div>
    </div>
</div>

<!-- Receipt Modal -->
<div id="receiptModal" class="receipt-modal">
    <div class="receipt-header">
        <h2 style="margin-bottom:5px">ABC COFFEE</h2>
        <div>Đ/c: 123 Nguyễn Văn Linh</div>
        <div style="font-weight:700;margin-top:4px;">HÓA ĐƠN THANH TOÁN</div>
    </div>
    <div style="font-size:12px;margin-bottom:15px;" id="receiptInfo">
        <div>Bàn: <span id="rTable">01</span></div>
        <div>Order #: <span id="rOrderId">-</span></div>
        <div>Khách: <span id="rCust">Khách lẻ</span></div>
        <div>Ngày: <span id="rDate"></span></div>
        <div>PT TT: <span id="rMethod">Tiền mặt</span></div>
    </div>
    <div id="receiptItems"></div>
    <div id="rDiscountRow" style="border-top:1px dashed #000;padding-top:8px;margin-top:8px;font-size:13px;display:none;justify-content:space-between;">
        <span>Giảm giá:</span><span id="rDiscount">0đ</span>
    </div>
    <div class="receipt-total">TỔNG: <span id="rTotal">0</span>đ</div>
    <div class="receipt-barcode"></div>
    <div style="text-align:center;font-size:12px;margin-top:15px;">Cảm ơn quý khách! ☕</div>
    <button onclick="window.print()" style="width:100%;margin-top:10px;padding:8px;background:#555;color:#fff;border:none;cursor:pointer;border-radius:6px;font-size:13px;">🖨️ In hóa đơn</button>
    <button onclick="closeReceipt()" style="width:100%;margin-top:6px;padding:8px;background:#000;color:#fff;border:none;cursor:pointer;border-radius:6px;font-size:13px;">Đóng</button>
</div>

<!-- Label Print Modal -->
<div class="modal-overlay" id="labelModalOverlay" style="z-index:3500;align-items:flex-start;padding-top:20px;">
    <div class="modal modal-lg" style="max-width:860px;max-height:90vh;">
        <div class="modal-header" style="background:var(--brown-dark);color:#fff;border-radius:var(--r-xl) var(--r-xl) 0 0;">
            <div style="display:flex;align-items:center;gap:10px;">
                <span style="font-size:22px;">🏷️</span>
                <div>
                    <div class="modal-title" style="color:#fff;font-size:16px;">In Tem Gọi Đồ</div>
                    <div style="font-size:11px;opacity:.7;margin-top:1px;">Mỗi tem tương ứng 1 ly — Dán vào cốc để phân biệt</div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:8px;">
                <span id="labelTotalCount" class="badge badge-amber" style="font-size:12px;padding:4px 12px;"></span>
                <button class="modal-close" style="background:rgba(255,255,255,.15);color:#fff;" onclick="closeLabelModal()">×</button>
            </div>
        </div>
        <div class="modal-body" style="padding:16px;background:var(--surface2);">
            <!-- Controls -->
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px;" class="label-no-print">
                <div style="font-size:13px;color:var(--text3);">
                    Ảnh hưởng: <strong style="color:var(--text);">Order #<span id="labelOrderId">—</span></strong>
                    &ensp;·&ensp; <strong style="color:var(--brown-dark);"><span id="labelTableName">—</span></strong>
                    &ensp;·&ensp; <span id="labelDateTime" style="color:var(--text3);"></span>
                </div>
                <button onclick="window.print()" class="btn btn-primary" style="gap:8px;">
                    🖨️ In tất cả tem
                </button>
            </div>
            <!-- Label grid -->
            <div id="labelPrintArea" style="display:flex;flex-wrap:wrap;gap:12px;"></div>
        </div>
        <div class="modal-footer" style="background:var(--surface);" class="label-no-print">
            <button class="btn btn-outline" onclick="closeLabelModal()">✖ Đóng</button>
            <button class="btn btn-primary" onclick="window.print()">🖨️ In tem</button>
        </div>
    </div>
</div>

<!-- POS Open Shift Modal -->
<div class="modal-overlay" id="posOpenShiftModal">
    <div class="modal" style="max-width:400px;">
        <div class="modal-header">
            <div class="modal-title">🟢 Mở ca làm việc</div>
        </div>
        <div class="modal-body">
            <div style="background:rgba(231,76,60,.08);border:1px solid rgba(231,76,60,.2);border-radius:var(--r);padding:12px 14px;margin-bottom:16px;font-size:13px;color:var(--red);font-weight:600;">
                ⚠️ Bạn phải mở ca làm việc trước khi sử dụng POS bán hàng.
            </div>
            <div class="form-group">
                <label class="form-label">Nhân viên ca trực <span style="color:var(--red)">*</span></label>
                <select id="posShiftEmployeeId" class="form-control">
                    <option value="">-- Chọn nhân viên --</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Tiền đầu ca (đ) <span style="color:var(--red)">*</span></label>
                <input type="number" id="posStartingCash" class="form-control" placeholder="VD: 500000" min="0" value="0">
                <div style="font-size:11px;color:var(--text3);margin-top:4px;">Số tiền mặt trong két khi bắt đầu ca</div>
            </div>
        </div>
        <div class="modal-footer" style="display:flex;gap:8px;">
            <button class="btn btn-outline" onclick="goBackFromPosShift()" style="flex:1;">↩️ Quay lại</button>
            <button class="btn btn-success" style="flex:2;" onclick="submitPosOpenShift()">✅ Xác nhận mở ca</button>
        </div>
    </div>
</div>

<!-- POS Close Shift Modal -->
<div class="modal-overlay" id="posCloseShiftModal">
    <div class="modal" style="max-width:400px;">
        <div class="modal-header">
            <div class="modal-title">🔴 Đóng ca làm việc</div>
            <button class="modal-close" onclick="closePosModal('posCloseShiftModal')">×</button>
        </div>
        <div class="modal-body">
            <div id="posShiftSummary" style="background:var(--surface2);border-radius:var(--r);padding:16px;margin-bottom:16px;font-size:13px;line-height:1.6;">
                <!-- Thông tin tổng kết ca sẽ được inject ở đây -->
            </div>
            <div class="form-group">
                <label class="form-label">Tiền mặt thực tế trong két (đ) <span style="color:var(--red)">*</span></label>
                <input type="number" id="posActualCash" class="form-control" placeholder="Đếm và nhập số tiền thực tế" min="0">
            </div>
            <div class="form-group">
                <label class="form-label">Ghi chú</label>
                <textarea id="posCloseNote" class="form-control" rows="2" placeholder="Ghi chú khi đóng ca..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closePosModal('posCloseShiftModal')">Hủy</button>
            <button class="btn btn-danger" onclick="submitPosCloseShift()">🔴 Xác nhận đóng ca</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ════════════════════════════════════════════════════════
    //  CONFIG & STATE
    // ════════════════════════════════════════════════════════
    // JWT_TOKEN và BRANCH_ID lấy từ window globals (inject bởi _Layout.cshtml)
    // apiFetch, showToast lấy từ api-client.js

    let currentCart         = [];
    let currentTableId      = null;
    let currentTableName    = '';
    let currentOrderId      = null;
    let currentShiftId      = null;
    let allMenuItems        = [];
    let draggedTableId      = null;
    let currentDiscount     = 0;
    let currentPromoCode    = null;
    let currentCustomerId   = null;
    let currentCustomerName = '';
    let currentOrderType    = 'DINE_IN';   // 'DINE_IN' hoặc 'TAKE_AWAY'
    let currentAreaFilter   = 'all';       // 'all' | 'tang1' | 'tang2' | 'bancong' | 'takeaway'
    let currentTakeawaySlot = null;        // số slot MV-1..MV-5 đang mở
    let isSaving            = false;       // ✅ FIX BUG-03: chặn double-click gây tạo đơn trùng
    let pendingPromoCode    = null;        // ✅ FIX BUG-02: lưu mã promo chưa ghi DB (chưa có orderId)
    let isShiftOwner        = true;        // ✅ Kiểm tra nhân viên đăng nhập có phải người được mở ca không


    // ════════════════════════════════════════════════════════
    //  KHỞI TẠO – load shift & menu ngay khi trang mở
    // ════════════════════════════════════════════════════════
    async function init() {
        try {
            // 1. Lấy ca đang mở (bắt buộc có trước khi tạo order)
            const shift = await apiFetch(`/api/shifts/current/${BRANCH_ID}`);
            currentShiftId = shift.id;

            // ✅ Kiểm tra nhân viên đăng nhập có phải người được mở ca không
            // Manager/Admin được phép order tự do, chỉ STAFF bị ràng buộc
            const userRole = (window.USER_ROLE || '').toUpperCase();
            if (userRole !== 'MANAGER' && userRole !== 'ADMIN'
                && shift.employeeId && window.EMPLOYEE_ID
                && shift.employeeId !== window.EMPLOYEE_ID) {
                isShiftOwner = false;
                showToast(`⚠️ Ca đang mở cho ${shift.employeeName}. Bạn không thể tạo đơn hàng!`, 'error');
                showShiftOwnerWarning(shift.employeeName);
            } else {
                isShiftOwner = true;
                showToast(`✅ Ca làm việc: #${currentShiftId} đang mở`);
                hideShiftOwnerWarning();
            }
        } catch (err) {
            currentShiftId = null;
            isShiftOwner = false;
            const userRole = (window.USER_ROLE || '').toUpperCase();
            if (userRole === 'MANAGER' || userRole === 'ADMIN') {
                // Manager/Admin: cho phép mở ca mới
                isShiftOwner = true;
                openShiftModal();
            } else {
                // Staff: chặn hoàn toàn, không cho tự mở ca
                showNoShiftBlockingWarning();
            }
            console.warn('Shift warning:', err.message);
        }

        try {
            // 2. Load menu từ DB
            allMenuItems = await apiFetch('/api/menu/items?isAvailable=true');

            // 3. Load categories
            const categories = await apiFetch('/api/menu/categories');
            renderCategories(categories);

            // 4. Render tất cả items ban đầu
            renderItems();
        } catch (err) {
            console.error('Init error:', err);
            showToast('❌ Lỗi tải dữ liệu: ' + err.message);
        }

        // 5. Load tổng tiền và trạng thái cho bàn và slot mang về hoạt động
        loadActiveOrdersState();

        // 6. Cập nhật tóm tắt khu vực
        updateAreaSummary();
    }

    // ════════════════════════════════════════════════════════
    //  CẢNH BÁO NHÂN VIÊN KHÔNG ĐÚNG CA
    // ════════════════════════════════════════════════════════
    function showShiftOwnerWarning(shiftEmployeeName) {
        // Xóa banner cũ nếu có
        hideShiftOwnerWarning();
        const banner = document.createElement('div');
        banner.id = 'shiftOwnerWarning';
        banner.style.cssText = `
            position: fixed; top: 0; left: 0; right: 0; z-index: 9999;
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: #fff; padding: 14px 24px; text-align: center;
            font-size: 14px; font-weight: 700;
            box-shadow: 0 4px 20px rgba(231, 76, 60, 0.4);
            display: flex; align-items: center; justify-content: center; gap: 10px;
            animation: slideDownWarning 0.4s ease;
        `;
        banner.innerHTML = `
            <span style="font-size: 20px;">🚫</span>
            <span>Ca đang mở cho <strong>${shiftEmployeeName}</strong> — Bạn không thể tạo đơn hàng trong ca này.</span>
            <span style="font-size: 20px;">🚫</span>
        `;
        document.body.appendChild(banner);
    }

    function hideShiftOwnerWarning() {
        const existing = document.getElementById('shiftOwnerWarning');
        if (existing) existing.remove();
    }

    // ════════════════════════════════════════════════════════
    //  LỌC KHU VỰC BÀN
    // ════════════════════════════════════════════════════════
    // Bản đồ khu vực → từ khóa xuất hiện trong tên bàn
    const AREA_KEYWORDS = {
        'tang1':   ['t1', 'tầng 1', 'tang1', 'floor1', 'f1'],
        'tang2':   ['t2', 'tầng 2', 'tang2', 'floor2', 'f2'],
        'bancong': ['bc', 'ban công', 'bancong', 'balcony', 'ban cong'],
    };

    function tableMatchesArea(tableName, area) {
        if (area === 'all') return true;
        const name = tableName.toLowerCase();
        const keywords = AREA_KEYWORDS[area] || [];
        return keywords.some(kw => name.includes(kw));
    }

    function switchArea(area, el) {
        currentAreaFilter = area;
        document.querySelectorAll('.area-tab').forEach(t => t.classList.remove('active'));
        if (el) el.classList.add('active');

        const allCards = document.querySelectorAll('#tableGrid .tc');

        if (area === 'takeaway') {
            // Chỉ hiện các slot Mang về
            allCards.forEach(card => {
                card.style.display = card.dataset.area === 'takeaway' ? '' : 'none';
            });
        } else {
            // Ẩn slot Mang về, lọc bàn thường theo khu vực
            allCards.forEach(card => {
                if (card.dataset.area === 'takeaway') {
                    card.style.display = 'none';
                } else {
                    const nameEl = card.querySelector('.tc-name');
                    const name = nameEl ? nameEl.innerText : '';
                    card.style.display = tableMatchesArea(name, area) ? '' : 'none';
                }
            });
        }

        updateAreaSummary();
    }

    function updateAreaSummary() {
        const allCards = document.querySelectorAll('#tableGrid .tc');
        let visible = 0, occupied = 0, taOccupied = 0, taTotal = 0;

        allCards.forEach(card => {
            if (card.style.display === 'none') return;
            if (card.dataset.area === 'takeaway') {
                taTotal++;
                if (card.classList.contains('tc-takeaway-busy')) taOccupied++;
            } else {
                visible++;
                if (card.classList.contains('occupied')) occupied++;
            }
        });

        const summaryEl = document.getElementById('areaSummaryText');
        if (!summaryEl) return;

        if (currentAreaFilter === 'takeaway') {
            const taFree = taTotal - taOccupied;
            summaryEl.innerHTML =
                `<span style="color:var(--text3)">Slot mang về: <strong style="color:var(--text)">${taTotal}</strong></span>` +
                `&ensp;&middot;&ensp;<span style="color:var(--green)">✅ ${taFree} rảnh</span>` +
                `&ensp;&middot;&ensp;<span style="color:var(--amber)">🛍️ ${taOccupied} đang xử lý</span>`;

            // Cập nhật badge trên tab
            const badge = document.getElementById('takenAwayBadge');
            if (badge) {
                badge.textContent = taOccupied;
                badge.style.display = taOccupied > 0 ? 'inline-flex' : 'none';
            }
        } else {
            const empty = visible - occupied;
            summaryEl.innerHTML =
                `<span style="color:var(--text3)">Hiển thị <strong style="color:var(--text)">${visible}</strong> bàn</span>` +
                `&ensp;&middot;&ensp;<span style="color:var(--green)">✅ ${empty} trống</span>` +
                `&ensp;&middot;&ensp;<span style="color:var(--red)">🔴 ${occupied} có khách</span>`;

            // Cập nhật badge slot MV đang bận (luôn đếm dù đang ở tab nào)
            const allTA = document.querySelectorAll('#tableGrid .tc[data-area="takeaway"]');
            let busyTA = 0;
            allTA.forEach(c => { if (c.classList.contains('tc-takeaway-busy')) busyTA++; });
            const badge = document.getElementById('takenAwayBadge');
            if (badge) {
                badge.textContent = busyTA;
                badge.style.display = busyTA > 0 ? 'inline-flex' : 'none';
            }
        }
    }

    // ── Mở đơn MANG VỀ theo slot số (MV-1..MV-5) ────────────────
    async function openTakeaway(slotNum) {
        // ✅ Chặn khi chưa mở ca
        if (!currentShiftId) {
            const userRole = (window.USER_ROLE || '').toUpperCase();
            if (userRole === 'MANAGER' || userRole === 'ADMIN') {
                showToast('❌ Chưa mở ca làm việc! Vui lòng mở ca trước.', 'error');
                openShiftModal();
            } else {
                showToast('❌ Chưa có ca làm việc! Liên hệ quản lý để mở ca.', 'error');
            }
            return;
        }
        // ✅ Chặn tạo đơn mang về mới nếu không phải nhân viên ca
        const slotEl = document.getElementById(`takeaway-slot-${slotNum}`);
        const isBusySlot = slotEl && slotEl.classList.contains('tc-takeaway-busy');
        if (!isShiftOwner && !isBusySlot) {
            showToast('🚫 Ca hiện tại đang mở cho nhân viên khác. Bạn không thể tạo đơn mang về!', 'error');
            return;
        }

        currentOrderType     = 'TAKE_AWAY';
        currentTakeawaySlot  = slotNum || 1;
        currentTableId       = null;
        currentTableName     = `Mang về #MV-${currentTakeawaySlot}`;
        currentCart          = [];
        currentOrderId       = null;

        document.getElementById('panelTableName').innerText  = `🛍️ MV-${currentTakeawaySlot}`;
        document.getElementById('panelTableStatus').innerText = `Đơn mang về — slot #${currentTakeawaySlot}`;
        document.getElementById('orderPanel').classList.add('active');
        document.getElementById('overlay').classList.add('active');
        document.getElementById('searchInput').value = '';
        currentSearchFilter = '';

        currentCategoryFilter = 'all';
        document.querySelectorAll('.cat-item').forEach(c => c.classList.remove('active'));
        document.getElementById('cat-all')?.classList.add('active');

        const btnServed = document.getElementById('btnServed');
        const btnCancel = document.getElementById('btnCancel');
        if (btnServed) btnServed.style.display = 'none';
        if (btnCancel) btnCancel.style.display = 'none';

        renderSkeleton();

        try {
            const slotEl = document.getElementById(`takeaway-slot-${slotNum}`);
            const isBusy = slotEl && slotEl.classList.contains('tc-takeaway-busy');

            if (isBusy) {
                let existing = null;
                for (const st of ['COOKING', 'PENDING', 'SERVED']) {
                    const orders = await apiFetch(`/api/orders?branchId=${BRANCH_ID}&status=${st}&pageSize=100`);
                    existing = orders?.items?.find(o => 
                        o.orderType === 'TAKE_AWAY' && 
                        o.note && 
                        o.note.includes(`MV-${slotNum}`)
                    );
                    if (existing) break;
                }

                if (existing) {
                    currentOrderId = existing.id;
                    const orderDetail = await apiFetch(`/api/orders/${currentOrderId}`);
                    currentCart = orderDetail.items.map(oi => ({
                        id: oi.menuItemId,
                        name: oi.itemName,
                        price: oi.unitPrice,
                        qty: oi.quantity,
                        note: oi.note || '',
                        orderItemId: oi.id,
                        savedQty: oi.quantity // lưu số lượng ban đầu để chặn bớt/xóa
                    }));
                    document.getElementById('panelTableStatus').innerText = `Order #${currentOrderId} — ${existing.orderStatus}`;

                    if (btnServed) btnServed.style.display = '';
                    if (btnCancel) {
                        btnCancel.style.display = (window.USER_ROLE === 'MANAGER' || window.USER_ROLE === 'ADMIN') ? '' : 'none';
                    }
                }
            }
        } catch (err) {
            console.warn('Load existing takeaway order failed:', err);
        }

        renderItems();
        renderCart();
    }

