    async function loadBranchEmployees() {
        try {
            const res = await apiFetch(`/api/employees?branchId=${BRANCH_ID}&pageSize=100`);
            const select = document.getElementById('posShiftEmployeeId');
            select.innerHTML = '<option value="">-- Chọn nhân viên --</option>';
            if (res && res.items) {
                res.items.forEach(emp => {
                    const opt = document.createElement('option');
                    opt.value = emp.id;
                    opt.textContent = `${emp.fullName} (${emp.position})`;
                    select.appendChild(opt);
                });
            }
        } catch (err) {
            console.error('loadBranchEmployees error:', err);
            showToast('❌ Lỗi tải danh sách nhân viên: ' + err.message, 'error');
        }
    }

    function closePosModal(id) {
        document.getElementById(id).classList.remove('active');
    }

    async function submitPosOpenShift() {
        const empId = document.getElementById('posShiftEmployeeId').value;
        const cashInput = document.getElementById('posStartingCash').value;
        if (!empId) {
            showToast('⚠️ Vui lòng chọn nhân viên!', 'warn');
            return;
        }
        const cash = parseFloat(cashInput) || 0;
        if (cash < 0) {
            showToast('⚠️ Tiền đầu ca không thể âm!', 'warn');
            return;
        }

        try {
            showToast('⏳ Đang mở ca...', 'info');
            const newShift = await apiFetch('/api/shifts/open', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    BranchId: BRANCH_ID,
                    EmployeeId: parseInt(empId),
                    StartingCash: cash
                })
            });
            currentShiftId = newShift.id;
            closePosModal('posOpenShiftModal');

            // ✅ Cập nhật isShiftOwner khi mở ca mới từ POS
            const userRole = (window.USER_ROLE || '').toUpperCase();
            if (userRole === 'MANAGER' || userRole === 'ADMIN'
                || parseInt(empId) === window.EMPLOYEE_ID) {
                isShiftOwner = true;
                hideShiftOwnerWarning();
                showToast(`✅ Mở ca thành công! Ca #${currentShiftId} đang hoạt động.`);
            } else {
                isShiftOwner = false;
                // Lấy tên nhân viên đã chọn từ dropdown
                const selectedOpt = document.getElementById('posShiftEmployeeId');
                const empName = selectedOpt.options[selectedOpt.selectedIndex]?.text || 'nhân viên khác';
                showShiftOwnerWarning(empName);
                showToast(`⚠️ Ca mở cho ${empName}. Bạn không thể tạo đơn hàng!`, 'error');
            }
            
            // Reload layout shift badge
            if (window.loadShiftStatus) {
                await window.loadShiftStatus();
            }
        } catch (err) {
            console.error('submitPosOpenShift error:', err);
            showToast('❌ Mở ca thất bại: ' + err.message, 'error');
        }
    }

    async function onShiftBadgeClick() {
        if (!currentShiftId) return;
        try {
            showToast('⏳ Đang lấy thông tin ca...', 'info');
            const shift = await apiFetch(`/api/shifts/current/${BRANCH_ID}`);
            
            const startingCash = shift.startingCash || 0;
            const revenue = shift.revenue || 0;
            const expectedCash = startingCash + revenue;
            
            document.getElementById('posShiftSummary').innerHTML = `
                <div style="font-weight:700;font-size:15px;margin-bottom:10px;border-bottom:1px solid var(--border);padding-bottom:6px;">⏱️ Ca làm việc #${shift.id}</div>
                <div>👤 <strong>Nhân viên:</strong> ${shift.employeeName}</div>
                <div>💵 <strong>Tiền đầu ca:</strong> ${startingCash.toLocaleString('vi-VN')} đ</div>
                <div>☕ <strong>Doanh thu ca (Hoàn thành):</strong> ${revenue.toLocaleString('vi-VN')} đ</div>
                <div style="font-size:14px;margin-top:8px;padding-top:8px;border-top:1px dashed var(--border);color:var(--green);font-weight:700;">
                    💵 Tiền mặt dự kiến: ${expectedCash.toLocaleString('vi-VN')} đ
                </div>
                <div style="font-weight:700;font-size:13px;margin-top:16px;margin-bottom:8px;border-top:1px solid var(--border);padding-top:12px;">📋 Đơn hàng trong ca:</div>
                <div id="posShiftOrdersList" style="max-height:160px;overflow-y:auto;font-size:12px;display:flex;flex-direction:column;gap:6px;">
                    ⏳ Đang tải đơn hàng...
                </div>
            `;
            
            document.getElementById('posActualCash').value = expectedCash.toFixed(0);
            document.getElementById('posCloseNote').value = '';
            
            document.getElementById('posCloseShiftModal').classList.add('active');

            // Fetch shift orders
            apiFetch(`/api/orders?branchId=${BRANCH_ID}&shiftId=${shift.id}&pageSize=100`)
                .then(res => {
                    const listEl = document.getElementById('posShiftOrdersList');
                    if (!listEl) return;
                    const items = res?.items || [];
                    if (items.length === 0) {
                        listEl.innerHTML = '<div style="color:var(--text3);font-style:italic;text-align:center;padding:10px;">Không có đơn hàng nào trong ca</div>';
                        return;
                    }
                    listEl.innerHTML = items.map(o => `
                        <div style="display:flex;justify-content:space-between;align-items:center;padding:8px;background:var(--surface2);border-radius:6px;border:1px solid var(--border);">
                            <div>
                                <span style="font-weight:700;color:var(--brown-dark);">#${o.id}</span>
                                <span style="color:var(--text3);margin-left:4px;">(${o.orderType === 'DINE_IN' ? 'Bàn ' + (o.tableName || '—') : 'Mang về'})</span>
                            </div>
                            <div style="text-align:right;">
                                <span style="font-weight:700;color:var(--red);">${formatVND(o.finalAmount)}</span>
                                <span class="badge ${o.orderStatus === 'COMPLETED' ? 'badge-green' : o.orderStatus === 'CANCELLED' ? 'badge-red' : 'badge-amber'}" style="font-size:9px;padding:2px 6px;margin-left:4px;">
                                    ${o.orderStatus === 'COMPLETED' ? 'Hoàn thành' : o.orderStatus === 'CANCELLED' ? 'Đã hủy' : 'Đang chạy'}
                                </span>
                            </div>
                        </div>
                    `).join('');
                })
                .catch(err => {
                    const listEl = document.getElementById('posShiftOrdersList');
                    if (listEl) listEl.innerHTML = `<div style="color:var(--red);text-align:center;padding:10px;">❌ Lỗi tải đơn: ${err.message}</div>`;
                });
        } catch (err) {
            console.error('onShiftBadgeClick error:', err);
            showToast('❌ Lỗi lấy thông tin ca: ' + err.message, 'error');
        }
    }

    async function submitPosCloseShift() {
        if (!currentShiftId) return;
        const actualInput = document.getElementById('posActualCash').value;
        if (actualInput === '') {
            showToast('⚠️ Vui lòng nhập số tiền mặt thực tế!', 'warn');
            return;
        }
        const actualCash = parseFloat(actualInput);
        if (actualCash < 0) {
            showToast('⚠️ Tiền mặt thực tế không thể âm!', 'warn');
            return;
        }
        const note = document.getElementById('posCloseNote').value;
        
        try {
            // Check for active orders in the shift
            const res = await apiFetch(`/api/orders?branchId=${BRANCH_ID}&shiftId=${currentShiftId}&pageSize=100`);
            const items = res?.items || [];
            const activeOrders = items.filter(o => o.orderStatus !== 'COMPLETED' && o.orderStatus !== 'CANCELLED');
            if (activeOrders.length > 0) {
                const activeIds = activeOrders.map(o => `#${o.id}`).join(', ');
                const confirmMsg = `⚠️ Cảnh báo: Ca hiện tại đang có ${activeOrders.length} đơn hàng chưa thanh toán hoặc chưa hủy (${activeIds}). Bạn có chắc chắn muốn kết ca?`;
                if (!confirm(confirmMsg)) {
                    return;
                }
            }

            showToast('⏳ Đang đóng ca...', 'info');
            await apiFetch(`/api/shifts/${currentShiftId}/close`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    ActualEndingCash: actualCash,
                    Note: note
                })
            });
            
            showToast('✅ Đã đóng ca thành công!');
            closePosModal('posCloseShiftModal');
            
            currentShiftId = null;
            
            // Cập nhật lại badge trên topbar
            if (window.loadShiftStatus) {
                await window.loadShiftStatus();
            }
            
            // Yêu cầu mở ca mới
            openShiftModal();
        } catch (err) {
            console.error('submitPosCloseShift error:', err);
            showToast('❌ Đóng ca thất bại: ' + err.message, 'error');
        }
    }

    // Expose onShiftBadgeClick globally for Layout click handler
    window.onShiftBadgeClick = onShiftBadgeClick;

    // Load tổng tiền cho bàn đang occupied
    async function loadActiveOrdersState() {
        try {
            // Reset tất cả các slot mang về trước khi load
            for (let mv = 1; mv <= 5; mv++) {
                updateTakeawaySlotUI(mv, false, 0);
            }

            // Lấy tất cả đơn hàng ở trạng thái PENDING, COOKING, SERVED
            const activeStatuses = ['PENDING', 'COOKING', 'SERVED'];
            for (const status of activeStatuses) {
                const res = await apiFetch(`/api/orders?branchId=${BRANCH_ID}&status=${status}&pageSize=100`);
                const orders = res?.items || [];
                for (const order of orders) {
                    if (order.orderType === 'DINE_IN' && order.tableId) {
                        // Chỉ cập nhật tổng tiền cho bàn ĐÃ ĐƯỢC đánh dấu occupied trong DB
                        // KHÔNG tự động chuyển bàn sang trạng thái occupied
                        const tableEl = document.getElementById(`table-${order.tableId}`);
                        if (tableEl && tableEl.classList.contains('occupied')) {
                            const totalEl = tableEl.querySelector('.tc-total') || (() => {
                                const el = document.createElement('div');
                                el.className = 'tc-total';
                                el.id = `total-table-${order.tableId}`;
                                tableEl.querySelector('.tc-info')?.appendChild(el);
                                return el;
                            })();
                            if (totalEl) {
                                totalEl.innerText = order.finalAmount > 0 ? order.finalAmount.toLocaleString('vi-VN') + 'đ' : '';
                            }
                        }
                    } else if (order.orderType === 'TAKE_AWAY' && order.note) {
                        const match = order.note.match(/MV-(\d+)/);
                        if (match) {
                            const slotNum = parseInt(match[1]);
                            updateTakeawaySlotUI(slotNum, true, order.finalAmount);
                        }
                    }
                }
            }
        } catch (err) {
            console.warn('Error loading active orders state:', err);
        }
    }

    // ════════════════════════════════════════════════════════
    //  RENDER CATEGORIES (động từ API)
    // ════════════════════════════════════════════════════════
    const CATEGORY_ICONS = {
        'Cà phê': '☕', 'Coffee': '☕',
        'Trà': '🍵', 'Tea': '🍵',
        'Bánh': '🍰', 'Cake': '🍰',
        'Nước ép': '🧃', 'Sinh tố': '🥤',
        'Đá xay': '🧊',
    };

    function renderCategories(categories) {
        const panel = document.getElementById('categoriesPanel');
        panel.innerHTML = `
            <div class="cat-item active" id="cat-all" onclick="switchCategory('all', this)">
                <i style="font-size:18px">🍽️</i>
                <span style="font-size:9px; color:white">Tất cả</span>
            </div>
        `;
        categories.forEach(cat => {
            const icon = CATEGORY_ICONS[cat.name] || '☕';
            panel.innerHTML += `
                <div class="cat-item" id="cat-${cat.id}" onclick="switchCategory(${cat.id}, this)">
                    <i style="font-size:18px">${icon}</i>
                    <span style="font-size:9px; color:white">${cat.name}</span>
                </div>
            `;
        });
    }

    // ════════════════════════════════════════════════════════
    //  RENDER MENU ITEMS
    // ════════════════════════════════════════════════════════
    let currentCategoryFilter = 'all';
    let currentSearchFilter   = '';

    function renderItems() {
        const grid = document.getElementById('itemsGrid');
        const filtered = allMenuItems.filter(item => {
            const matchCat = currentCategoryFilter === 'all' || item.categoryId == currentCategoryFilter;
            const matchSearch = item.name.toLowerCase().includes(currentSearchFilter.toLowerCase());
            return matchCat && matchSearch;
        });

        if (filtered.length === 0) {
            grid.innerHTML = '<div style="text-align:center; color:var(--text3); padding:40px;">Không có món nào</div>';
            return;
        }

        grid.innerHTML = filtered.map(item => `
            <div class="item-card" onclick="addToCart(${item.id})" id="menu-item-${item.id}">
                <img src="${item.imageUrl || 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=200'}"
                     class="item-img"
                     onerror="this.src='https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=200'">
                <div class="item-details">
                    <div class="item-name">${item.name}</div>
                    <div class="item-price">${item.price.toLocaleString('vi-VN')}đ</div>
                </div>
            </div>
        `).join('');
    }

    function switchCategory(catId, el) {
        document.querySelectorAll('.cat-item').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        currentCategoryFilter = catId;
        renderItems();
    }

    function filterItems(val) {
        currentSearchFilter = val;
        renderItems();
    }

    // ════════════════════════════════════════════════════════
    //  MỞ PANEL ORDER
    // ════════════════════════════════════════════════════════
    async function openOrder(tableId, tableName, status) {
        // ✅ Chặn khi chưa mở ca
        if (!currentShiftId) {
            const userRole = (window.USER_ROLE || '').toUpperCase();
            if (userRole === 'MANAGER' || userRole === 'ADMIN') {
                showToast('❌ Chưa mở ca làm việc! Vui lòng mở ca trước.', 'error');
                openShiftModal();
            } else {
                showToast('❌ Chưa có ca làm việc! Liên hệ quản lý để mở ca.', 'error');
            }
            return;
        }

        const tableEl = document.getElementById(`table-${tableId}`);
        const realStatus = tableEl ? (tableEl.classList.contains('occupied') ? 'occupied' : tableEl.classList.contains('cleaning') ? 'cleaning' : 'empty') : status;

        // ✅ FIX: Chặn mở order khi bàn đang dọn
        if (realStatus === 'cleaning') {
            showToast(`🧹 Bàn "${tableName}" đang được dọn dẹp!\nVui lòng chờ hoặc chọn bàn khác.`, 'error');
            return;
        }

        // ✅ Chặn tạo đơn mới nếu không phải nhân viên ca (cho phép xem đơn đã có)
        if (!isShiftOwner && realStatus !== 'occupied') {
            showToast('🚫 Ca hiện tại đang mở cho nhân viên khác. Bạn không thể tạo đơn hàng mới!', 'error');
            return;
        }

        currentOrderType = 'DINE_IN';    // reset về dine-in khi click bàn
        currentTableId   = tableId;
        currentTableName = tableName;
        currentCart      = [];
        currentOrderId   = null;

        document.getElementById('panelTableName').innerText = tableName;
        document.getElementById('panelTableStatus').innerText =
            realStatus === 'occupied' ? 'Đang có khách' : 'Bàn trống';
        document.getElementById('orderPanel').classList.add('active');
        document.getElementById('overlay').classList.add('active');
        document.getElementById('searchInput').value = '';
        currentSearchFilter = '';

        // Reset về hiện tất cả items
        currentCategoryFilter = 'all';
        document.querySelectorAll('.cat-item').forEach(c => c.classList.remove('active'));
        document.getElementById('cat-all')?.classList.add('active');

        // Mặc định ẩn nút Đã Phục Vụ / Hủy Đơn
        const btnServed = document.getElementById('btnServed');
        const btnCancel = document.getElementById('btnCancel');
        if (btnServed) btnServed.style.display = 'none';
        if (btnCancel) btnCancel.style.display = 'none';

        renderSkeleton();

        try {
            if (realStatus === 'occupied') {
                // ✅ FIX: Tìm order ở TẤT CẢ trạng thái đang hoạt động (PENDING, COOKING, SERVED)
                let existing = null;
                for (const st of ['COOKING', 'PENDING', 'SERVED']) {
                    const orders = await apiFetch(
                        `/api/orders?branchId=${BRANCH_ID}&status=${st}&pageSize=100`
                    );
                    existing = orders?.items?.find(o => o.tableId == tableId);
                    if (existing) break;
                }

                if (existing) {
                    currentOrderId = existing.id;
                    // Load chi tiết order để lấy items
                    const orderDetail = await apiFetch(`/api/orders/${currentOrderId}`);
                    // Khôi phục giỏ hàng từ order có sẵn
                    currentCart = orderDetail.items.map(oi => ({
                        id: oi.menuItemId,
                        name: oi.itemName,
                        price: oi.unitPrice,
                        qty: oi.quantity,
                        note: oi.note || '',
                        orderItemId: oi.id,
                        savedQty: oi.quantity // lưu số lượng ban đầu để chặn bớt/xóa
                    }));
                    document.getElementById('panelTableStatus').innerText = `Order #${currentOrderId} — ${existing.orderStatus}`;

                    // ✅ FIX: Hiện nút Đã Phục Vụ / Hủy Đơn khi có đơn hàng đang hoạt động
                    if (btnServed) btnServed.style.display = '';
                    if (btnCancel) {
                        btnCancel.style.display = (window.USER_ROLE === 'MANAGER' || window.USER_ROLE === 'ADMIN') ? '' : 'none';
                    }
                }
            }
        } catch (err) {
            console.warn('Load existing order failed:', err);
        }

        renderItems();
        renderCart();
    }

    // ════════════════════════════════════════════════════════
    //  SKELETON LOADING
    // ════════════════════════════════════════════════════════
    function renderSkeleton() {
        const grid = document.getElementById('itemsGrid');
        grid.innerHTML = Array(8).fill('').map(() =>
            `<div class="item-card skeleton" style="height: 150px;"></div>`
        ).join('');
        document.getElementById('cartList').innerHTML =
            `<div class="skeleton" style="height:60px; margin-bottom:10px; border-radius:8px;"></div>
             <div class="skeleton" style="height:60px; border-radius:8px;"></div>`;
    }

    // ════════════════════════════════════════════════════════
    //  ĐÓNG PANEL
    // ════════════════════════════════════════════════════════
    function closeOrder() {
        document.getElementById('orderPanel').classList.remove('active');
        document.getElementById('overlay').classList.remove('active');
        // Reset promo/customer UI
        const pi = document.getElementById('promoInput'); if (pi) pi.value = '';
        const pInfo = document.getElementById('promoInfo'); if (pInfo) pInfo.innerText = '';
        const ci = document.getElementById('custPhoneInput'); if (ci) ci.value = '';
        const cInfo = document.getElementById('custInfo'); if (cInfo) cInfo.innerText = '';
        currentDiscount = 0; currentPromoCode = null; currentCustomerId = null; currentCustomerName = '';
    }

    function closeReceipt() {
        document.getElementById('receiptModal').classList.remove('active');
        document.getElementById('overlay').classList.remove('active');
    }

    // ════════════════════════════════════════════════════════
    //  GIỎ HÀNG
    // ════════════════════════════════════════════════════════
    function addToCart(menuItemId) {
        const item = allMenuItems.find(i => i.id === menuItemId);
        if (!item) return;

        // CHỈ cộng dồn vào món CHƯA được lưu dưới DB (không có orderItemId)
        const exist = currentCart.find(i => i.id === menuItemId && !i.orderItemId);
        if (exist) {
            exist.qty++;
        } else {
            currentCart.push({ id: item.id, name: item.name, price: item.price, qty: 1, note: '' });
        }

        // Micro-animation cho item card
        const card = document.getElementById(`menu-item-${menuItemId}`);
        if (card) {
            card.style.transform = 'scale(0.93)';
            setTimeout(() => card.style.transform = '', 150);
        }

        renderCart();
    }

    function renderCart() {
        const list = document.getElementById('cartList');
        if (currentCart.length === 0) {
            list.innerHTML = '<div style="text-align:center; color:var(--text3); margin-top:50px; font-size:14px;">🛒 Giỏ hàng trống</div>';
            updateTotals();
            return;
        }
        list.innerHTML = currentCart.map((i, idx) => `
            <div class="cart-item">
                <div style="flex:1">
                    <div style="font-weight:700; font-size:13px;">${i.name}</div>
                    <input type="text"
                           placeholder="Ghi chú (ít đường, nhiều đá...)"
                           value="${i.note}"
                           onchange="updateNote(${idx}, this.value)"
                           style="width:100%; border:none; border-bottom:1px solid var(--border);
                                  font-size:11px; outline:none; padding:3px 0;
                                  background:transparent; color:var(--text); margin-top:4px;">
                    <div class="qty-ctrl" style="margin-top:6px;">
                        <button class="btn-qty" onclick="updateQty(${idx}, -1)">−</button>
                        <span style="font-weight:700; min-width:24px; text-align:center;">${i.qty}</span>
                        <button class="btn-qty" onclick="updateQty(${idx}, 1)">+</button>
                    </div>
                </div>
                <div style="font-weight:700; color:var(--red); font-size:13px; white-space:nowrap; padding-left:8px;">
                    ${(i.price * i.qty).toLocaleString('vi-VN')}đ
                </div>
            </div>
        `).join('');
        updateTotals();
    }

    function updateNote(idx, val) {
        if (currentCart[idx]) currentCart[idx].note = val;
    }

    function updateQty(idx, delta) {
        if (!currentCart[idx]) return;
        const item = currentCart[idx];

        // ✅ FIX BUG-05: Phân quyền xóa/bớt món đã lưu
        if (delta < 0 && item.orderItemId) {
            if (window.USER_ROLE === 'MANAGER' || window.USER_ROLE === 'ADMIN') {
                // Manager được phép xóa món đã lưu trên DB
                const newQty = item.qty + delta;
                if (newQty <= 0) {
                    if (!confirm(`Xóa "${item.name}" khỏi đơn hàng? (Thao tác này sẽ xóa trên hệ thống)`)) return;
                    // Gọi API xóa món trên DB
                    apiFetch(`/api/orders/${currentOrderId}/items/${item.orderItemId}`, {
                        method: 'DELETE'
                    }).then(() => {
                        currentCart.splice(idx, 1);
                        renderCart();
                        showToast(`✅ Đã xóa "${item.name}" khỏi đơn`);
                    }).catch(err => {
                        showToast('❌ Không thể xóa món: ' + err.message, 'error');
                    });
                    return; // chờ API, không thay đổi cart ngay
                } else {
                    showToast('⚠️ Chỉ có thể xóa hoàn toàn món đã lưu, không thể bớt số lượng. Nhấn xóa (−) thêm lần nữa.', 'warn');
                    return;
                }
            } else {
                // Nhân viên thường không được xóa món đã lưu
                showToast('⚠️ Món đã lưu không thể xóa! Liên hệ quản lý nếu cần hủy món này.', 'warn');
                return;
            }
        }

        // Ngăn chặn tăng số lượng trực tiếp trên dòng đã lưu (mọi role)
        if (delta > 0 && item.orderItemId) {
            showToast('⚠️ Món đã lưu không thể chỉnh sửa trực tiếp. Vui lòng bấm chọn món đó ở menu bên trái để thêm ly mới!', 'warn');
            return;
        }

        item.qty += delta;
        if (item.qty <= 0) currentCart.splice(idx, 1);
        renderCart();
    }

    function updateTotals() {
        const subtotal = currentCart.reduce((s, i) => s + i.price * i.qty, 0);
        const final    = Math.max(0, subtotal - currentDiscount);
        document.getElementById('subtotal').innerText = subtotal.toLocaleString('vi-VN') + 'đ';
        document.getElementById('finalTotal').innerText = final.toLocaleString('vi-VN') + 'đ';
        const discRow = document.getElementById('discountRow');
        const discAmt = document.getElementById('discountAmt');
        if (currentDiscount > 0 && discRow && discAmt) {
            discRow.style.display = 'flex';
            discAmt.innerText = '-' + currentDiscount.toLocaleString('vi-VN') + 'đ';
        } else if (discRow) { discRow.style.display = 'none'; }
    }

    // ════════════════════════════════════════════════════════
    //  LOOKUP KHÁCH HÀNG
    // ════════════════════════════════════════════════════════
    async function lookupCustomer() {
        const phone = document.getElementById('custPhoneInput')?.value?.trim();
        if (!phone) return;
        const info = document.getElementById('custInfo');
        info.innerText = '⏳ Đang tìm...';
        try {
            const c = await apiFetch(`/api/customers/lookup?phone=${encodeURIComponent(phone)}`);
            currentCustomerId   = c.id;
            currentCustomerName = c.fullName;
            const tierBadge = { BRONZE:'🥉', SILVER:'🥈', GOLD:'🥇' }[c.memberTier] || '🥉';
            info.style.color = 'var(--green)';
            info.innerText = `${tierBadge} ${c.fullName} — ${c.points} điểm (${c.memberTier})`;
        } catch {
            currentCustomerId = null; currentCustomerName = '';
            info.style.color = 'var(--red)';
            info.innerText = '❌ Không tìm thấy khách hàng';
        }
    }

    // ════════════════════════════════════════════════════════
    //  ÁP MÃ KHUYẾN MÃI
    // ════════════════════════════════════════════════════════
    // ✅ FIX BUG-02: applyPromo tách thành 2 bước:
    //   - Luôn validate và hiển thị preview giảm giá (UX)
    //   - Nếu đã có orderId → gọi API ghi vào DB ngay
    //   - Nếu chưa có orderId → lưu tạm pendingPromoCode, áp sau khi tạo order
    async function applyPromo() {
        const code = document.getElementById('promoInput')?.value?.trim().toUpperCase();
        if (!code) return;
        const info = document.getElementById('promoInfo');
        info.innerText = '⏳ Đang kiểm tra...';
        try {
            // Bước 1: Validate mã và tính preview
            const promos = await apiFetch('/api/promotions?activeOnly=true');
            const promo = promos?.find(p => p.code?.toUpperCase() === code);
            if (!promo) throw new Error('Mã không hợp lệ hoặc đã hết hạn');
            const subtotal = currentCart.reduce((s, i) => s + i.price * i.qty, 0);
            if (promo.minOrderValue && subtotal < promo.minOrderValue) {
                throw new Error(`Đơn tối thiểu ${promo.minOrderValue.toLocaleString('vi-VN')}đ`);
            }
            let discount = 0;
            if (promo.discountType === 'PERCENT') {
                discount = subtotal * promo.value / 100;
                if (promo.maxDiscountValue) discount = Math.min(discount, promo.maxDiscountValue);
            } else { discount = promo.value; }
            currentDiscount  = Math.round(discount);
            currentPromoCode = code;

            // Bước 2: Nếu đã có orderId → ghi ngay vào DB
            if (currentOrderId) {
                try {
                    const result = await apiFetch(`/api/orders/${currentOrderId}/promotions`, {
                        method: 'POST',
                        body: JSON.stringify({ PromotionCode: code })
                    });
                    // Server trả về order đã cập nhật → đồng bộ discount từ DB
                    if (result && result.discountAmount !== undefined) {
                        currentDiscount = result.discountAmount;
                    }
                    pendingPromoCode = null;
                    info.style.color = 'var(--green)';
                    info.innerText = `🎉 "${promo.name}" — Giảm ${currentDiscount.toLocaleString('vi-VN')}đ (đã lưu)`;
                } catch (apiErr) {
                    // Nếu API thất bại (vd: đã áp rồi), vẫn hiển thị preview
                    pendingPromoCode = null;
                    currentDiscount  = 0;
                    currentPromoCode = null;
                    throw apiErr;
                }
            } else {
                // Chưa có order → lưu tạm, sẽ áp khi saveOrder
                pendingPromoCode = code;
                info.style.color = 'var(--amber)';
                info.innerText = `⏳ "${promo.name}" — Giảm ~${currentDiscount.toLocaleString('vi-VN')}đ (áp khi lưu đơn)`;
            }
            updateTotals();
        } catch(e) {
            currentDiscount = 0; currentPromoCode = null; pendingPromoCode = null;
            info.style.color = 'var(--red)';
            info.innerText = '❌ ' + e.message;
            updateTotals();
        }
    }

    // ════════════════════════════════════════════════════════
    //  LƯU ĐƠN → ghi vào DB, bếp nhận
    // ════════════════════════════════════════════════════════
    async function saveOrder() {
        if (currentCart.length === 0) { showToast('⚠️ Giỏ hàng trống!', 'warn'); return; }
        if (!currentShiftId) { showToast('❌ Chưa mở ca làm việc!', 'error'); return; }

        // ✅ Kiểm tra nhân viên có quyền order trong ca này không
        if (!isShiftOwner) {
            showToast('❌ Ca hiện tại đang mở cho nhân viên khác. Bạn không được phép tạo đơn hàng!', 'error');
            return;
        }

        // ✅ FIX: Kiểm tra bàn có đang dọn không trước khi lưu đơn
        if (currentOrderType === 'DINE_IN' && currentTableId && !currentOrderId) {
            try {
                const tables = await apiFetch(`/api/tables?branchId=${BRANCH_ID}`);
                const table = tables?.find(t => t.id == currentTableId);
                if (table && table.status === 'CLEANING') {
                    showToast(`🧹 Bàn "${currentTableName}" đang được dọn dẹp! Không thể tạo đơn.`, 'error');
                    return;
                }
            } catch (e) { console.warn('Không kiểm tra được trạng thái bàn:', e.message); }
        }

        // ✅ FIX BUG-03: Chặn double-click — tránh tạo 2 order trùng cho cùng 1 bàn
        if (isSaving) { showToast('⏳ Đang xử lý, vui lòng chờ...', 'warn'); return; }
        isSaving = true;

        const btn = document.getElementById('btnSave');
        btn.disabled = true; btn.innerText = '⏳...';

        try {
            // Bước 1: Tạo order nếu chưa có
            if (!currentOrderId) {
                const isTakeaway = currentOrderType === 'TAKE_AWAY';
                const od = await apiFetch('/api/orders', {
                    method: 'POST',
                    body: JSON.stringify({
                        BranchId: BRANCH_ID, ShiftId: currentShiftId,
                        TableId: isTakeaway ? null : parseInt(currentTableId),
                        OrderType: currentOrderType,
                        Note: isTakeaway ? `Đơn mang về — MV-${currentTakeawaySlot}` : '',
                        CustomerId: currentCustomerId || null
                    })
                });
                currentOrderId = od.id;

                // Promo code logic moved to after items are added so SubTotal > 0
            }

            // Bước 2: Thêm món mới
            const newItems = currentCart.filter(i => !i.orderItemId);
            // Nhân bản danh sách mới để in trước khi đánh dấu đã lưu
            const printSnapshot = newItems.map(i => ({ ...i }));

            for (const item of newItems) {
                await apiFetch(`/api/orders/${currentOrderId}/items`, {
                    method: 'POST',
                    body: JSON.stringify({ MenuItemId: item.id, Quantity: item.qty, Note: item.note || '' })
                });
                item.orderItemId = true;
                item.savedQty = item.qty; // thiết lập số lượng đã lưu ban đầu
            }

            // ✅ FIX BUG-02: Áp mã khuyến mãi đang chờ (pendingPromoCode) vào order sau khi đã thêm món
            if (pendingPromoCode) {
                try {
                    const promoResult = await apiFetch(`/api/orders/${currentOrderId}/promotions`, {
                        method: 'POST',
                        body: JSON.stringify({ PromotionCode: pendingPromoCode })
                    });
                    // Đồng bộ discount từ server
                    if (promoResult && promoResult.discountAmount !== undefined) {
                        currentDiscount = promoResult.discountAmount;
                    }
                    const promoInfo = document.getElementById('promoInfo');
                    if (promoInfo) {
                        promoInfo.style.color = 'var(--green)';
                        promoInfo.innerText = promoInfo.innerText.replace('(áp khi lưu đơn)', '(đã lưu)');
                    }
                } catch (promoErr) {
                    console.warn('Áp mã khuyến mãi thất bại:', promoErr.message);
                    showToast('⚠️ Mã khuyến mãi không áp được: ' + promoErr.message, 'warn');
                    currentDiscount = 0;
                } finally {
                    pendingPromoCode = null;
                }
            }

            // Bước 3: Set COOKING
            await apiFetch(`/api/orders/${currentOrderId}/status`, {
                method: 'PATCH',
                body: JSON.stringify({ Status: 'COOKING', Note: 'Order từ POS' })
            });

            // Bước 4: Đồng bộ FinalAmount từ server để hiển thị đúng
            try {
                const orderDetail = await apiFetch(`/api/orders/${currentOrderId}`);
                if (orderDetail) {
                    currentDiscount = orderDetail.discountAmount || 0;
                    updateTotals();
                    // Cập nhật tổng tiền hiển thị trên bàn
                    if (currentOrderType !== 'TAKE_AWAY') {
                        updateTableUI(currentTableId, 'occupied', orderDetail.finalAmount);
                    } else {
                        updateTakeawaySlotUI(currentTakeawaySlot, true, orderDetail.finalAmount);
                    }
                }
            } catch { /* không làm gián đoạn nếu fetch detail thất bại */ }

            // Bước 5: Cập nhật UI bàn nếu chưa cập nhật
            if (currentOrderType !== 'TAKE_AWAY') {
                const tableEl = document.getElementById(`table-${currentTableId}`);
                if (tableEl && !tableEl.classList.contains('occupied')) {
                    updateTableUI(currentTableId, 'occupied', currentCart.reduce((s, i) => s + i.price * i.qty, 0));
                }
            } else {
                const slotEl = document.getElementById(`takeaway-slot-${currentTakeawaySlot}`);
                if (slotEl && !slotEl.classList.contains('tc-takeaway-busy')) {
                    updateTakeawaySlotUI(currentTakeawaySlot, true, currentCart.reduce((s, i) => s + i.price * i.qty, 0));
                }
            }

            // Hiện nút Đã Phục Vụ và Hủy đơn sau khi lưu
            const btnServed = document.getElementById('btnServed');
            const btnCancel = document.getElementById('btnCancel');
            if (btnServed) btnServed.style.display = '';
            if (btnCancel) {
                btnCancel.style.display = (window.USER_ROLE === 'MANAGER' || window.USER_ROLE === 'ADMIN') ? '' : 'none';
            }

            showToast(`✅ Đã lưu Order #${currentOrderId} — Bếp đang xử lý!`);
            renderCart();

            // 🏷️ Lưu lịch sử in tem sau khi lưu đơn
            if (printSnapshot.length > 0) {
                showLabelModal(currentOrderId, currentTableName, printSnapshot, false, false);
            }
        } catch (err) {
            showToast('❌ ' + err.message, 'error');
        } finally {
            isSaving = false; // ✅ FIX BUG-03: luôn reset flag dù thành công hay thất bại
            btn.disabled = false; btn.innerText = '📋 LƯU ĐƠN';
        }
    }

    // ════════════════════════════════════════════════════════
    //  IN TEM GỌI ĐỒ (🏷️ Label Print)
    // ════════════════════════════════════════════════════════
    function showLabelModal(orderId, tableName, cartSnapshot, autoPrint = false, showModal = true) {
        const now = new Date();
        const dateStr = now.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
        const timeStr = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        const dtStr   = `${dateStr} — ${timeStr}`;

        document.getElementById('labelOrderId').innerText   = orderId ?? '—';
        document.getElementById('labelTableName').innerText = tableName ?? '—';
        document.getElementById('labelDateTime').innerText  = dtStr;

        const area = document.getElementById('labelPrintArea');
        area.innerHTML = '';
        let totalLabels = 0;

        cartSnapshot.forEach(item => {
            for (let cup = 1; cup <= item.qty; cup++) {
                totalLabels++;
                area.innerHTML += buildLabelCard({
                    orderId, tableName,
                    itemName: item.name,
                    cupIndex: cup, totalCups: item.qty,
                    note: item.note || '',
                    dateStr, timeStr,
                    globalIndex: totalLabels,
                    employeeName: window.FULL_NAME || '—'
                });
            }
        });

        document.getElementById('labelTotalCount').innerText = `${totalLabels} tem`;
        if (showModal) {
            document.getElementById('labelModalOverlay').classList.add('active');
        }

        // Lưu lịch sử in vào localStorage
        savePrintHistory({ 
            orderId, 
            tableName, 
            dtStr, 
            totalLabels, 
            employeeName: window.FULL_NAME || '—',
            items: cartSnapshot.map(i => ({
                name: i.name, qty: i.qty, note: i.note || ''
            })) 
        });

        // Tự động in sau 400ms (chờ DOM render xong)
        if (autoPrint) {
            setTimeout(() => { window.print(); }, 400);
        }
    }

    // ── Lưu lịch sử in tem vào localStorage ────────────────────────
    const PRINT_HISTORY_KEY = 'cafe_print_history';
    const MAX_PRINT_HISTORY = 100;

    function savePrintHistory(record) {
        try {
            const existing = JSON.parse(localStorage.getItem(PRINT_HISTORY_KEY) || '[]');
            existing.unshift(record);                          // mới nhất lên đầu
            if (existing.length > MAX_PRINT_HISTORY) existing.length = MAX_PRINT_HISTORY;
            localStorage.setItem(PRINT_HISTORY_KEY, JSON.stringify(existing));
        } catch (e) { console.warn('savePrintHistory error:', e); }
    }

    // Đọc lịch sử in (public, được gọi từ trang lịch sử)
    window.getPrintHistory = function() {
        try { return JSON.parse(localStorage.getItem(PRINT_HISTORY_KEY) || '[]'); }
        catch (e) { return []; }
    };
    window.clearPrintHistory = function() {
        localStorage.removeItem(PRINT_HISTORY_KEY);
    };

    function buildLabelCard({ orderId, tableName, itemName, cupIndex, totalCups, note, dateStr, timeStr, globalIndex, employeeName }) {
        const isMulti = totalCups > 1;
        const cupBadge = isMulti ? `<span class="label-cup-badge">${cupIndex}/${totalCups}</span>` : '';
        const noteHtml = note
            ? `<div class="label-note">⚠️ ${note}</div>`
            : `<div class="label-note" style="color:#aaa;font-style:italic;">— Không có yêu cầu đặc biệt</div>`;
        const isTakeaway = currentOrderType === 'TAKE_AWAY';
        const tableDisplay = isTakeaway
            ? `<span class="label-takeaway-badge">🛍️ ${tableName}</span>`
            : `<span class="label-table-badge">🧩 ${tableName}</span>`;
        const empName = employeeName || window.FULL_NAME || '—';
        return `
        <div class="label-card">
            <div class="label-top">
                <div class="label-seq">#${String(globalIndex).padStart(2,'0')}</div>
                ${tableDisplay}
                ${cupBadge}
            </div>
            <div class="label-item-name">${itemName}</div>
            <div class="label-waiter" style="font-size: 11px; font-weight: 700; color: #333; margin-top: 4px; margin-bottom: 4px;">
                👤 NV Order: <span style="text-decoration: underline;">${empName}</span>
            </div>
            ${noteHtml}
            <div class="label-footer">
                <span>Order #${orderId}</span>
                <span>${dateStr} &bull; ${timeStr}</span>
            </div>
        </div>`;
    }

    function closeLabelModal() {
        document.getElementById('labelModalOverlay').classList.remove('active');
    }

    // ════════════════════════════════════════════════════════
    //  THANH TOÁN → mở modal chọn phương thức
    // ════════════════════════════════════════════════════════
    async function openPaymentModal() {
        if (!currentOrderId && currentCart.length === 0) {
            showToast('⚠️ Chưa có đơn hàng để thanh toán!', 'warn'); return;
        }

        // ✅ FIX: Kiểm tra bàn có đang dọn không trước khi thanh toán
        if (currentOrderType === 'DINE_IN' && currentTableId && !currentOrderId) {
            try {
                const tables = await apiFetch(`/api/tables?branchId=${BRANCH_ID}`);
                const table = tables?.find(t => t.id == currentTableId);
                if (table && table.status === 'CLEANING') {
                    showToast(`🧹 Bàn "${currentTableName}" đang được dọn dẹp! Không thể thanh toán.`, 'error');
                    return;
                }
            } catch (e) { console.warn('Không kiểm tra được trạng thái bàn:', e.message); }
        }

        const total = currentCart.reduce((s, i) => s + i.price * i.qty, 0) - currentDiscount;
        document.getElementById('pmTableName').innerText = currentTableName;
        document.getElementById('pmTotal').innerText = total.toLocaleString('vi-VN') + 'đ';
        document.getElementById('payModalOverlay').classList.add('active');
    }

    function closePaymentModal() {
        document.getElementById('payModalOverlay').classList.remove('active');
    }

    async function processPayment() {
        const btn = document.getElementById('btnConfirmPay');
        btn.disabled = true; btn.innerText = '⏳ Đang xử lý...';

        try {
            // Bước 1: Nếu chưa lưu đơn thì lưu trước
            if (!currentOrderId) { await saveOrder(); }
            if (!currentOrderId) throw new Error('Không thể tạo đơn hàng');

            const method = document.getElementById('pmMethod').value;

            // ✅ FIX BUG-01: Lấy FinalAmount từ DB thay vì tính lại ở frontend
            // Điều này đảm bảo giảm giá, điều chỉnh server-side đều được tính đúng
            let finalAmount;
            try {
                const orderFromDB = await apiFetch(`/api/orders/${currentOrderId}`);
                finalAmount = orderFromDB.finalAmount;
                if (finalAmount === undefined || finalAmount === null) {
                    throw new Error('Không lấy được tổng tiền từ server');
                }
                if (finalAmount <= 0) {
                    // Đơn 0đ (đã giảm 100%) — vẫn cần tạo payment để ghi nhận
                    // nhưng cảnh báo để nhân viên xác nhận
                    if (!confirm(`Tổng tiền sau giảm giá là 0đ. Xác nhận hoàn tất đơn miễn phí?`)) {
                        btn.disabled = false; btn.innerText = '✅ Xác nhận thanh toán';
                        return;
                    }
                    finalAmount = 0;
                }
            } catch (fetchErr) {
                // Fallback: tính từ cart nếu không fetch được (mất mạng)
                console.warn('Không thể lấy FinalAmount từ server, dùng fallback:', fetchErr.message);
                finalAmount = Math.max(0, currentCart.reduce((s, i) => s + i.price * i.qty, 0) - currentDiscount);
            }

            // Cập nhật hiển thị tổng tiền trong modal đúng với server
            const pmTotalEl = document.getElementById('pmTotal');
            if (pmTotalEl) pmTotalEl.innerText = finalAmount.toLocaleString('vi-VN') + 'đ';

            // Bước 2: Tạo payment với Amount từ server
            await apiFetch('/api/payments', {
                method: 'POST',
                body: JSON.stringify({ OrderId: currentOrderId, Amount: finalAmount, Method: method })
            });

            // Bước 3: Mark COMPLETED
            await apiFetch(`/api/orders/${currentOrderId}/status`, {
                method: 'PATCH',
                body: JSON.stringify({ Status: 'COMPLETED', Note: 'Thanh toán thành công' })
            });

            // Bước 4: Trả bàn về EMPTY (chỉ khi DINE_IN)
            if (currentOrderType !== 'TAKE_AWAY' && currentTableId) {
                await apiFetch(`/api/tables/${currentTableId}/status`, {
                    method: 'PATCH',
                    body: JSON.stringify({ Status: 'EMPTY' })
                });
                updateTableUI(currentTableId, 'empty', 0);
            } else if (currentOrderType === 'TAKE_AWAY') {
                updateTakeawaySlotUI(currentTakeawaySlot, false, 0);
            }

            closePaymentModal();
            showReceipt(currentOrderId, method, finalAmount); // ✅ FIX BUG-01: truyền finalAmount đã đồng bộ
            closeOrder();
            showToast(`✅ Thanh toán thành công! Order #${currentOrderId} — ${finalAmount.toLocaleString('vi-VN')}đ`);

            const btnServed2 = document.getElementById('btnServed');
            const btnCancel2 = document.getElementById('btnCancel');
            if (btnServed2) btnServed2.style.display = 'none';
            if (btnCancel2) btnCancel2.style.display = 'none';
        } catch (err) {
            showToast('❌ ' + err.message, 'error');
        } finally {
            btn.disabled = false; btn.innerText = '✅ Xác nhận thanh toán';
        }
    }

    function updateTableUI(tableId, status, total) {
        const el = document.getElementById(`table-${tableId}`);
        if (!el) return;
        el.className = `tc ${status}`;
        
        // Dynamically update the onclick attribute to prevent stale status parameter
        const name = el.querySelector('.tc-name')?.innerText || '';
        el.setAttribute('onclick', `openOrder('${tableId}', '${name.replace(/'/g, "\\'")}', '${status}')`);

        const statusEl = el.querySelector('.tc-status');
        if (statusEl) statusEl.innerText = status === 'occupied' ? 'Có khách' : status === 'cleaning' ? 'Đang dọn' : 'Trống';
        let totalEl = el.querySelector('.tc-total');
        if (status === 'occupied') {
            if (!totalEl) {
                totalEl = document.createElement('div');
                totalEl.className = 'tc-total';
                totalEl.id = `total-table-${tableId}`;
                el.querySelector('.tc-info')?.appendChild(totalEl);
            }
            totalEl.innerText = total > 0 ? total.toLocaleString('vi-VN') + 'đ' : '';
        } else if (totalEl) { totalEl.remove(); }
    }

    // ── Cập nhật UI slot MV (Mang về) ───────────────────────
    function updateTakeawaySlotUI(slotNum, busy, total) {
        const el = document.getElementById(`takeaway-slot-${slotNum}`);
        if (!el) return;

        if (busy) {
            el.classList.add('tc-takeaway-busy');
            const statusEl = el.querySelector('.tc-takeaway-label');
            if (statusEl) statusEl.innerText = 'Đang xử lý';
            const totalEl = document.getElementById(`total-takeaway-${slotNum}`);
            if (totalEl) {
                totalEl.innerText = total > 0 ? total.toLocaleString('vi-VN') + 'đ' : '';
                totalEl.style.display = total > 0 ? '' : 'none';
            }
        } else {
            el.classList.remove('tc-takeaway-busy');
            const statusEl = el.querySelector('.tc-takeaway-label');
            if (statusEl) statusEl.innerText = 'Mang về';
            const totalEl = document.getElementById(`total-takeaway-${slotNum}`);
            if (totalEl) { totalEl.innerText = ''; totalEl.style.display = 'none'; }
        }

        updateAreaSummary();
    }

    // ════════════════════════════════════════════════════════
    //  HIỂN THỊ RECEIPT
    // ════════════════════════════════════════════════════════
    // ✅ FIX BUG-01: Nhận thêm tham số finalAmount từ server để in hóa đơn đúng
    function showReceipt(orderId, method, finalAmount) {
        const subtotal = currentCart.reduce((s, i) => s + i.price * i.qty, 0);
        // Nếu server truyền finalAmount thì dùng, fallback là tính từ cart
        const serverFinalAmount = (finalAmount !== undefined && finalAmount !== null)
            ? finalAmount
            : Math.max(0, subtotal - (currentDiscount || 0));
        const discountToShow = subtotal - serverFinalAmount;
        const methodLabel = { CASH:'💵 Tiền mặt', BANK:'🏦 Chuyển khoản', CARD:'💳 Thẻ' }[method] || 'Tiền mặt';

        document.getElementById('rTable').innerText = currentTableName;
        document.getElementById('rOrderId').innerText = orderId ?? '-';
        document.getElementById('rCust').innerText = currentCustomerName || 'Khách lẻ';
        document.getElementById('rDate').innerText = new Date().toLocaleString('vi-VN');
        document.getElementById('rMethod').innerText = methodLabel;
        document.getElementById('receiptItems').innerHTML = currentCart.map(i => `
            <div class="receipt-item">
                <span>${i.qty}x ${i.name}</span>
                <span>${(i.price * i.qty).toLocaleString('vi-VN')}</span>
            </div>
            ${i.note ? `<div style="font-size:11px;font-style:italic;margin:-5px 0 5px;color:#666;"> ↳ ${i.note}</div>` : ''}
        `).join('');
        if (discountToShow > 0) {
            const dr = document.getElementById('rDiscountRow');
            if (dr) dr.style.display = 'flex';
            const rdEl = document.getElementById('rDiscount');
            if (rdEl) rdEl.innerText = discountToShow.toLocaleString('vi-VN') + 'đ';
        }
        document.getElementById('rTotal').innerText = serverFinalAmount.toLocaleString('vi-VN');
        document.getElementById('receiptModal').classList.add('active');
        document.getElementById('overlay').classList.add('active');
        currentCart = []; currentOrderId = null; currentDiscount = 0;
        currentPromoCode = null; pendingPromoCode = null; currentCustomerName = '';
    }

    // ════════════════════════════════════════════════════════
    //  DRAG & DROP (gộp bàn)
    // ════════════════════════════════════════════════════════
    function drag(ev, id, name) {
        draggedTableId = id;
        ev.dataTransfer.setData('text', id);
        ev.currentTarget.style.opacity = '0.4';
    }
    function allowDrop(ev) {
        ev.preventDefault();
        ev.currentTarget.classList.add('drag-over');
    }
    function dragLeave(ev) {
        ev.currentTarget.classList.remove('drag-over');
        document.querySelectorAll('.tc').forEach(el => el.style.opacity = '1');
    }
    function drop(ev, targetId, targetName) {
        ev.preventDefault();
        ev.currentTarget.classList.remove('drag-over');
        document.querySelectorAll('.tc').forEach(el => el.style.opacity = '1');
        if (draggedTableId && draggedTableId != targetId) {
            showToast(`🔄 Gộp bàn ${draggedTableId} → ${targetName} (tính năng đang phát triển)`, 'warn');
        }
        draggedTableId = null;
    }

    // ════════════════════════════════════════════════════════
    //  MARK SERVED
    // ════════════════════════════════════════════════════════
    async function markServed() {
        if (!currentOrderId) { showToast('⚠️ Chưa có đơn hàng!', 'warn'); return; }
        const btn = document.getElementById('btnServed');
        btn.disabled = true; btn.innerText = '⏳...';
        try {
            await apiFetch(`/api/orders/${currentOrderId}/status`, {
                method: 'PATCH',
                body: JSON.stringify({ Status: 'SERVED', Note: 'Đã phục vụ tại bàn' })
            });
            showToast(`✅ Order #${currentOrderId} đã được phục vụ!`, 'success');
            document.getElementById('panelTableStatus').innerText = `Order #${currentOrderId} — Đã phục vụ`;
            btn.style.display = 'none';
        } catch(e) {
            showToast('❌ ' + e.message, 'error');
        } finally {
            btn.disabled = false; btn.innerText = '✅ ĐÃ PHỤC VỤ';
        }
    }

    // ════════════════════════════════════════════════════════
    //  HỦY ĐƠN
    // ════════════════════════════════════════════════════════
    async function cancelOrder() {
        if (!currentOrderId) { showToast('⚠️ Chưa có đơn hàng!', 'warn'); return; }
        if (!confirm(`Bạn chắc muốn HỦY Order #${currentOrderId}?`)) return;
        const btn = document.getElementById('btnCancel');
        btn.disabled = true; btn.innerText = '⏳...';
        try {
            await apiFetch(`/api/orders/${currentOrderId}/status`, {
                method: 'PATCH',
                body: JSON.stringify({ Status: 'CANCELLED', Note: 'Hủy từ POS' })
            });
            
            if (currentOrderType !== 'TAKE_AWAY' && currentTableId) {
                updateTableUI(currentTableId, 'empty', 0);
            } else if (currentOrderType === 'TAKE_AWAY') {
                updateTakeawaySlotUI(currentTakeawaySlot, false, 0);
            }

            showToast(`🗑️ Đã hủy Order #${currentOrderId}`, 'warn');
            currentCart = []; currentOrderId = null;
            renderCart();
            closeOrder();
        } catch(e) {
            showToast('❌ ' + e.message, 'error');
        } finally {
            btn.disabled = false; btn.innerText = '🗑️ HỦY ĐƠN';
        }
    }

    // ════════════════════════════════════════════════════════
    //  AUTO-REFRESH SƠ ĐỒ BÀN (mỗi 30s)
    // ════════════════════════════════════════════════════════
    async function refreshTableStatuses() {
        try {
            const tables = await apiFetch(`/api/tables?branchId=${BRANCH_ID}`);
            if (!tables) return;
            tables.forEach(t => {
                const el = document.getElementById(`table-${t.id}`);
                if (!el) return;
                const st = t.status.toLowerCase();
                el.className = `tc ${st}`;
                // Giữ trạng thái hiển thị theo filter khu vực hiện tại
                const nameEl = el.querySelector('.tc-name');
                const name = nameEl ? nameEl.innerText : '';
                if (!tableMatchesArea(name, currentAreaFilter)) el.style.display = 'none';
                const statusEl = el.querySelector('.tc-status');
                if (statusEl) statusEl.innerText = st === 'occupied' ? 'Có khách' : st === 'cleaning' ? 'Đang dọn' : 'Trống';
            });
            await loadActiveOrdersState();
            updateAreaSummary();
        } catch { /* silent */ }
    }

    // ════════════════════════════════════════════════════════
    //  KHỞI CHẠY
    // ════════════════════════════════════════════════════════
    document.addEventListener('DOMContentLoaded', () => {
        init();
        // Auto-refresh sơ đồ bàn mỗi 30 giây
        setInterval(refreshTableStatuses, 30000);
    });
</script>
}