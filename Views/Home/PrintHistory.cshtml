@{
    Layout = "_Layout";
    ViewBag.Title = "Lịch sử in tem";
}

@section Styles {
<style>
/* ── PRINT MEDIA: Only print #labelPrintArea ─────────────────────── */
@@media print {
    body > * { display: none !important; }
    #labelPrintArea {
        display: flex !important;
        flex-direction: column !important;
        gap: 15px !important;
        background: white !important;
        padding: 0 !important;
        margin: 0 !important;
    }
    #labelPrintArea .label-card {
        page-break-inside: avoid !important;
        border: 2px dashed #8B5A2B !important;
        box-shadow: none !important;
        background: white !important;
        color: black !important;
        display: flex !important;
        width: 300px !important;
        min-height: 140px !important;
    }
}

/* ── DASHBOARD UI STYLING ────────────────────────────────────────── */
.history-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 10px 0;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}

.stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s, box-shadow 0.2s;
}
.stat-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
}
.stat-icon {
    font-size: 28px;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--surface2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brown);
    border: 1px solid var(--border);
}
.stat-info {
    flex: 1;
}
.stat-value {
    font-size: 24px;
    font-weight: 800;
    color: var(--brown-dark);
}
.stat-label {
    font-size: 12px;
    color: var(--text3);
    margin-top: 2px;
    font-weight: 600;
}

/* Controls */
.controls-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 16px 20px;
    margin-bottom: 20px;
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    box-shadow: var(--shadow-sm);
}

.search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 8px 16px;
    flex: 1;
    max-width: 400px;
    transition: var(--t);
}
.search-box:focus-within {
    border-color: var(--brown-light);
    box-shadow: 0 0 0 3px rgba(196, 149, 106, 0.15);
}
.search-box input {
    background: transparent;
    border: none;
    outline: none;
    width: 100%;
    color: var(--text);
    font-size: 13.5px;
}

/* History list */
.history-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.history-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: var(--t);
}
.history-item:hover {
    box-shadow: var(--shadow);
    transform: translateX(4px);
}

.item-header {
    background: var(--surface2);
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 12px;
}

.header-right {
    display: flex;
    align-items: center;
    gap: 12px;
}

.order-badge {
    font-size: 11px;
    font-weight: 800;
    color: var(--brown-mid);
    background: var(--surface3);
    border-radius: 6px;
    padding: 3px 8px;
    letter-spacing: .5px;
}

.print-time {
    font-size: 12px;
    color: var(--text3);
    font-weight: 500;
}

.item-body {
    padding: 16px 20px;
}

.item-products {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.product-pill {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.product-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    color: var(--brown-dark);
}

.product-qty {
    background: var(--brown);
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 20px;
}

.product-note {
    font-size: 11.5px;
    color: var(--red);
    font-weight: 600;
    background: rgba(231,76,60,.06);
    border-left: 2.5px solid var(--red);
    padding: 2px 6px;
    border-radius: 3px;
    margin-top: 2px;
}

.product-no-note {
    font-size: 11px;
    color: var(--text3);
    font-style: italic;
}

/* Empty state */
.empty-history {
    background: var(--surface);
    border: 1px dashed var(--border2);
    border-radius: var(--r-xl);
    padding: 60px 20px;
    text-align: center;
    color: var(--text3);
    box-shadow: var(--shadow-sm);
}
.empty-icon {
    font-size: 56px;
    margin-bottom: 16px;
}
.empty-title {
    font-size: 18px;
    font-weight: 800;
    color: var(--brown-dark);
    margin-bottom: 6px;
}
.empty-text {
    font-size: 13.5px;
    max-width: 400px;
    margin: 0 auto;
}

/* Floating Label print area stylesheet inclusion */
#labelPrintArea {
    display: none;
}
</style>
}

<div class="history-container">
    <!-- Header -->
    <div class="page-header" style="margin-bottom: 24px;">
        <div>
            <div class="page-title">🏷️ Lịch sử In Tem</div>
            <div class="page-subtitle">Xem danh sách các tem nhãn đã in và in lại nhanh chóng</div>
        </div>
        <button class="btn btn-outline" onclick="refreshHistoryList()" title="Tải lại">🔄 Làm mới</button>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon">📋</div>
            <div class="stat-info">
                <div class="stat-value" id="statTotalOrders">0</div>
                <div class="stat-label">Đơn đã in</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🏷️</div>
            <div class="stat-info">
                <div class="stat-value" id="statTotalLabels">0</div>
                <div class="stat-label">Tổng số cốc / tem in</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon">⏱️</div>
            <div class="stat-info">
                <div class="stat-value" id="statLastPrint" style="font-size: 16px; font-weight: 700; height: 36px; display: flex; align-items: center;">—</div>
                <div class="stat-label">Lần in cuối cùng</div>
            </div>
        </div>
    </div>

    <!-- Controls -->
    <div class="controls-card">
        <div class="search-box">
            <span>🔍</span>
            <input type="text" id="searchInput" placeholder="Tìm kiếm theo mã đơn, tên bàn..." oninput="filterHistory()">
        </div>
        <button class="btn btn-outline" style="color: var(--red); border-color: rgba(231,76,60,.25);" onclick="clearAllHistory()">
            🗑️ Xóa toàn bộ lịch sử
        </button>
    </div>

    <!-- List -->
    <div id="historyListContainer" class="history-list">
        <!-- Dynmic content -->
    </div>
</div>

<!-- Hidden Print Area for window.print() -->
<div id="labelPrintArea"></div>

@section Scripts {
<script>
    // Tên key dùng chung với POS Index.cshtml
    const PRINT_HISTORY_KEY = 'cafe_print_history';

    function getPrintHistory() {
        try {
            return JSON.parse(localStorage.getItem(PRINT_HISTORY_KEY) || '[]');
        } catch (e) {
            console.warn('Lỗi đọc lịch sử:', e);
            return [];
        }
    }

    function savePrintHistoryList(list) {
        try {
            localStorage.setItem(PRINT_HISTORY_KEY, JSON.stringify(list));
        } catch (e) {
            console.error('Lỗi ghi lịch sử:', e);
        }
    }

    let currentHistory = [];

    // Tải và hiển thị danh sách
    function refreshHistoryList() {
        currentHistory = getPrintHistory();
        updateStats();
        renderHistoryList(currentHistory);
    }

    // Cập nhật thống kê
    function updateStats() {
        const totalOrders = currentHistory.length;
        let totalLabels = 0;
        currentHistory.forEach(item => {
            totalLabels += (item.totalLabels || 0);
        });

        document.getElementById('statTotalOrders').textContent = totalOrders;
        document.getElementById('statTotalLabels').textContent = totalLabels;
        
        if (currentHistory.length > 0) {
            document.getElementById('statLastPrint').textContent = currentHistory[0].dtStr || 'Vừa xong';
        } else {
            document.getElementById('statLastPrint').textContent = 'Chưa có';
        }
    }

    // Render danh sách
    function renderHistoryList(list) {
        const container = document.getElementById('historyListContainer');
        if (!list || list.length === 0) {
            container.innerHTML = `
                <div class="empty-history">
                    <div class="empty-icon">🏷️</div>
                    <div class="empty-title">Lịch sử in trống</div>
                    <div class="empty-text">Khi nhân viên thực hiện lưu đơn, các tem nhãn in gọi đồ sẽ được lưu tự động và hiển thị tại đây để tiện theo dõi.</div>
                </div>
            `;
            return;
        }

        container.innerHTML = list.map((record, index) => {
            const isTakeaway = record.tableName.toLowerCase().includes('mang về') || record.tableName.toLowerCase().includes('mv') || record.tableName.startsWith('MV');
            const tableBadge = isTakeaway
                ? `<span class="label-takeaway-badge">🛍️ ${record.tableName}</span>`
                : `<span class="label-table-badge">🧩 ${record.tableName}</span>`;

            let globalIndex = 1;
            let labelsHtml = '';
            
            // Tách ngày và giờ từ dtStr
            const dateTimeParts = record.dtStr.split(' — ');
            const dateStr = dateTimeParts[0] || '';
            const timeStr = dateTimeParts[1] || '';

            record.items.forEach(item => {
                const qty = item.qty || 1;
                for (let i = 1; i <= qty; i++) {
                    const isMulti = qty > 1;
                    const cupBadge = isMulti ? `<span class="label-cup-badge">${i}/${qty}</span>` : '';
                    const noteHtml = item.note 
                        ? `<div class="label-note">⚠️ ${item.note}</div>`
                        : `<div class="label-note no-note">— Không có yêu cầu</div>`;
                    const isTakeaway = record.tableName.toLowerCase().includes('mang về') || record.tableName.toLowerCase().includes('mv') || record.tableName.startsWith('MV');
                    const tableDisplay = isTakeaway
                        ? `<span class="label-takeaway-badge">🛍️ ${record.tableName}</span>`
                        : `<span class="label-table-badge">🧩 ${record.tableName}</span>`;
                    
                    labelsHtml += `
                        <div class="label-card" style="box-shadow: var(--shadow-sm); cursor: default; transform: none; transition: none; width: 190px; min-height: 125px; flex-shrink: 0; font-family: inherit;">
                            <div class="label-top">
                                <div class="label-seq">#${String(globalIndex).padStart(2,'0')}</div>
                                ${tableDisplay}
                                ${cupBadge}
                            </div>
                            <div class="label-item-name" style="font-size: 13.5px; font-weight: 800;">${item.name}</div>
                            <div class="label-waiter" style="font-size: 11px; font-weight: 700; color: #333; margin-top: 4px; margin-bottom: 4px;">
                                 👤 NV Order: <span style="text-decoration: underline;">${record.employeeName || window.FULL_NAME || 'Quản trị viên'}</span>
                            </div>
                            ${noteHtml}
                            <div class="label-footer" style="font-size: 9px; display: flex; flex-direction: column; gap: 2px; align-items: flex-start;">
                                <span>Order #${record.orderId}</span>
                                <span style="color: var(--text3);">📅 ${dateStr} &bull; ⏱️ ${timeStr}</span>
                            </div>
                        </div>
                    `;
                    globalIndex++;
                }
            });

            // JSON String of record to pass in reprint function
            const recordJson = encodeURIComponent(JSON.stringify(record));

            return `
                <div class="history-item" data-index="${index}" data-table="${record.tableName.toLowerCase()}" data-order="${record.orderId}">
                    <div class="item-header">
                        <div class="header-left">
                            <span class="order-badge">ĐƠN #${record.orderId}</span>
                            ${tableBadge}
                            <span style="font-size:12px;color:var(--text3);font-weight:600;">(${record.totalLabels} tem)</span>
                        </div>
                        <div class="header-right">
                            <span class="print-time">📅 ${record.dtStr}</span>
                            <button class="btn btn-primary btn-sm" onclick="reprintRecord('${recordJson}')" style="padding:6px 12px; font-size:12px;">
                                🖨️ In lại tem
                            </button>
                        </div>
                    </div>
                    <div class="item-body">
                        <div class="item-products">
                            ${labelsHtml}
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    // Bộ lọc lịch sử
    function filterHistory() {
        const query = document.getElementById('searchInput').value.trim().toLowerCase();
        if (!query) {
            renderHistoryList(currentHistory);
            return;
        }

        const filtered = currentHistory.filter(record => {
            const tableMatch = record.tableName.toLowerCase().includes(query);
            const orderMatch = record.orderId.toString().includes(query);
            const itemMatch = record.items.some(i => i.name.toLowerCase().includes(query));
            return tableMatch || orderMatch || itemMatch;
        });

        renderHistoryList(filtered);
    }

    // In lại một bản ghi cụ thể
    window.reprintRecord = function(encodedRecord) {
        try {
            const record = JSON.parse(decodeURIComponent(encodedRecord));
            const printArea = document.getElementById('labelPrintArea');
            printArea.innerHTML = '';
            
            let globalIndex = 1;
            const now = new Date();
            const dateStr = now.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' });
            const timeStr = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

            // Tính tổng số cốc thực tế để in đúng cup badge
            const totalCups = record.totalLabels;

            record.items.forEach(item => {
                const qty = item.qty || 1;
                for (let i = 1; i <= qty; i++) {
                    const isMulti = qty > 1;
                    const cupBadge = isMulti ? `<span class="label-cup-badge">${i}/${qty}</span>` : '';
                    const noteHtml = item.note
                        ? `<div class="label-note">⚠️ ${item.note}</div>`
                        : `<div class="label-note no-note">— Không có yêu cầu đặc biệt</div>`;
                    const isTakeaway = record.tableName.toLowerCase().includes('mang về') || record.tableName.toLowerCase().includes('mv') || record.tableName.startsWith('MV');
                    const tableDisplay = isTakeaway
                        ? `<span class="label-takeaway-badge">🛍️ ${record.tableName}</span>`
                        : `<span class="label-table-badge">🧩 ${record.tableName}</span>`;
                    
                    const cardHtml = `
                    <div class="label-card">
                        <div class="label-top">
                            <div class="label-seq">#${String(globalIndex).padStart(2,'0')}</div>
                            ${tableDisplay}
                            ${cupBadge}
                        </div>
                        <div class="label-item-name">${item.name}</div>
                        <div class="label-waiter" style="font-size: 11px; font-weight: 700; color: #000; margin-top: 4px; margin-bottom: 4px;">
                            👤 NV Order: <span style="text-decoration: underline;">${record.employeeName || window.FULL_NAME || 'Quản trị viên'}</span>
                        </div>
                        ${noteHtml}
                        <div class="label-footer">
                            <span>Order #${record.orderId}</span>
                            <span>📅 ${dateStr} &bull; ⏱️ ${timeStr}</span>
                        </div>
                    </div>
                    `;
                    printArea.innerHTML += cardHtml;
                    globalIndex++;
                }
            });
            
            // Kích hoạt lệnh in
            setTimeout(() => {
                window.print();
                showToast(`🖨️ Đang in lại ${totalCups} tem đơn hàng #${record.orderId}!`);
            }, 100);
        } catch (e) {
            console.error('Lỗi in lại:', e);
            showToast('❌ Không thể in lại tem này!', 'error');
        }
    };

    // Xóa toàn bộ lịch sử in
    window.clearAllHistory = function() {
        if (!confirm('Bạn có chắc chắn muốn xóa toàn bộ lịch sử in tem không?\nHành động này không thể hoàn tác.')) {
            return;
        }

        savePrintHistoryList([]);
        showToast('🗑️ Đã xóa sạch lịch sử in tem thành công!');
        refreshHistoryList();
    };

    // Khởi động
    document.addEventListener('DOMContentLoaded', () => {
        refreshHistoryList();
    });
</script>
}
