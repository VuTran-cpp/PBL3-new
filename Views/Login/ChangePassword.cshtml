@{
    Layout = null;
    ViewData["Title"] = "Đổi mật khẩu - ABC Coffee POS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;600;700;800&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            min-height: 100vh;
            font-family: 'Be Vietnam Pro', sans-serif;
            background: linear-gradient(135deg, #3D1F0D 0%, #6B3A1F 50%, #8B5230 100%);
            display: flex; align-items: center; justify-content: center;
            position: relative; overflow: hidden;
        }

        /* Decorative background elements */
        body::before {
            content: '';
            position: absolute;
            width: 400px; height: 400px;
            background: radial-gradient(circle, rgba(139,82,48,0.3) 0%, transparent 70%);
            top: -100px; right: -100px;
            border-radius: 50%;
            animation: pulse 6s ease-in-out infinite;
        }
        body::after {
            content: '';
            position: absolute;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(61,31,13,0.2) 0%, transparent 70%);
            bottom: -80px; left: -80px;
            border-radius: 50%;
            animation: pulse 8s ease-in-out infinite reverse;
        }

        .change-pwd-card {
            background: #fff;
            border-radius: 24px;
            padding: 50px 45px;
            width: 460px;
            box-shadow: 0 30px 80px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,255,255,0.05);
            position: relative; z-index: 1;
            animation: slideUp 0.5s ease-out;
        }

        .card-logo {
            text-align: center;
            margin-bottom: 28px;
        }
        .card-logo .icon {
            width: 64px; height: 64px;
            background: linear-gradient(135deg, #3D1F0D, #8B5230);
            border-radius: 16px;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 28px; margin-bottom: 12px;
            box-shadow: 0 8px 24px rgba(61,31,13,0.3);
        }
        .card-logo h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 22px; color: #3D1F0D;
        }
        .card-logo p { color: #A0856A; font-size: 13px; margin-top: 4px; }

        /* Form */
        .form-group { margin-bottom: 18px; }
        .form-group label {
            display: block; font-size: 13px; font-weight: 600;
            color: #3D1F0D; margin-bottom: 8px;
        }
        .form-group label span { color: #DC2626; }
        .input-wrap {
            position: relative;
        }
        .form-group input {
            width: 100%; padding: 13px 42px 13px 16px;
            border: 1.5px solid #E2D5C3; border-radius: 10px;
            font-size: 15px; font-family: inherit;
            outline: none; transition: all 0.25s;
            background: #FDF8F2;
        }
        .form-group input:focus {
            border-color: #8B5230;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(139,82,48,0.1);
        }
        .toggle-pwd {
            position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
            background: none; border: none; cursor: pointer;
            font-size: 16px; color: #A0856A; transition: color 0.2s;
            padding: 4px;
        }
        .toggle-pwd:hover { color: #3D1F0D; }

        /* Password strength */
        .strength-wrap { margin-top: 8px; }
        .strength-bar-bg {
            background: #F0E6D9; border-radius: 20px; height: 5px; overflow: hidden;
        }
        .strength-bar {
            height: 5px; border-radius: 20px; width: 0%;
            transition: width 0.3s, background 0.3s;
        }
        .strength-label {
            font-size: 11px; color: #A0856A; margin-top: 4px;
        }

        /* Buttons */
        .btn-change {
            width: 100%; padding: 15px;
            background: linear-gradient(135deg, #3D1F0D, #8B5230);
            color: white; border: none; border-radius: 10px;
            font-size: 16px; font-weight: 700; cursor: pointer;
            font-family: inherit; transition: all 0.25s; margin-top: 8px;
            position: relative; overflow: hidden;
        }
        .btn-change:hover { filter: brightness(1.15); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(61,31,13,0.3); }
        .btn-change:active { transform: translateY(0); }
        .btn-change:disabled { opacity: 0.7; cursor: not-allowed; transform: none; filter: none; }

        .back-link {
            display: flex; align-items: center; justify-content: center;
            gap: 6px; margin-top: 20px; padding-top: 18px;
            border-top: 1px solid #E2D5C3;
            text-align: center;
        }
        .back-link a {
            color: #8B5230; font-size: 13px; text-decoration: none;
            font-weight: 600; transition: all 0.2s;
            display: inline-flex; align-items: center; gap: 6px;
        }
        .back-link a:hover { color: #3D1F0D; transform: translateY(-1px); }

        /* Toast notification */
        .toast {
            position: fixed; top: 24px; right: 24px; z-index: 9999;
            padding: 14px 20px; border-radius: 12px;
            font-size: 14px; font-weight: 600;
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
            transform: translateX(120%); transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            max-width: 380px;
        }
        .toast.show { transform: translateX(0); }
        .toast-success { background: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0; }
        .toast-error { background: #FEF2F2; color: #991B1B; border: 1px solid #FCA5A5; }
        .toast-warn { background: #FFFBEB; color: #92400E; border: 1px solid #FCD34D; }

        /* Spinner */
        .spinner {
            display: inline-block; width: 16px; height: 16px;
            border: 2px solid rgba(255,255,255,0.4);
            border-top-color: white; border-radius: 50%;
            animation: spin 0.7s linear infinite;
        }

        @@keyframes spin { to { transform: rotate(360deg); } }
        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.1); opacity: 0.8; }
        }
    </style>
</head>
<body>
    <div class="change-pwd-card">
        <div class="card-logo">
            <div class="icon">🔐</div>
            <h1>ĐỔI MẬT KHẨU</h1>
            <p>Nhập thông tin tài khoản để thay đổi mật khẩu</p>
        </div>

        <form id="changePwdForm" onsubmit="return handleSubmit(event)">
            <div class="form-group">
                <label>Tên đăng nhập <span>*</span></label>
                <div class="input-wrap">
                    <input type="text" id="username" placeholder="Nhập tên đăng nhập..." autocomplete="username" required />
                </div>
            </div>

            <div class="form-group">
                <label>Mật khẩu hiện tại <span>*</span></label>
                <div class="input-wrap">
                    <input type="password" id="oldPassword" placeholder="Nhập mật khẩu hiện tại..." autocomplete="current-password" required />
                    <button type="button" class="toggle-pwd" onclick="togglePwd('oldPassword', this)">👁</button>
                </div>
            </div>

            <div class="form-group">
                <label>Mật khẩu mới <span>*</span></label>
                <div class="input-wrap">
                    <input type="password" id="newPassword" placeholder="Tối thiểu 6 ký tự..." autocomplete="new-password" required oninput="checkStrength(this.value)" />
                    <button type="button" class="toggle-pwd" onclick="togglePwd('newPassword', this)">👁</button>
                </div>
                <div class="strength-wrap">
                    <div class="strength-bar-bg">
                        <div class="strength-bar" id="strengthBar"></div>
                    </div>
                    <div class="strength-label" id="strengthLabel"></div>
                </div>
            </div>

            <div class="form-group">
                <label>Xác nhận mật khẩu mới <span>*</span></label>
                <div class="input-wrap">
                    <input type="password" id="confirmPassword" placeholder="Nhập lại mật khẩu mới..." autocomplete="new-password" required />
                    <button type="button" class="toggle-pwd" onclick="togglePwd('confirmPassword', this)">👁</button>
                </div>
            </div>

            <button type="submit" class="btn-change" id="btnSubmit">
                <span class="btn-text">🔑 Đổi mật khẩu</span>
                <span class="btn-loading" style="display:none;">
                    <span class="spinner"></span>
                    Đang xử lý...
                </span>
            </button>
        </form>

        <div class="back-link">
            <a href="/Login">
                ← Quay lại trang đăng nhập
            </a>
        </div>
    </div>

    <!-- Toast container -->
    <div id="toast" class="toast"></div>

    <script>
        function togglePwd(id, btn) {
            const inp = document.getElementById(id);
            const show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            btn.textContent = show ? '🙈' : '👁';
        }

        function checkStrength(val) {
            const bar   = document.getElementById('strengthBar');
            const label = document.getElementById('strengthLabel');
            let score = 0;
            if (val.length >= 6)  score++;
            if (val.length >= 10) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const levels = [
                { pct:'20%', color:'#DC2626', label:'Rất yếu' },
                { pct:'40%', color:'#DC2626', label:'Yếu' },
                { pct:'60%', color:'#D97706', label:'Trung bình' },
                { pct:'80%', color:'#2563EB', label:'Mạnh' },
                { pct:'100%',color:'#059669', label:'Rất mạnh 💪' },
            ];
            const lv = levels[Math.min(score, 4)];
            bar.style.width      = val ? lv.pct   : '0%';
            bar.style.background = val ? lv.color  : '';
            label.textContent    = val ? lv.label  : '';
            label.style.color    = lv.color;
        }

        function showToast(msg, type = 'success', duration = 4000) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.className = `toast toast-${type} show`;
            setTimeout(() => t.classList.remove('show'), duration);
        }

        async function handleSubmit(e) {
            e.preventDefault();

            const username   = document.getElementById('username').value.trim();
            const oldPwd     = document.getElementById('oldPassword').value;
            const newPwd     = document.getElementById('newPassword').value;
            const confirmPwd = document.getElementById('confirmPassword').value;

            if (!username) { showToast('⚠️ Vui lòng nhập tên đăng nhập!', 'warn'); return false; }
            if (!oldPwd)   { showToast('⚠️ Vui lòng nhập mật khẩu hiện tại!', 'warn'); return false; }
            if (!newPwd)   { showToast('⚠️ Vui lòng nhập mật khẩu mới!', 'warn'); return false; }
            if (newPwd.length < 6) { showToast('⚠️ Mật khẩu mới tối thiểu 6 ký tự!', 'warn'); return false; }
            if (newPwd !== confirmPwd) { showToast('⚠️ Mật khẩu xác nhận không khớp!', 'warn'); return false; }
            if (oldPwd === newPwd) { showToast('⚠️ Mật khẩu mới phải khác mật khẩu hiện tại!', 'warn'); return false; }

            const btn = document.getElementById('btnSubmit');
            btn.disabled = true;
            btn.querySelector('.btn-text').style.display = 'none';
            btn.querySelector('.btn-loading').style.display = 'inline-flex';
            btn.querySelector('.btn-loading').style.gap = '8px';
            btn.querySelector('.btn-loading').style.alignItems = 'center';

            try {
                const resp = await fetch('/api/auth/change-password-by-username', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        Username: username,
                        OldPassword: oldPwd,
                        NewPassword: newPwd
                    })
                });

                const data = await resp.json();

                if (resp.ok && data.success) {
                    showToast('✅ Đổi mật khẩu thành công! Đang chuyển về trang đăng nhập...', 'success', 5000);
                    document.getElementById('changePwdForm').reset();
                    checkStrength('');
                    setTimeout(() => window.location.href = '/Login', 3000);
                } else {
                    showToast('❌ ' + (data.message || 'Đổi mật khẩu thất bại'), 'error');
                }
            } catch (err) {
                showToast('❌ Lỗi kết nối server: ' + err.message, 'error');
            } finally {
                btn.disabled = false;
                btn.querySelector('.btn-text').style.display = '';
                btn.querySelector('.btn-loading').style.display = 'none';
            }

            return false;
        }

        // Auto-focus username on load
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('username').focus();
        });
    </script>
</body>
</html>
