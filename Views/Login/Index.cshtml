@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập - ABC Coffee POS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;600;700;800&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            min-height: 100vh;
            font-family: 'Be Vietnam Pro', sans-serif;
            background: linear-gradient(135deg, #3D1F0D 0%, #6B3A1F 50%, #8B5230 100%);
            display: flex; align-items: center; justify-content: center;
        }
        .login-card {
            background: #fff;
            border-radius: 24px;
            padding: 50px 45px;
            width: 440px;
            box-shadow: 0 30px 80px rgba(0,0,0,0.3);
            transition: all 0.3s ease;
        }
        .login-logo {
            text-align: center;
            margin-bottom: 30px;
        }
        .login-logo .icon {
            width: 70px; height: 70px;
            background: linear-gradient(135deg, #3D1F0D, #8B5230);
            border-radius: 18px;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 32px; margin-bottom: 14px;
        }
        .login-logo h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 26px; color: #3D1F0D;
        }
        .login-logo p { color: #A0856A; font-size: 13px; margin-top: 4px; }

        /* Role Selection */
        .role-selection {
            display: flex; gap: 14px; margin-bottom: 28px;
        }
        .role-btn {
            flex: 1; padding: 20px 16px; border: 2px solid #E2D5C3;
            border-radius: 16px; background: #FDF8F2; cursor: pointer;
            text-align: center; transition: all 0.25s ease;
            position: relative; overflow: hidden;
        }
        .role-btn:hover {
            border-color: #C4956A; background: #F7F0E5;
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(61,31,13,0.1);
        }
        .role-btn.active {
            border-color: #3D1F0D; background: #3D1F0D; color: #fff;
            box-shadow: 0 6px 24px rgba(61,31,13,0.3);
            transform: translateY(-2px);
        }
        .role-btn .role-icon {
            font-size: 36px; display: block; margin-bottom: 10px;
        }
        .role-btn .role-title {
            font-size: 15px; font-weight: 700;
            display: block; margin-bottom: 4px;
        }
        .role-btn .role-desc {
            font-size: 11px; opacity: 0.65;
            display: block; line-height: 1.4;
        }
        .role-btn.active .role-desc { opacity: 0.8; }
        .role-btn .role-check {
            position: absolute; top: 10px; right: 10px;
            width: 22px; height: 22px; border-radius: 50%;
            background: #27AE60; color: #fff; font-size: 12px;
            display: none; align-items: center; justify-content: center;
            font-weight: 700;
        }
        .role-btn.active .role-check { display: flex; }

        /* Form */
        .login-form { display: none; } /* hidden until role selected */
        .login-form.show { display: block; animation: fadeIn 0.3s ease; }

        .form-group { margin-bottom: 20px; }
        .form-group label {
            display: block; font-size: 13px; font-weight: 600;
            color: #3D1F0D; margin-bottom: 8px;
        }
        .form-group input {
            width: 100%; padding: 13px 16px;
            border: 1.5px solid #E2D5C3; border-radius: 10px;
            font-size: 15px; font-family: inherit;
            outline: none; transition: 0.2s;
            background: #FDF8F2;
        }
        .form-group input:focus {
            border-color: #8B5230;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(139,82,48,0.1);
        }
        .btn-login {
            width: 100%; padding: 15px;
            background: linear-gradient(135deg, #3D1F0D, #8B5230);
            color: white; border: none; border-radius: 10px;
            font-size: 16px; font-weight: 700; cursor: pointer;
            font-family: inherit; transition: 0.2s; margin-top: 8px;
        }
        .btn-login:hover { filter: brightness(1.15); transform: translateY(-1px); }
        .btn-login:active { transform: translateY(0); }
        .btn-login:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }
        .error-box {
            background: #FEF2F2; border: 1px solid #FCA5A5;
            border-radius: 8px; padding: 12px 16px;
            color: #DC2626; font-size: 13px; margin-bottom: 20px;
            display: flex; align-items: center; gap: 8px;
        }
        .loading { display: none; }
        .spinner {
            display: inline-block; width: 16px; height: 16px;
            border: 2px solid rgba(255,255,255,0.4);
            border-top-color: white; border-radius: 50%;
            animation: spin 0.7s linear infinite;
        }
        .role-hint {
            text-align: center; font-size: 12px; color: #A0856A;
            margin-bottom: 18px; padding: 8px 12px;
            background: #FDF8F2; border-radius: 8px;
            border: 1px solid #E2D5C3;
        }
        .role-hint strong { color: #3D1F0D; }
        @@keyframes spin { to { transform: rotate(360deg); } }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-logo">
            <div class="icon">☕</div>
            <h1>ABC COFFEE</h1>
            <p>Hệ thống quản lý điểm bán hàng</p>
        </div>

        <!-- Step 1: Choose Role -->
        <div style="text-align:center;margin-bottom:16px;">
            <span style="font-size:13px;font-weight:600;color:#6B3A1F;">Chọn vai trò đăng nhập</span>
        </div>
        <div class="role-selection" id="roleSelection">
            <div class="role-btn" data-role="STAFF" onclick="selectRole('STAFF')">
                <span class="role-check">✓</span>
                <span class="role-icon">👨‍💼</span>
                <span class="role-title">Nhân viên</span>
                <span class="role-desc">POS, Đơn hàng, Thực đơn, Quản lý bàn</span>
            </div>
            <div class="role-btn" data-role="MANAGER" onclick="selectRole('MANAGER')">
                <span class="role-check">✓</span>
                <span class="role-icon">👔</span>
                <span class="role-title">Quản lý</span>
                <span class="role-desc">Dashboard, Ca, Khuyến mãi, Nhân viên, NCC</span>
            </div>
        </div>

        <!-- Step 2: Login Form (hidden until role selected) -->
        <div class="login-form" id="loginForm">
            <div class="role-hint" id="roleHint"></div>

            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="error-box">
                    <span>⚠️</span>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form method="post" action="/Login" id="theForm">
                <input type="hidden" name="role" id="selectedRole" value="" />
                @if (ViewBag.ReturnUrl != null) {
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                }
                <div class="form-group">
                    <label for="username">Tên đăng nhập</label>
                    <input type="text" id="username" name="username"
                           placeholder="Nhập tên đăng nhập..."
                           autocomplete="username" required />
                </div>
                <div class="form-group">
                    <label for="password">Mật khẩu</label>
                    <input type="password" id="password" name="password"
                           placeholder="Nhập mật khẩu..."
                           autocomplete="current-password" required />
                </div>
                <button type="submit" class="btn-login" id="btnLogin">
                    <span class="btn-text">🔑 Đăng nhập</span>
                    <span class="loading">
                        <span class="spinner"></span>
                        Đang xử lý...
                    </span>
                </button>
            </form>
        </div>
    </div>

    <script>
        let chosenRole = '';

        function selectRole(role) {
            chosenRole = role;
            document.getElementById('selectedRole').value = role;

            // Toggle active
            document.querySelectorAll('.role-btn').forEach(b => b.classList.remove('active'));
            document.querySelector(`.role-btn[data-role="${role}"]`).classList.add('active');

            // Show form
            document.getElementById('loginForm').classList.add('show');

            // Update hint
            const hints = {
                'STAFF': '👨‍💼 Đăng nhập với vai trò <strong>Nhân viên</strong>',
                'MANAGER': '👔 Đăng nhập với vai trò <strong>Quản lý</strong>'
            };
            document.getElementById('roleHint').innerHTML = hints[role];

            // Focus username
            setTimeout(() => document.getElementById('username').focus(), 200);
        }

        // Form submission
        document.getElementById('theForm').addEventListener('submit', function (e) {
            if (!chosenRole) {
                e.preventDefault();
                alert('Vui lòng chọn vai trò trước khi đăng nhập!');
                return;
            }
            const btn = document.getElementById('btnLogin');
            btn.disabled = true;
            btn.querySelector('.btn-text').style.display = 'none';
            btn.querySelector('.loading').style.display = 'inline-flex';
            btn.querySelector('.loading').style.gap = '8px';
            btn.querySelector('.loading').style.alignItems = 'center';
        });

        // If there's an error, auto-show the form
        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <text>
            const errorRole = '@(ViewBag.SelectedRole ?? "STAFF")';
            selectRole(errorRole);
            </text>
        }
    </script>
</body>
</html>
