@{
    Layout = "_Layout";
    ViewBag.ActivePage = "Inventory";
    ViewBag.PageTitle = "Quản lý Kho hàng";
    ViewBag.Title = "Kho hàng";
}

<div class="page-header">
    <div>
        <div class="page-title">📦 Kho hàng</div>
        <div class="page-subtitle">Tồn kho nguyên liệu theo chi nhánh</div>
    </div>
    <button class="btn btn-primary" id="btnImport" onclick="openImportModal()" style="display:none;">📥 Nhập kho mới</button>
</div>

<!-- Alert low stock -->
<div id="lowStockAlert" style="display:none;" class="card" style="border-left:4px solid var(--red);margin-bottom:16px;">
    <div style="padding:14px 20px;display:flex;align-items:center;gap:12px;background:rgba(231,76,60,.05);border-left:4px solid var(--red);border-radius:var(--r-lg);">
        <span style="font-size:24px;">⚠️</span>
        <div>
            <div style="font-weight:700;color:var(--red);">Cảnh báo tồn kho thấp</div>
            <div id="lowStockMsg" style="font-size:13px;color:var(--text2);"></div>
        </div>
    </div>
</div>

<!-- Filter -->
<div class="filters-bar" style="margin-bottom:16px;">
    <div class="search-wrap" style="flex:1;min-width:200px;">
        <span>🔍</span>
        <input type="text" id="searchStock" placeholder="Tìm nguyên liệu..." oninput="filterStock()">
    </div>
    <label style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;cursor:pointer;">
        <input type="checkbox" id="showLowOnly" onchange="filterStock()" style="width:16px;height:16px;">
        Chỉ hiện sắp hết
    </label>
</div>

<!-- Stock Table -->
<div class="card">
    <div class="card-header">
        <div class="card-title">Tồn kho hiện tại</div>
        <div id="stockCount" style="font-size:13px;color:var(--text3);"></div>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nguyên liệu</th>
                    <th>Đơn vị</th>
                    <th style="text-align:right;">Tồn kho</th>
                    <th style="text-align:right;">Ngưỡng tối thiểu</th>
                    <th style="text-align:right;">Đơn giá nhập</th>
                    <th style="text-align:center;">Trạng thái</th>
                    <th style="text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody id="stockTableBody">
                <tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text3);">⏳ Đang tải...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Import History -->
<div class="card" style="margin-top:20px;">
    <div class="card-header">
        <div class="card-title">📜 Lịch sử nhập kho</div>
        <button class="btn btn-outline btn-sm" onclick="loadImportHistory()">🔄 Làm mới</button>
    </div>
    <div class="table-wrap" style="max-height:280px;overflow-y:auto;">
        <table>
            <thead>
                <tr><th>Phiếu #</th><th>Thời gian</th><th>Nhà CC</th><th>Nhân viên</th><th style="text-align:right;">Tổng giá trị</th><th>Ghi chú</th></tr>
            </thead>
            <tbody id="importHistoryBody">
                <tr><td colspan="6" style="text-align:center;padding:20px;color:var(--text3);">⏳ Nhấn "Làm mới" để tải lịch sử</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Adjust Stock Modal -->
<div class="modal-overlay" id="adjustModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">⚖️ Điều chỉnh tồn kho</div>
            <button class="modal-close" onclick="closeModal('adjustModal')">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="adjustIngId">
            <div class="form-group">
                <label class="form-label">Nguyên liệu</label>
                <div id="adjustIngName" style="font-weight:700;font-size:15px;"></div>
            </div>
            <div class="form-group">
                <label class="form-label">Tồn kho hiện tại</label>
                <div id="adjustCurrentStock" style="font-weight:700;font-size:18px;color:var(--brown-dark);"></div>
            </div>
            <div class="form-group">
                <label class="form-label">Số lượng mới <span style="color:var(--red)">*</span></label>
                <input type="number" id="adjustNewQty" class="form-control" min="0" step="0.01" placeholder="Nhập số lượng mới">
            </div>
            <div class="form-group">
                <label class="form-label">Lý do</label>
                <input type="text" id="adjustNote" class="form-control" placeholder="Kiểm kho, hao hụt...">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('adjustModal')">Hủy</button>
            <button class="btn btn-primary" onclick="submitAdjust()">✅ Xác nhận</button>
        </div>
    </div>
</div>

<!-- Import Receipt Modal -->
<div class="modal-overlay" id="importModal">
    <div class="modal modal-lg">
        <div class="modal-header">
            <div class="modal-title">📥 Tạo phiếu nhập kho</div>
            <button class="modal-close" onclick="closeModal('importModal')">×</button>
        </div>
        <div class="modal-body">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="form-group">
                    <label class="form-label">Nhà cung cấp ID <span style="color:var(--red)">*</span></label>
                    <input type="number" id="supplierId" class="form-control" placeholder="1" value="1" min="1">
                </div>
                <div class="form-group">
                    <label class="form-label">Ghi chú</label>
                    <input type="text" id="importNote" class="form-control" placeholder="Ghi chú phiếu nhập...">
                </div>
            </div>

            <div style="margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;">
                <div class="card-title">Danh sách nguyên liệu nhập</div>
                <button class="btn btn-outline btn-sm" onclick="addImportRow()">＋ Thêm dòng</button>
            </div>

            <div id="importRows">
                <!-- Rows added dynamically -->
            </div>

            <div style="margin-top:12px;padding:12px;background:var(--surface2);border-radius:var(--r);text-align:right;">
                <span style="font-size:13px;color:var(--text3);">Tổng giá trị nhập: </span>
                <span id="importTotal" style="font-size:18px;font-weight:800;color:var(--red);">0đ</span>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('importModal')">Hủy</button>
            <button class="btn btn-primary" onclick="submitImport()">📥 Xác nhận nhập kho</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
let allStock = [];
let importRowCount = 0;

async function loadStock() {
    if (isManagerOrAdmin()) document.getElementById('btnImport').style.display = '';

    try {
        allStock = await apiFetch(`/api/inventory/stock/${BRANCH_ID}`);

        // Check low stock
        const lowItems = allStock.filter(i => i.isLowStock);
        if (lowItems.length > 0) {
            document.getElementById('lowStockAlert').style.display = '';
            document.getElementById('lowStockMsg').textContent =
                `${lowItems.length} nguyên liệu đang dưới mức tối thiểu: ${lowItems.slice(0,3).map(i=>i.ingredientName).join(', ')}${lowItems.length>3?'...':''}`;
        }

        document.getElementById('stockCount').textContent = `${allStock.length} nguyên liệu`;
        filterStock();
    } catch(e) {
        document.getElementById('stockTableBody').innerHTML =
            `<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--red);">❌ ${e.message}</td></tr>`;
    }
}

function filterStock() {
    const search  = document.getElementById('searchStock').value.toLowerCase();
    const lowOnly = document.getElementById('showLowOnly').checked;
    const filtered = allStock.filter(i => {
        const matchSearch = i.ingredientName.toLowerCase().includes(search);
        const matchLow    = !lowOnly || i.isLowStock;
        return matchSearch && matchLow;
    });
    renderStock(filtered);
}

function renderStock(items) {
    const body = document.getElementById('stockTableBody');
    if (!items.length) {
        body.innerHTML = `<tr><td colspan="7"><div class="empty-state"><div class="es-icon">📦</div><div class="es-title">Không có dữ liệu tồn kho</div></div></td></tr>`;
        return;
    }
    body.innerHTML = items.map(i => {
        const pct = i.minStockThreshold > 0
            ? Math.min(100, (i.currentStock / i.minStockThreshold * 100)).toFixed(0)
            : 100;
        const barColor = i.isLowStock ? 'var(--red)' : (pct < 150 ? 'var(--amber)' : 'var(--green)');
        return `<tr style="${i.isLowStock ? 'background:rgba(231,76,60,.04);' : ''}">
            <td style="font-weight:600;">${i.ingredientName}</td>
            <td style="color:var(--text3);">${i.unit}</td>
            <td style="text-align:right;font-weight:700;font-size:15px;color:${i.isLowStock?'var(--red)':'var(--text)'};">
                ${Number(i.currentStock).toLocaleString('vi-VN')}
            </td>
            <td style="text-align:right;color:var(--text3);">${Number(i.minStockThreshold).toLocaleString('vi-VN')}</td>
            <td style="text-align:right;">${formatVND(i.costPerUnit)}</td>
            <td style="text-align:center;">
                <div style="display:flex;flex-direction:column;align-items:center;gap:4px;">
                    <span class="badge ${i.isLowStock?'badge-red':'badge-green'}">${i.isLowStock?'⚠️ Thấp':'✅ Đủ'}</span>
                    <div style="width:80px;background:var(--surface2);border-radius:20px;height:4px;">
                        <div style="width:${pct}%;background:${barColor};height:4px;border-radius:20px;transition:.5s;"></div>
                    </div>
                </div>
            </td>
            <td style="text-align:center;">
                ${isManagerOrAdmin() ? `<button class="btn btn-outline btn-sm" onclick="openAdjust(${i.ingredientId},'${i.ingredientName.replace(/'/g,"\\u0027")}',${i.currentStock})">⚖️ Điều chỉnh</button>` : '—'}
            </td>
        </tr>`;
    }).join('');
}

// Import modal
function openImportModal() {
    importRowCount = 0;
    document.getElementById('importRows').innerHTML = '';
    document.getElementById('supplierId').value = '1';
    document.getElementById('importNote').value = '';
    document.getElementById('importTotal').textContent = '0đ';
    addImportRow();
    document.getElementById('importModal').classList.add('active');
}

function addImportRow() {
    importRowCount++;
    const row = document.createElement('div');
    row.id = `row-${importRowCount}`;
    row.style.cssText = 'display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:8px;margin-bottom:8px;align-items:center;';
    const opts = allStock.map(s => `<option value="${s.ingredientId}">${s.ingredientName} (${s.unit})</option>`).join('');
    row.innerHTML = `
        <select class="form-control" id="ri-name-${importRowCount}" oninput="calcImportTotal()">
            <option value="">-- Chọn nguyên liệu --</option>
            ${opts}
        </select>
        <input type="number" placeholder="Số lượng" class="form-control import-qty" id="ri-qty-${importRowCount}"
               min="0.01" step="0.01" oninput="calcImportTotal()">
        <input type="number" placeholder="Đơn giá (đ)" class="form-control import-price" id="ri-price-${importRowCount}"
               min="0" oninput="calcImportTotal()">
        <button class="btn btn-danger btn-sm" onclick="removeRow(${importRowCount})">🗑</button>
    `;
    document.getElementById('importRows').appendChild(row);
}

function removeRow(id) {
    document.getElementById(`row-${id}`)?.remove();
    calcImportTotal();
}

function calcImportTotal() {
    let total = 0;
    document.querySelectorAll('.import-qty').forEach((qtyEl, i) => {
        const priceEl = document.querySelectorAll('.import-price')[i];
        total += (parseFloat(qtyEl.value)||0) * (parseFloat(priceEl.value)||0);
    });
    document.getElementById('importTotal').textContent = formatVND(total);
}

async function submitImport() {
    const supplierId = parseInt(document.getElementById('supplierId').value);
    const note = document.getElementById('importNote').value;

    // Collect rows — expect ingredientId as numeric input in name field for demo
    const items = [];
    for (let i = 1; i <= importRowCount; i++) {
        const nameEl  = document.getElementById(`ri-name-${i}`);
        const qtyEl   = document.getElementById(`ri-qty-${i}`);
        const priceEl = document.getElementById(`ri-price-${i}`);
        if (!nameEl || !qtyEl || !priceEl) continue;
        const id  = parseInt(nameEl.value);
        const qty = parseFloat(qtyEl.value);
        const price = parseFloat(priceEl.value);
        if (!isNaN(id) && id > 0 && qty > 0 && price >= 0)
            items.push({ IngredientId: id, Quantity: qty, UnitPrice: price });
    }

    if (!items.length) { showToast('⚠️ Thêm ít nhất 1 dòng hợp lệ (nhập ID nguyên liệu)!', 'warn'); return; }

    try {
        await apiFetch('/api/inventory/import-receipts', {
            method: 'POST',
            body: JSON.stringify({
                BranchId: BRANCH_ID,
                SupplierId: supplierId,
                EmployeeId: EMPLOYEE_ID || null,
                Note: note,
                Items: items
            })
        });
        showToast('✅ Nhập kho thành công!');
        closeModal('importModal');
        loadStock();
    } catch(e) { showToast('❌ ' + e.message, 'error'); }
}

function closeModal(id) { document.getElementById(id).classList.remove('active'); }

function openAdjust(ingId, ingName, current) {
    document.getElementById('adjustIngId').value = ingId;
    document.getElementById('adjustIngName').textContent = ingName;
    document.getElementById('adjustCurrentStock').textContent = Number(current).toLocaleString('vi-VN');
    document.getElementById('adjustNewQty').value = '';
    document.getElementById('adjustNote').value = '';
    document.getElementById('adjustModal').classList.add('active');
}

async function submitAdjust() {
    const ingId = document.getElementById('adjustIngId').value;
    const newQty = parseFloat(document.getElementById('adjustNewQty').value);
    if (isNaN(newQty) || newQty < 0) { showToast('⚠️ Nhập số lượng hợp lệ!', 'warn'); return; }
    try {
        await apiFetch(`/api/inventory/adjust`, {
            method: 'POST',
            body: JSON.stringify({
                BranchId: BRANCH_ID, IngredientId: parseInt(ingId),
                NewQuantity: newQty, Note: document.getElementById('adjustNote').value
            })
        });
        showToast('✅ Điều chỉnh tồn kho thành công!');
        closeModal('adjustModal'); loadStock();
    } catch(e) { showToast('❌ ' + e.message, 'error'); }
}

async function loadImportHistory() {
    const tbody = document.getElementById('importHistoryBody');
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:20px;"><div class="skeleton" style="height:14px;width:300px;margin:auto;border-radius:6px;"></div></td></tr>';
    try {
        const data = await apiFetch(`/api/inventory/import-receipts?branchId=${BRANCH_ID}&pageSize=20`);
        const items = data?.items || data || [];
        if (!items.length) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:20px;color:var(--text3);">Chưa có phiếu nhập nào</td></tr>'; return; }
        tbody.innerHTML = items.map(r => `<tr>
            <td style="font-weight:700;color:var(--brown-dark);">#${r.id}</td>
            <td style="font-size:12px;color:var(--text3);">${formatDateTime(r.createdAt)}</td>
            <td>${r.supplierName || 'NCC #' + r.supplierId}</td>
            <td>${r.employeeName || '—'}</td>
            <td style="text-align:right;font-weight:700;color:var(--red);">${formatVND(r.totalValue)}</td>
            <td style="font-size:12px;color:var(--text3);">${r.note || '—'}</td>
        </tr>`).join('');
    } catch(e) { tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:20px;color:var(--red);">❌ ${e.message}</td></tr>`; }
}

document.addEventListener('DOMContentLoaded', loadStock);
</script>
}
