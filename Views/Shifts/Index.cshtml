@{
    Layout = "_Layout";
    ViewBag.ActivePage = "Shifts";
    ViewBag.PageTitle = "Ca làm việc";
    ViewBag.Title = "Ca làm việc";
}

<div class="page-header">
    <div>
        <div class="page-title">🕐 Ca làm việc</div>
        <div class="page-subtitle">Quản lý ca mở/đóng tại chi nhánh</div>
    </div>
</div>

<!-- Current Shift Status -->
<div id="shiftStatusCard" class="card" style="margin-bottom:20px;">
    <div class="card-body">
        <div style="text-align:center;padding:20px;color:var(--text3);">⏳ Đang kiểm tra trạng thái ca...</div>
    </div>
</div>

<!-- Open Shift Modal -->
<div class="modal-overlay" id="openShiftModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">🟢 Mở ca làm việc</div>
            <button class="modal-close" onclick="closeModal('openShiftModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Tiền đầu ca (đ) <span style="color:var(--red)">*</span></label>
                <input type="number" id="startingCash" class="form-control" placeholder="VD: 500000" min="0" value="0">
                <div style="font-size:12px;color:var(--text3);margin-top:4px;">Số tiền mặt trong két khi bắt đầu ca</div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('openShiftModal')">Hủy</button>
            <button class="btn btn-success" onclick="openShift()">✅ Mở ca</button>
        </div>
    </div>
</div>

<!-- Close Shift Modal -->
<div class="modal-overlay" id="closeShiftModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">🔴 Đóng ca làm việc</div>
            <button class="modal-close" onclick="closeModal('closeShiftModal')">×</button>
        </div>
        <div class="modal-body">
            <div id="shiftSummary" style="background:var(--surface2);border-radius:var(--r);padding:16px;margin-bottom:16px;font-size:14px;"></div>
            <div class="form-group">
                <label class="form-label">Tiền mặt thực tế trong két (đ) <span style="color:var(--red)">*</span></label>
                <input type="number" id="actualCash" class="form-control" placeholder="Đếm và nhập số tiền thực tế" min="0">
            </div>
            <div class="form-group">
                <label class="form-label">Ghi chú</label>
                <textarea id="closeNote" class="form-control" rows="2" placeholder="Ghi chú khi đóng ca..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('closeShiftModal')">Hủy</button>
            <button class="btn btn-danger" onclick="closeShift()">🔴 Xác nhận đóng ca</button>
        </div>
    </div>
</div>

<!-- Close Employee Shift Modal -->
<div class="modal-overlay" id="closeEmployeeShiftModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">💰 Kết ca nhân viên & Nộp tiền</div>
            <button class="modal-close" onclick="closeModal('closeEmployeeShiftModal')">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="selectedEmpId">
            <input type="hidden" id="selectedEmpName">
            <input type="hidden" id="selectedEmpRevenue">
            
            <div id="empShiftSummary" style="background:var(--surface2);border-radius:var(--r);padding:16px;margin-bottom:16px;font-size:14px;"></div>
            
            <div class="form-group" style="margin-bottom: 12px;">
                <label class="form-label">💵 Tiền mặt nộp tại quầy (đ) <span style="color:var(--red)">*</span></label>
                <input type="number" id="empActualCash" class="form-control" placeholder="Nhập tiền mặt nộp" oninput="updateEmpSubmitSummary()">
            </div>
            
            <div class="form-group" style="margin-bottom: 12px;">
                <label class="form-label">📱 Chuyển khoản (Zalo check) (đ) <span style="color:var(--red)">*</span></label>
                <input type="number" id="empActualTransfer" class="form-control" placeholder="Nhập tiền chuyển khoản đã check trên gr Zalo" oninput="updateEmpSubmitSummary()">
                <div style="font-size:11px;color:var(--text3);margin-top:4px;line-height:1.4;">
                    💬 <strong>Mô hình Zalo:</strong> Nhân viên gửi ảnh bill chuyển khoản vào nhóm Zalo của quán. Quản lý kiểm tra Zalo và nhập số tiền khớp vào đây.
                </div>
            </div>

            <div id="empSubmitSummaryAlert" style="margin-top:14px;padding:10px 14px;border-radius:var(--r);font-size:13px;font-weight:600;"></div>
            <div class="form-group">
                <label class="form-label">Ghi chú</label>
                <textarea id="empCloseNote" class="form-control" rows="2" placeholder="Ghi chú (ví dụ: Nộp đủ, Thiếu 5k...)"></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('closeEmployeeShiftModal')">Hủy</button>
            <button class="btn btn-primary" onclick="submitEmployeeCash()">💾 Xác nhận nộp tiền</button>
        </div>
    </div>
</div>

<!-- Shift History -->
<div class="card" style="margin-top:20px;">
    <div class="card-header">
        <div class="card-title">📜 Lịch sử ca làm việc</div>
        <button class="btn btn-outline btn-sm" onclick="loadShiftHistory()">🔄 Làm mới</button>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>#Ca</th>
                    <th>Nhân viên</th>
                    <th>Bắt đầu</th>
                    <th>Kết thúc</th>
                    <th>Tiền đầu ca</th>
                    <th>Doanh thu ca</th>
                    <th>Tiền kết ca</th>
                    <th>Chênh lệch</th>
                    <th style="text-align:center;">Trạng thái</th>
                    <th style="text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody id="shiftHistoryBody">
                <tr><td colspan="10" style="text-align:center;padding:30px;color:var(--text3);">⏳ Đang tải...</td></tr>
            </tbody>
        </table>
</div>

<!-- Daily Shift Statistics -->
<div class="card" style="margin-top:20px;">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
        <div class="card-title">📊 Thống kê ca theo ngày</div>
        <button class="btn btn-outline btn-sm" onclick="loadDailyShiftStats()">🔄 Làm mới</button>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Ngày</th>
                    <th style="text-align:center;">Số ca</th>
                    <th style="text-align:right;">Tổng tiền đầu ca</th>
                    <th style="text-align:right;">Tổng doanh thu ca</th>
                    <th style="text-align:right;">Tổng tiền kết ca dự kiến</th>
                    <th style="text-align:right;">Tổng tiền kết ca thực tế</th>
                    <th style="text-align:right;">Tổng chênh lệch</th>
                </tr>
            </thead>
            <tbody id="dailyStatsBody">
                <tr><td colspan="7" style="text-align:center;padding:30px;color:var(--text3);">⏳ Đang tải...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Shift Orders Modal -->
<div class="modal-overlay" id="shiftOrdersModal">
    <div class="modal modal-lg">
        <div class="modal-header">
            <div class="modal-title" id="shiftOrdersTitle">Danh sách đơn hàng ca làm việc</div>
            <button class="modal-close" onclick="closeModal('shiftOrdersModal')">×</button>
        </div>
        <div class="modal-body" style="padding:20px;">
            <div class="table-wrap" style="max-height: 400px; overflow-y: auto;">
                <table>
                    <thead>
                        <tr>
                            <th>Mã ĐH</th>
                            <th>Loại</th>
                            <th>Bàn</th>
                            <th>Trạng thái</th>
                            <th>Thời gian</th>
                            <th style="text-align:right;">Tổng tiền</th>
                        </tr>
                    </thead>
                    <tbody id="shiftOrdersBody">
                        <tr><td colspan="6" style="text-align:center;padding:20px;color:var(--text3);">⏳ Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('shiftOrdersModal')">Đóng</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
let currentShift = null;

async function loadShift() {
    const card = document.getElementById('shiftStatusCard');
    try {
        currentShift = await apiFetch(`/api/shifts/current/${BRANCH_ID}`);
        renderOpenShift(currentShift);
    } catch {
        currentShift = null;
        card.innerHTML = `
            <div class="card-body" style="text-align:center;padding:48px 20px;">
                <div style="font-size:64px;margin-bottom:16px;">😴</div>
                <div style="font-size:20px;font-weight:700;color:var(--brown-dark);margin-bottom:8px;">Chưa có ca làm việc nào đang mở</div>
                <div style="color:var(--text3);margin-bottom:24px;">Nhấn nút bên dưới để bắt đầu ca làm việc mới</div>
                <button class="btn btn-success btn-lg" onclick="showOpenShift()">🟢 Mở ca làm việc</button>
            </div>`;
    }
}

let currentShiftBreakdown = [];

function renderOpenShift(s) {
    const card = document.getElementById('shiftStatusCard');
    const startTime = new Date(s.startTime);
    const elapsed = Math.floor((Date.now() - startTime.getTime()) / 60000);
    const hours = Math.floor(elapsed / 60);
    const mins  = elapsed % 60;

    // Đọc lịch sử kết ca nhân viên từ localStorage
    const closures = JSON.parse(localStorage.getItem('employee_closures_shift_' + s.id) || '{}');

    // Khởi tạo bảng chi tiết doanh thu theo người order
    card.innerHTML = `
        <div style="background:linear-gradient(135deg,#27AE60,#1E8449);padding:30px;border-radius:var(--r-lg);color:#fff;margin-bottom:18px;">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
                <div>
                    <div style="font-size:13px;opacity:.75;margin-bottom:4px;">Ca đang mở — Chi nhánh #${s.branchId}</div>
                    <div style="font-size:28px;font-weight:800;">Ca #${s.id}</div>
                    <div style="font-size:13px;opacity:.85;margin-top:6px;">👤 Người mở ca: <strong>${s.employeeName || '—'}</strong></div>
                    <div style="font-size:13px;opacity:.85;">Bắt đầu: ${formatDateTime(s.startTime)}</div>
                    <div style="font-size:13px;opacity:.85;">Thời gian: ${hours > 0 ? hours + ' giờ ' : ''}${mins} phút</div>
                </div>
                <div style="text-align:right;">
                    <div style="font-size:13px;opacity:.75;">Tiền mặt đầu ca</div>
                    <div style="font-size:24px;font-weight:800;color:#fff;">${formatVND(s.startingCash)}</div>
                    <div style="font-size:13px;opacity:.75;margin-top:8px;">Tổng doanh thu ca hiện tại</div>
                    <div style="font-size:20px;font-weight:800;color:#fff;">${formatVND(s.revenue)}</div>
                    <button class="btn" style="margin-top:16px;background:rgba(255,255,255,.2);color:#fff;border:1.5px solid rgba(255,255,255,.4);"
                            onclick="showCloseShift()">🔴 Kết ca tổng (Đóng ca)</button>
                </div>
            </div>
        </div>

        <div class="card" style="border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); background: var(--surface);">
            <div class="card-header" style="background: var(--surface2); border-bottom: 1px solid var(--border); padding: 12px 20px;">
                <div class="card-title" style="font-size: 14.5px; font-weight: 700; color: var(--brown-dark);">👥 CHI TIẾT DOANH THU &amp; KẾT CA NHÂN VIÊN ORDER</div>
            </div>
            <div class="table-wrap" style="padding: 0;">
                <table style="width: 100%; border-collapse: collapse; margin: 0;">
                    <thead>
                        <tr style="background: var(--surface2); border-bottom: 1px solid var(--border);">
                            <th style="padding: 12px 20px; text-align: left;">Nhân viên order</th>
                            <th style="padding: 12px 20px; text-align: center;">Số đơn hàng</th>
                            <th style="padding: 12px 20px; text-align: right;">Tiền mặt thu (đ)</th>
                            <th style="padding: 12px 20px; text-align: right;">CK qua Zalo (đ)</th>
                            <th style="padding: 12px 20px; text-align: right;">Tổng doanh thu (đ)</th>
                            <th style="padding: 12px 20px; text-align: center;">Trạng thái kết ca</th>
                            <th style="padding: 12px 20px; text-align: center;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="employeeBreakdownBody">
                        <tr>
                            <td colspan="7" style="text-align:center;padding:20px;color:var(--text3);">⏳ Đang tính toán doanh thu chi tiết...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    `;

    // Gọi API lấy breakdown doanh thu của từng nhân viên tạo đơn
    apiFetch(`/api/shifts/${s.id}/employee-breakdown`)
        .then(list => {
            currentShiftBreakdown = list || [];
            const tbody = document.getElementById('employeeBreakdownBody');
            if (!list || list.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" style="text-align:center;padding:24px;color:var(--text3);font-style:italic;">
                            Chưa có nhân viên nào phát sinh đơn hàng COMPLETED trong ca này.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = list.map(item => {
                const closure = closures[item.employeeId];
                const isClosed = closure && closure.isClosed;

                const statusBadge = isClosed
                    ? `<span class="badge badge-green" style="font-weight:700;padding:4px 10px;" title="Tiền mặt: ${formatVND(closure.actualCash)} | CK Zalo: ${formatVND(closure.actualTransfer)}">✅ Đã nộp ${formatVND(closure.totalSubmitted)}</span>`
                    : `<span class="badge badge-amber" style="font-weight:700;padding:4px 10px;">⏳ Chưa kết ca</span>`;

                const actionBtn = isClosed
                    ? `<span style="font-size:12px;color:var(--text3);font-style:italic;">Hoàn tất lúc ${closure.closedAt}</span>`
                    : `<button class="btn btn-primary btn-sm" style="font-size:12px;padding:4px 10px;" onclick="openCloseEmployeeShift(${item.employeeId}, '${item.employeeName.replace(/'/g,"\\'")}', ${item.totalRevenue})">💰 Nộp tiền &amp; Kết ca</button>`;

                return `
                    <tr style="border-bottom:1px solid var(--border);">
                        <td style="padding:12px 20px;font-weight:700;color:var(--brown-dark);">${item.employeeName}</td>
                        <td style="padding:12px 20px;text-align:center;font-weight:600;">${item.orderCount} đơn</td>
                        <td style="padding:12px 20px;text-align:right;font-weight:600;color:var(--text2);">${formatVND(item.cashRevenue)}</td>
                        <td style="padding:12px 20px;text-align:right;font-weight:600;color:var(--blue);">${formatVND(item.transferRevenue)}</td>
                        <td style="padding:12px 20px;text-align:right;font-weight:800;color:var(--green);">${formatVND(item.totalRevenue)}</td>
                        <td style="padding:12px 20px;text-align:center;">${statusBadge}</td>
                        <td style="padding:12px 20px;text-align:center;">${actionBtn}</td>
                    </tr>
                `;
            }).join('');
        })
        .catch(e => {
            document.getElementById('employeeBreakdownBody').innerHTML = `
                <tr>
                    <td colspan="7" style="text-align:center;padding:20px;color:var(--red);">
                        ❌ Không thể tải breakdown doanh thu: ${e.message}
                    </td>
                </tr>
            `;
        });
}

function openCloseEmployeeShift(empId, empName, revenue) {
    const empData = currentShiftBreakdown.find(x => x.employeeId === empId) || { cashRevenue: revenue, transferRevenue: 0 };

    document.getElementById('selectedEmpId').value = empId;
    document.getElementById('selectedEmpName').value = empName;
    document.getElementById('selectedEmpRevenue').value = revenue;

    document.getElementById('empShiftSummary').innerHTML = `
        <div style="display:grid;grid-template-columns:1fr;gap:6px;">
            <div><span style="color:var(--text3);font-size:12px;font-weight:600;">👤 Nhân viên:</span> <strong style="font-size:14.5px;color:var(--brown-dark);">${empName}</strong></div>
            <div style="display:flex;justify-content:space-between;border-top:1px solid var(--border);padding-top:6px;font-size:12.5px;">
                <span>💵 Tiền mặt thu: <strong>${formatVND(empData.cashRevenue)}</strong></span>
                <span>📱 CK qua Zalo: <strong>${formatVND(empData.transferRevenue)}</strong></span>
            </div>
            <div style="border-top:1px solid var(--border);padding-top:6px;font-size:13.5px;">
                Tổng doanh thu cần nộp: <strong style="color:var(--green);font-size:15px;">${formatVND(revenue)}</strong>
            </div>
        </div>
    `;
    
    // Tự động điền số liệu gợi ý theo dữ liệu bán hàng thực tế
    document.getElementById('empActualCash').value = empData.cashRevenue.toFixed(0);
    document.getElementById('empActualTransfer').value = empData.transferRevenue.toFixed(0);
    document.getElementById('empCloseNote').value = 'Nộp đủ tiền mặt tại quầy + CK đã check gr Zalo';
    
    document.getElementById('closeEmployeeShiftModal').classList.add('active');
    updateEmpSubmitSummary();
}

function updateEmpSubmitSummary() {
    const revenue = parseFloat(document.getElementById('selectedEmpRevenue').value) || 0;
    const cash = parseFloat(document.getElementById('empActualCash').value) || 0;
    const trans = parseFloat(document.getElementById('empActualTransfer').value) || 0;
    const total = cash + trans;
    const diff = total - revenue;

    const alertEl = document.getElementById('empSubmitSummaryAlert');
    if (!alertEl) return;
    
    if (diff === 0) {
        alertEl.style.background = 'rgba(39, 174, 96, 0.1)';
        alertEl.style.color = 'var(--green)';
        alertEl.style.border = '1px solid rgba(39, 174, 96, 0.2)';
        alertEl.innerHTML = `✅ Tổng nộp: ${formatVND(total)} (Khớp 100% doanh thu ca)`;
    } else {
        const diffStr = diff > 0 ? `Thừa +${formatVND(diff)}` : `Thiếu ${formatVND(diff)}`;
        alertEl.style.background = 'rgba(231, 76, 60, 0.1)';
        alertEl.style.color = 'var(--red)';
        alertEl.style.border = '1px solid rgba(231, 76, 60, 0.2)';
        alertEl.innerHTML = `⚠️ Tổng nộp: ${formatVND(total)} (${diffStr} so với doanh thu ${formatVND(revenue)})`;
    }
}

function submitEmployeeCash() {
    const shiftId = currentShift.id;
    const empId = document.getElementById('selectedEmpId').value;
    const empName = document.getElementById('selectedEmpName').value;
    const revenue = parseFloat(document.getElementById('selectedEmpRevenue').value) || 0;
    const cash = parseFloat(document.getElementById('empActualCash').value) || 0;
    const trans = parseFloat(document.getElementById('empActualTransfer').value) || 0;
    
    const note = document.getElementById('empCloseNote').value;
    const now = new Date();
    const closedAt = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

    // Ghi nhận nộp tiền vào localStorage
    const closures = JSON.parse(localStorage.getItem('employee_closures_shift_' + shiftId) || '{}');
    closures[empId] = {
        employeeId: empId,
        employeeName: empName,
        revenue: revenue,
        actualCash: cash,
        actualTransfer: trans,
        totalSubmitted: cash + trans,
        isClosed: true,
        closedAt: closedAt,
        note: note
    };
    
    localStorage.setItem('employee_closures_shift_' + shiftId, JSON.stringify(closures));
    
    showToast(`✅ Đã nhận nộp của ${empName}: Tiền mặt ${formatVND(cash)} + CK Zalo ${formatVND(trans)}!`);
    closeModal('closeEmployeeShiftModal');
    renderOpenShift(currentShift);
}

function showOpenShift() {
    document.getElementById('startingCash').value = '0';
    document.getElementById('openShiftModal').classList.add('active');
}

async function openShift() {
    const cash = parseFloat(document.getElementById('startingCash').value) || 0;
    try {
        await apiFetch('/api/shifts/open', {
            method: 'POST',
            body: JSON.stringify({
                BranchId: BRANCH_ID,
                EmployeeId: EMPLOYEE_ID || 1,
                StartingCash: cash
            })
        });
        showToast('✅ Mở ca thành công!');
        closeModal('openShiftModal');
        loadShift();
    } catch(e) {
        showToast('❌ ' + e.message, 'error');
    }
}

async function showCloseShift() {
    if (!currentShift) return;

    const shiftId = currentShift.id;
    const startingCash = currentShift.startingCash || 0;
    
    // Đọc kết quả kết ca nhân viên từ localStorage
    const closures = JSON.parse(localStorage.getItem('employee_closures_shift_' + shiftId) || '{}');
    
    let totalCashSubmitted = 0;
    let totalTransferSubmitted = 0;
    let employeeBreakdownHtml = '';
    
    try {
        const list = await apiFetch(`/api/shifts/${shiftId}/employee-breakdown`);
        if (list && list.length > 0) {
            employeeBreakdownHtml = `
                <div style="margin-top:14px;border-top:1px dashed var(--border);padding-top:10px;">
                    <div style="font-size:12px;font-weight:700;color:var(--brown-dark);margin-bottom:6px;">Chi tiết đóng góp của nhân viên order:</div>
                    <div style="display:flex;flex-direction:column;gap:6px;">
            `;
            
            list.forEach(item => {
                const closure = closures[item.employeeId];
                const cashSub = closure ? (closure.actualCash || 0) : 0;
                const transSub = closure ? (closure.actualTransfer || 0) : 0;
                
                totalCashSubmitted += cashSub;
                totalTransferSubmitted += transSub;
                
                const statusStr = closure 
                    ? `<span style="color:var(--green);font-weight:700;">✅ Nộp: Tiền mặt ${formatVND(cashSub)} | CK Zalo ${formatVND(transSub)}</span>`
                    : `<span style="color:var(--red);font-weight:700;">⚠️ Chưa nộp (Dự kiến: ${formatVND(item.totalRevenue)})</span>`;
                
                employeeBreakdownHtml += `
                    <div style="display:flex;justify-content:space-between;font-size:12px;background:rgba(0,0,0,.02);padding:4px 8px;border-radius:4px;">
                        <span>👤 ${item.employeeName}</span>
                        <span>${statusStr}</span>
                    </div>
                `;
            });
            
            employeeBreakdownHtml += `
                    </div>
                </div>
            `;
        } else {
            employeeBreakdownHtml = `
                <div style="margin-top:10px;font-size:12px;color:var(--text3);font-style:italic;text-align:center;">
                    Chưa có nhân viên nào phát sinh doanh thu trong ca.
                </div>
            `;
        }
    } catch(e) {
        console.warn('Lỗi breakdown:', e);
    }

    // Tiền mặt dự kiến có trong két = Tiền mặt đầu ca + Tổng tiền mặt nhân viên nộp!
    const expectedCashInDrawer = startingCash + totalCashSubmitted;
    const expectedTotalRevenue = totalCashSubmitted + totalTransferSubmitted;

    document.getElementById('shiftSummary').innerHTML = `
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div><div style="font-size:11px;color:var(--text3);font-weight:600;">👤 Trưởng ca</div><div style="font-weight:700;font-size:14px;">${currentShift.employeeName || '—'}</div></div>
            <div><div style="font-size:11px;color:var(--text3);font-weight:600;">Tiền mặt đầu ca</div><div style="font-weight:700;font-size:14px;">${formatVND(startingCash)}</div></div>
            <div><div style="font-size:11px;color:var(--text3);font-weight:600;">Tổng tiền mặt NV nộp</div><div style="font-weight:700;font-size:14px;color:var(--green);">${formatVND(totalCashSubmitted)}</div></div>
            <div><div style="font-size:11px;color:var(--text3);font-weight:600;">Tổng CK qua Zalo</div><div style="font-weight:700;font-size:14px;color:var(--blue);">${formatVND(totalTransferSubmitted)}</div></div>
            <div style="grid-column: 1 / -1; border-top: 1px solid var(--border); padding-top: 8px; display:flex; justify-content:space-between; align-items:center;">
                <div style="font-size:12px;color:var(--text3);font-weight:700;">💰 DỰ KIẾN TIỀN MẶT TRONG KÉT:</div>
                <div style="font-weight:800;font-size:17px;color:var(--brown-dark);">${formatVND(expectedCashInDrawer)}</div>
            </div>
        </div>
        ${employeeBreakdownHtml}
    `;
    
    document.getElementById('actualCash').value = expectedCashInDrawer.toFixed(0);
    document.getElementById('closeNote').value = `Kết ca tổng. Tiền mặt đầu ca: ${formatVND(startingCash)}. Tiền mặt NV nộp: ${formatVND(totalCashSubmitted)}. CK Zalo: ${formatVND(totalTransferSubmitted)}.`;
    document.getElementById('closeShiftModal').classList.add('active');
}

async function closeShift() {
    if (!currentShift) return;
    const actual = parseFloat(document.getElementById('actualCash').value);
    if (isNaN(actual)) { showToast('⚠️ Nhập tiền thực tế trong két!', 'warn'); return; }
    const note = document.getElementById('closeNote').value;
    try {
        // Check for active orders in the shift
        const res = await apiFetch(`/api/orders?branchId=${BRANCH_ID}&shiftId=${currentShift.id}&pageSize=100`);
        const items = res?.items || [];
        const activeOrders = items.filter(o => o.orderStatus !== 'COMPLETED' && o.orderStatus !== 'CANCELLED');
        if (activeOrders.length > 0) {
            const activeIds = activeOrders.map(o => `#${o.id}`).join(', ');
            const confirmMsg = `⚠️ Cảnh báo: Ca hiện tại đang có ${activeOrders.length} đơn hàng chưa thanh toán hoặc chưa hủy (${activeIds}). Bạn có chắc chắn muốn kết ca?`;
            if (!confirm(confirmMsg)) {
                return;
            }
        }

        await apiFetch(`/api/shifts/${currentShift.id}/close`, {
            method: 'POST',
            body: JSON.stringify({ ActualEndingCash: actual, Note: note })
        });
        showToast('✅ Đóng ca thành công!');
        closeModal('closeShiftModal');
        window.CURRENT_SHIFT_ID = null;
        document.getElementById('shift-status-badge').style.display = 'none';
        loadShift();
        loadShiftHistory();
    } catch(e) {
        showToast('❌ ' + e.message, 'error');
    }
}

async function loadShiftHistory() {
    const tbody = document.getElementById('shiftHistoryBody');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;padding:20px;"><div class="skeleton" style="height:14px;width:300px;margin:auto;border-radius:6px;"></div></td></tr>';
    try {
        const data = await apiFetch(`/api/shifts/history/${BRANCH_ID}?pageSize=20`);
        if (!data || !data.length) {
            tbody.innerHTML = '<tr><td colspan="10"><div class="empty-state"><div class="es-icon">📋</div><div class="es-title">Chưa có lịch sử ca</div></div></td></tr>';
            return;
        }
        tbody.innerHTML = data.map(s => {
            const diff = s.difference ?? 0;
            const diffColor = diff >= 0 ? 'var(--green)' : 'var(--red)';
            const diffSign  = diff >= 0 ? '+' : '';
            return `<tr>
                <td style="font-weight:700;color:var(--brown-dark);">#${s.id}</td>
                <td style="font-size:13px;font-weight:600;">${s.employeeName || '—'}</td>
                <td style="font-size:13px;">${formatDateTime(s.startTime)}</td>
                <td style="font-size:13px;color:var(--text3);">${s.endTime ? formatDateTime(s.endTime) : '—'}</td>
                <td style="text-align:right;font-weight:600;">${formatVND(s.startingCash)}</td>
                <td style="text-align:right;font-weight:700;color:var(--green);">${formatVND(s.revenue)}</td>
                <td style="text-align:right;font-weight:600;">${s.actualEndingCash != null ? formatVND(s.actualEndingCash) : '—'}</td>
                <td style="text-align:right;font-weight:700;color:${diffColor};">${s.difference != null ? diffSign + formatVND(diff) : '—'}</td>
                <td style="text-align:center;">
                    <span class="badge ${s.status === 'OPEN' ? 'badge-green' : 'badge-gray'}">
                        ${s.status === 'OPEN' ? '🟢 Đang mở' : '⭕ Đã đóng'}
                    </span>
                </td>
                <td style="text-align:center;">
                    <button class="btn btn-outline btn-sm" style="font-size:11px;" onclick="showShiftOrders(${s.id})">👁️ Xem đơn</button>
                </td>
            </tr>`;
        }).join('');
    } catch(e) {
        tbody.innerHTML = `<tr><td colspan="10" style="text-align:center;color:var(--text3);padding:20px;">❌ ${e.message}</td></tr>`;
    }
}

async function showShiftOrders(shiftId) {
    document.getElementById('shiftOrdersTitle').textContent = `Danh sách đơn hàng - Ca #${shiftId}`;
    const tbody = document.getElementById('shiftOrdersBody');
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:20px;"><div class="skeleton" style="height:14px;width:200px;margin:auto;border-radius:6px;"></div></td></tr>';
    document.getElementById('shiftOrdersModal').classList.add('active');

    try {
        const res = await apiFetch(`/api/orders?branchId=${BRANCH_ID}&shiftId=${shiftId}&pageSize=100`);
        const items = res?.items || [];
        if (items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:20px;color:var(--text3);font-style:italic;">Không có đơn hàng nào trong ca này</td></tr>';
            return;
        }
        const STATUS_MAP = {
            PENDING: { label:'Chờ xử lý', badge:'badge-amber' },
            COOKING: { label:'Đang làm', badge:'badge-blue' },
            SERVED:  { label:'Đã phục vụ', badge:'badge-purple' },
            COMPLETED:{ label:'Hoàn thành', badge:'badge-green' },
            CANCELLED:{ label:'Đã hủy', badge:'badge-red' }
        };
        tbody.innerHTML = items.map(o => {
            const st = STATUS_MAP[o.orderStatus] || { label: o.orderStatus, badge:'badge-gray' };
            return `<tr>
                <td><span style="font-weight:700;color:var(--brown-dark);">#${o.id}</span></td>
                <td><span class="badge ${o.orderType==='DINE_IN'?'badge-brown':'badge-blue'}">${o.orderType==='DINE_IN'?'Tại bàn':'Mang về'}</span></td>
                <td>${o.tableName || '<span style="color:var(--text3)">—</span>'}</td>
                <td><span class="badge ${st.badge}">${st.label}</span></td>
                <td style="font-size:12px;color:var(--text3);">${formatDateTime(o.createdAt)}</td>
                <td style="text-align:right;font-weight:700;color:var(--red);">${formatVND(o.finalAmount)}</td>
            </tr>`;
        }).join('');
    } catch (e) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;color:var(--red);padding:20px;">❌ Lỗi: ${e.message}</td></tr>`;
    }
}

async function loadDailyShiftStats() {
    const tbody = document.getElementById('dailyStatsBody');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:20px;"><div class="skeleton" style="height:14px;width:300px;margin:auto;border-radius:6px;"></div></td></tr>';
    try {
        const res = await apiFetch(`/api/shifts/daily-stats/${BRANCH_ID}`);
        if (!res || !res.length) {
            tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><div class="es-icon">📊</div><div class="es-title">Chưa có dữ liệu thống kê</div></div></td></tr>';
            return;
        }
        tbody.innerHTML = res.map(s => {
            const diff = s.totalDifference ?? 0;
            const diffColor = diff >= 0 ? 'var(--green)' : 'var(--red)';
            const diffSign  = diff > 0 ? '+' : '';
            
            const parts = s.date.split('-');
            const formattedDate = parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : s.date;

            return `<tr>
                <td style="font-weight:700;color:var(--brown-dark);">${formattedDate}</td>
                <td style="text-align:center;font-weight:600;">${s.shiftCount}</td>
                <td style="text-align:right;font-weight:600;">${formatVND(s.totalStartingCash)}</td>
                <td style="text-align:right;font-weight:700;color:var(--green);">${formatVND(s.totalRevenue)}</td>
                <td style="text-align:right;font-weight:600;">${formatVND(s.totalExpectedCash)}</td>
                <td style="text-align:right;font-weight:600;">${formatVND(s.totalActualEndingCash)}</td>
                <td style="text-align:right;font-weight:700;color:${diffColor};">${diffSign}${formatVND(diff)}</td>
            </tr>`;
        }).join('');
    } catch(e) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:var(--text3);padding:20px;">❌ Lỗi: ${e.message}</td></tr>`;
    }
}

function closeModal(id) { document.getElementById(id).classList.remove('active'); }

document.addEventListener('DOMContentLoaded', () => { 
    loadShift(); 
    loadShiftHistory(); 
    loadDailyShiftStats(); 
});
</script>
}
