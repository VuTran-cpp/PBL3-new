@{
    Layout = "_Layout";
    ViewBag.ActivePage = "Customers";
    ViewBag.PageTitle = "Quản lý Khách hàng";
    ViewBag.Title = "Khách hàng";
}

<div class="page-header">
    <div>
        <div class="page-title">👥 Quản lý Khách hàng</div>
        <div class="page-subtitle">Danh sách thành viên và điểm tích lũy</div>
    </div>
    <button class="btn btn-primary" onclick="openAddModal()">＋ Thêm khách hàng</button>
</div>

<!-- Filters -->
<div class="filters-bar" style="margin-bottom:16px;">
    <div class="search-wrap" style="flex:1;min-width:200px;">
        <span>🔍</span>
        <input type="text" id="searchCust" placeholder="Tìm tên, số điện thoại..." oninput="debounceSearch()">
    </div>
    <select id="filterTier" class="form-control" style="width:160px;" onchange="loadCustomers(1)">
        <option value="">Tất cả hạng</option>
        <option value="BRONZE">🥉 Bronze</option>
        <option value="SILVER">🥈 Silver</option>
        <option value="GOLD">🥇 Gold</option>
    </select>
</div>

<!-- Table -->
<div class="card">
    <div class="card-header">
        <div class="card-title">Danh sách khách hàng</div>
        <div id="custCount" style="font-size:13px;color:var(--text3);"></div>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Sinh nhật</th>
                    <th style="text-align:center;">Hạng</th>
                    <th style="text-align:right;">Điểm tích lũy</th>
                    <th style="text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody id="custTableBody">
                <tr><td colspan="7" style="text-align:center;padding:40px;color:var(--text3);">⏳ Đang tải...</td></tr>
            </tbody>
        </table>
    </div>
    <div id="pagination" class="pagination" style="padding:16px;"></div>
</div>

<!-- Edit Customer Modal -->
<div class="modal-overlay" id="editCustModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title" id="editCustTitle">✐ Chỉnh sửa khách hàng</div>
            <button class="modal-close" onclick="closeModal('editCustModal')">×</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="editCustId">
            <div class="form-group">
                <label class="form-label">Họ tên <span style="color:var(--red)">*</span></label>
                <input type="text" id="editCustName" class="form-control">
            </div>
            <div class="form-group">
                <label class="form-label">Số điện thoại</label>
                <input type="tel" id="editCustPhone" class="form-control" disabled style="opacity:.6">
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" id="editCustEmail" class="form-control">
            </div>
            <div class="form-group">
                <label class="form-label">Ngày sinh</label>
                <input type="date" id="editCustBirthday" class="form-control">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('editCustModal')">Hủy</button>
            <button class="btn btn-primary" onclick="updateCustomer()">💾 Lưu thay đổi</button>
        </div>
    </div>
</div>

<!-- Customer Detail Modal -->
<div class="modal-overlay" id="custDetailModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">👤 Chi tiết khách hàng</div>
            <button class="modal-close" onclick="closeModal('custDetailModal')">×</button>
        </div>
        <div class="modal-body" id="custDetailBody" style="padding:0">
            <div style="text-align:center;padding:40px;color:var(--text3);">⏳ Đang tải...</div>
        </div>
        <div class="modal-footer" id="custDetailFooter"></div>
    </div>
</div>
<div class="modal-overlay" id="addCustModal">
    <div class="modal">
        <div class="modal-header">
            <div class="modal-title">＋ Thêm khách hàng mới</div>
            <button class="modal-close" onclick="closeModal('addCustModal')">×</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Họ tên <span style="color:var(--red)">*</span></label>
                <input type="text" id="custName" class="form-control" placeholder="Nguyễn Văn A">
            </div>
            <div class="form-group">
                <label class="form-label">Số điện thoại <span style="color:var(--red)">*</span></label>
                <input type="tel" id="custPhone" class="form-control" placeholder="0901234567">
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" id="custEmail" class="form-control" placeholder="email@example.com">
            </div>
            <div class="form-group">
                <label class="form-label">Ngày sinh</label>
                <input type="date" id="custBirthday" class="form-control">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('addCustModal')">Hủy</button>
            <button class="btn btn-primary" onclick="saveCustomer()">💾 Lưu khách hàng</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
let searchTimer = null;
let currentPage = 1;

const TIER_MAP = {
    BRONZE: { label:'🥉 Bronze', badge:'badge-brown' },
    SILVER: { label:'🥈 Silver', badge:'badge-gray' },
    GOLD:   { label:'🥇 Gold', badge:'badge-amber' }
};

function debounceSearch() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => loadCustomers(1), 400);
}

async function loadCustomers(page = 1) {
    currentPage = page;
    const search = document.getElementById('searchCust').value.trim();
    const tier   = document.getElementById('filterTier').value;
    let qs = `page=${page}&pageSize=20`;
    if (search) qs += `&search=${encodeURIComponent(search)}`;
    if (tier)   qs += `&tier=${tier}`;

    const body = document.getElementById('custTableBody');
    body.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:40px;"><div class="skeleton" style="height:16px;width:200px;margin:auto;border-radius:6px;"></div></td></tr>`;

    try {
        const data = await apiFetch(`/api/customers?${qs}`);
        document.getElementById('custCount').textContent = `Tổng: ${data.totalCount} khách`;

        if (!data.items.length) {
            body.innerHTML = `<tr><td colspan="7"><div class="empty-state"><div class="es-icon">👥</div><div class="es-title">Không tìm thấy khách hàng</div></div></td></tr>`;
            document.getElementById('pagination').innerHTML = '';
            return;
        }

        body.innerHTML = data.items.map(c => {
            const tier = TIER_MAP[c.memberTier] || { label: c.memberTier, badge:'badge-gray' };
            return `<tr>
                <td>
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div style="width:36px;height:36px;border-radius:50%;background:var(--brown-mid);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;flex-shrink:0;">
                            ${c.fullName.charAt(0).toUpperCase()}
                        </div>
                        <div>
                            <div style="font-weight:600;">${c.fullName}</div>
                            <div style="font-size:11px;color:var(--text3);">ID: ${c.id}</div>
                        </div>
                    </div>
                </td>
                <td style="font-weight:600;">${c.phone}</td>
                <td style="font-size:13px;color:var(--text3);">${c.email || '—'}</td>
                <td style="font-size:13px;">${c.birthday ? formatDate(c.birthday) : '—'}</td>
                <td style="text-align:center;"><span class="badge ${tier.badge}">${tier.label}</span></td>
                <td style="text-align:right;font-weight:700;color:var(--brown-dark);">
                    ${c.points.toLocaleString('vi-VN')} điểm
                </td>
                <td style="text-align:center;">
                    <button class="btn btn-outline btn-sm" onclick="viewCustomer(${c.id})">👁 Chi tiết</button>
                    <button class="btn btn-outline btn-sm" style="margin-left:4px;" onclick="openEditModal(${c.id})">✏️ Sửa</button>
                </td>
            </tr>`;
        }).join('');

        renderPagination(data.page, data.totalPages);
    } catch(e) {
        body.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--red);">❌ ${e.message}</td></tr>`;
    }
}

function renderPagination(page, totalPages) {
    const el = document.getElementById('pagination');
    if (totalPages <= 1) { el.innerHTML = ''; return; }
    let html = `<button class="page-btn" onclick="loadCustomers(${page-1})" ${page<=1?'disabled':''}>‹</button>`;
    for (let p = Math.max(1, page-2); p <= Math.min(totalPages, page+2); p++) {
        html += `<button class="page-btn ${p===page?'active':''}" onclick="loadCustomers(${p})">${p}</button>`;
    }
    html += `<button class="page-btn" onclick="loadCustomers(${page+1})" ${page>=totalPages?'disabled':''}>›</button>`;
    el.innerHTML = html;
}

async function viewCustomer(id) {
    const body = document.getElementById('custDetailBody');
    const footer = document.getElementById('custDetailFooter');
    body.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text3);">⏳ Đang tải...</div>';
    footer.innerHTML = '';
    document.getElementById('custDetailModal').classList.add('active');
    try {
        const c = await apiFetch(`/api/customers/${id}`);
        const tier = TIER_MAP[c.memberTier] || { label: c.memberTier, badge:'badge-gray' };
        body.innerHTML = `
            <div style="padding:20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:16px;">
                <div style="width:56px;height:56px;border-radius:50%;background:var(--brown-mid);color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;flex-shrink:0;">
                    ${c.fullName.charAt(0).toUpperCase()}
                </div>
                <div>
                    <div style="font-size:18px;font-weight:700;">${c.fullName}</div>
                    <div style="font-size:13px;color:var(--text3);">${c.phone} ${c.email ? '&middot; '+c.email : ''}</div>
                    <span class="badge ${tier.badge}" style="margin-top:4px;">${tier.label}</span>
                </div>
            </div>
            <div style="padding:16px 20px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
                <div style="text-align:center;">
                    <div style="font-size:24px;font-weight:800;color:var(--brown-dark);">${c.points?.toLocaleString('vi-VN') || 0}</div>
                    <div style="font-size:12px;color:var(--text3);">Điểm tích lũy</div>
                </div>
                <div style="text-align:center;">
                    <div style="font-size:24px;font-weight:800;color:var(--green);">${c.totalOrders || 0}</div>
                    <div style="font-size:12px;color:var(--text3);">Tổng đơn</div>
                </div>
                <div style="text-align:center;">
                    <div style="font-size:24px;font-weight:800;color:var(--red);">${formatVND(c.totalSpent || 0)}</div>
                    <div style="font-size:12px;color:var(--text3);">Tổng chi tiêu</div>
                </div>
            </div>
            <div style="padding:0 20px 16px;font-size:13px;color:var(--text3);">
                ${c.birthday ? '<div>🎂 Sinh nhật: ' + formatDate(c.birthday) + '</div>' : ''}
                <div>Ngày đăng ký: ${formatDate(c.createdAt)}</div>
            </div>
        `;
        footer.innerHTML = `
            <button class="btn btn-outline" onclick="openEditModal(${c.id})">✏️ Chỉnh sửa</button>
            <button class="btn btn-outline" onclick="closeModal('custDetailModal')">Đóng</button>
        `;
    } catch(e) { body.innerHTML = `<div style="text-align:center;padding:40px;color:var(--red);">❌ ${e.message}</div>`; }
}

function openEditModal(id) {
    const c = arguments[1] || null;
    // Try to find from last-loaded list if available
    const doOpen = (cust) => {
        document.getElementById('editCustId').value = cust.id;
        document.getElementById('editCustName').value = cust.fullName;
        document.getElementById('editCustPhone').value = cust.phone;
        document.getElementById('editCustEmail').value = cust.email || '';
        document.getElementById('editCustBirthday').value = cust.birthday ? cust.birthday.substring(0,10) : '';
        closeModal('custDetailModal');
        document.getElementById('editCustModal').classList.add('active');
    };
    apiFetch(`/api/customers/${id}`).then(doOpen).catch(e => showToast('❌ ' + e.message, 'error'));
}

async function updateCustomer() {
    const id   = document.getElementById('editCustId').value;
    const name = document.getElementById('editCustName').value.trim();
    if (!name) { showToast('⚠️ Nhập họ tên!', 'warn'); return; }
    try {
        await apiFetch(`/api/customers/${id}`, {
            method: 'PUT',
            body: JSON.stringify({
                FullName: name,
                Email: document.getElementById('editCustEmail').value || null,
                Birthday: document.getElementById('editCustBirthday').value || null
            })
        });
        showToast('✅ Cập nhật khách hàng thành công!');
        closeModal('editCustModal');
        loadCustomers(currentPage);
    } catch(e) { showToast('❌ ' + e.message, 'error'); }
}

function openAddModal() {
    ['custName','custPhone','custEmail'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('custBirthday').value = '';
    document.getElementById('addCustModal').classList.add('active');
}

async function saveCustomer() {
    const name    = document.getElementById('custName').value.trim();
    const phone   = document.getElementById('custPhone').value.trim();
    const email   = document.getElementById('custEmail').value.trim() || null;
    const bday    = document.getElementById('custBirthday').value || null;

    if (!name || !phone) { showToast('⚠️ Nhập họ tên và số điện thoại!', 'warn'); return; }

    try {
        await apiFetch('/api/customers', {
            method: 'POST',
            body: JSON.stringify({ FullName: name, Phone: phone, Email: email, Birthday: bday })
        });
        showToast('✅ Thêm khách hàng thành công!');
        closeModal('addCustModal');
        loadCustomers(1);
    } catch(e) { showToast('❌ ' + e.message, 'error'); }
}

function closeModal(id) { document.getElementById(id).classList.remove('active'); }

document.addEventListener('DOMContentLoaded', () => loadCustomers(1));
</script>
}
